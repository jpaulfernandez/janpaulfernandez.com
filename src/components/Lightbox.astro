---
/**
 * Lightbox.astro — full-screen photo viewer (markup + CSS only).
 *
 * Used by /gallery/ and the set pages. The behaviour lives in
 * src/scripts/gallery.ts (`initViewer()`), which each page imports in its own
 * two-line <script>; this file has no script of its own.
 *
 * initViewer() binds every `a.photo-trigger` on the page. Triggers are
 * anchors with a real href (the set page on /gallery/, the full image on a
 * set page), so with JS off every thumbnail still goes somewhere.
 *
 * Each trigger carries:
 *   data-src         full-resolution image URL          (required)
 *   data-alt         alt text for the enlarged image    (required)
 *   data-caption     caption line under the image       (optional)
 *   data-href        link rendered after the caption    (optional)
 *   data-href-label  label for that link                (optional)
 *
 * The ground is white like the rest of the site (a viewer is not a dark
 * theme). No blur, no scrim, no motion: a hairline is the only surface.
 */
---

<dialog id="photo-modal" class="lightbox-dialog" aria-label="Photo viewer">
  <div class="lightbox-inner">
    <button id="modal-close" type="button" class="lightbox-btn lightbox-close" aria-label="Close viewer">
      ✕
    </button>

    <div class="lightbox-image-wrap">
      <img id="modal-img" src="" alt="" class="lightbox-img" draggable="false" />
    </div>

    <div class="lightbox-meta">
      <span id="modal-caption" class="lightbox-caption"></span>
      <a id="modal-link" class="lightbox-link" href="" hidden></a>
    </div>

    <div class="lightbox-controls">
      <button id="modal-prev" type="button" class="lightbox-btn" aria-label="Previous photo">←</button>
      <span id="modal-counter" class="lightbox-counter" aria-live="polite"></span>
      <button id="modal-next" type="button" class="lightbox-btn" aria-label="Next photo">→</button>
    </div>
  </div>
</dialog>

<style>
  /* The page underneath does not scroll while the viewer is open. */
  :global(html:has(dialog[open])) { overflow: hidden; }

  /* dvw/dvh so iOS Safari's moving toolbars never crop the controls. */
  .lightbox-dialog {
    position: fixed;
    inset: 0;
    width: 100dvw;
    height: 100dvh;
    max-width: 100dvw;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-paper);
    color: var(--color-ink-900);
  }
  .lightbox-dialog::backdrop { background: var(--color-paper); }

  .lightbox-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    height: 100%;
    padding: 4rem 1rem 1rem;
    box-sizing: border-box;
  }

  .lightbox-btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 1rem;
    line-height: 1;
    color: var(--color-ink-900);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .lightbox-btn:hover { border-color: var(--color-ink-400); }
  .lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
  }

  /* The stage. touch-action: none here only, so the viewer's own pinch and
   * pan get every pointer; page zoom stays available everywhere else. */
  .lightbox-image-wrap {
    flex: 1;
    min-height: 0;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    touch-action: none;
  }
  .lightbox-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    user-select: none;
    -webkit-user-select: none;
    -webkit-user-drag: none;
    cursor: zoom-in;
  }

  /* Caption + provenance. On the library this is what tells you which set a
   * photo came from, so the set pages stay one click away. */
  .lightbox-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.75rem;
    padding-top: 0.75rem;
    font-size: var(--text-small);
    text-align: center;
    flex-shrink: 0;
  }
  .lightbox-caption { color: var(--color-ink-600); }
  .lightbox-link { color: var(--color-red-700); }
  .lightbox-link[hidden] { display: none; }

  .lightbox-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding-top: 0.75rem;
    flex-shrink: 0;
  }
  .lightbox-counter {
    min-width: 5rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-400);
  }
</style>
