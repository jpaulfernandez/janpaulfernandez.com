---
/**
 * Lightbox.astro — full-screen photo viewer.
 *
 * Second use (the flat /gallery masonry and the individual set pages), so it
 * lives here rather than inline in either page.
 *
 * It binds to every `a.photo-trigger` in the page. Triggers are anchors whose
 * href is the full-resolution image, so with JS off the wall still works — the
 * lightbox is an enhancement layered on top (preventDefault below).
 *
 * The list is rebuilt from the *visible* triggers on every open. /gallery
 * renders two walls (a mobile flow and a desktop masonry) and hides one with
 * CSS, so binding everything in DOM order would double the counter and make
 * prev/next cycle each photo twice.
 *
 * Each trigger carries:
 *   data-src         full-resolution image URL          (required)
 *   data-alt         alt text for the enlarged image    (required)
 *   data-caption     caption line under the image       (optional)
 *   data-href        link rendered after the caption    (optional)
 *   data-href-label  label for that link                (optional)
 */
---

<dialog id="photo-modal" class="lightbox-dialog" aria-label="Photo viewer">
  <div class="lightbox-inner">
    <button id="modal-close" type="button" class="lightbox-close" aria-label="Close lightbox">
      ✕
    </button>

    <div class="lightbox-image-wrap">
      <img id="modal-img" src="" alt="" class="lightbox-img" />
    </div>

    <div class="lightbox-meta">
      <span id="modal-caption" class="lightbox-caption"></span>
      <a id="modal-link" class="lightbox-link" href="" hidden></a>
    </div>

    <div class="lightbox-controls">
      <button id="modal-prev" type="button" class="lightbox-btn" aria-label="Previous photo">←</button>
      <span id="modal-counter" class="lightbox-counter" aria-live="polite"></span>
      <button id="modal-next" type="button" class="lightbox-btn" aria-label="Next photo">→</button>
    </div>
  </div>
</dialog>

<style>
  .lightbox-dialog {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(5, 5, 5, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--color-paper-100);
    z-index: 9999;
  }
  .lightbox-dialog::backdrop { background: rgba(5, 5, 5, 0.94); }

  .lightbox-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 1rem;
    box-sizing: border-box;
  }

  .lightbox-close,
  .lightbox-btn {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    background: var(--surface-1);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--color-paper-100);
    padding: 0.5rem 0.875rem;
    cursor: pointer;
    font-family: var(--font-body);
    transition: background-color 0.22s var(--ease-out-quint), border-color 0.22s var(--ease-out-quint), color 0.22s var(--ease-out-quint);
  }
  .lightbox-close:hover,
  .lightbox-btn:hover {
    border-color: var(--line-strong);
    background: var(--surface-2);
    color: var(--color-paper-50);
  }
  .lightbox-close:focus-visible,
  .lightbox-btn:focus-visible,
  .lightbox-link:focus-visible {
    outline: 2px solid var(--color-paper-100);
    outline-offset: 2px;
  }
  .lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
  }

  .lightbox-image-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    width: 100%;
    max-height: calc(100vh - 8rem);
  }
  .lightbox-img {
    border-radius: var(--radius-sm);
    max-width: 100%;
    max-height: calc(100vh - 8rem);
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /* Caption + provenance. On the flat gallery this is what tells you which
   * set a photo came from, so the set pages stay one click away. */
  .lightbox-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.75rem;
    padding-top: 0.75rem;
    font-size: var(--text-small);
    text-align: center;
    flex-shrink: 0;
  }
  .lightbox-caption { color: var(--color-paper-400); }
  .lightbox-link {
    color: var(--color-paper-100);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
  }
  .lightbox-link:hover {
    color: var(--color-wine-300);
    border-bottom-color: var(--color-wine-300);
  }
  .lightbox-link[hidden] { display: none; }

  .lightbox-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding-top: 0.75rem;
    flex-shrink: 0;
  }
  .lightbox-counter {
    color: var(--color-paper-400);
    font-family: var(--font-mono);
    min-width: 5rem;
    text-align: center;
    font-size: var(--text-small);
    font-variant-numeric: tabular-nums;
  }

  .lightbox-dialog[open] { animation: lightbox-in 0.2s ease-out; }
  @keyframes lightbox-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox-dialog[open] { animation: none; }
  }
</style>

<script>
  const modal = document.getElementById('photo-modal') as HTMLDialogElement | null;
  const modalImg = document.getElementById('modal-img') as HTMLImageElement | null;
  const modalCaption = document.getElementById('modal-caption');
  const modalLink = document.getElementById('modal-link') as HTMLAnchorElement | null;
  const modalCounter = document.getElementById('modal-counter');
  const modalClose = document.getElementById('modal-close');
  const modalPrev = document.getElementById('modal-prev');
  const modalNext = document.getElementById('modal-next');
  const allTriggers = Array.from(
    document.querySelectorAll<HTMLElement>('.photo-trigger')
  );

  // Only the wall the viewport is actually showing. `offsetParent` is null for
  // anything inside a `display: none` ancestor, which is how the walls hide.
  const visibleTriggers = () =>
    allTriggers.filter((t) => t.offsetParent !== null);

  let triggers: HTMLElement[] = allTriggers;
  let currentIndex = 0;

  function showPhoto(index: number) {
    const total = triggers.length;
    if (total === 0) return;
    currentIndex = (index + total) % total;
    const trigger = triggers[currentIndex];
    if (!trigger) return;

    const { src = '', alt = '', caption = '', href = '', hrefLabel = '' } = trigger.dataset;

    if (modalImg) {
      modalImg.src = src;
      modalImg.alt = alt;
    }
    if (modalCaption) modalCaption.textContent = caption;
    if (modalLink) {
      if (href) {
        modalLink.href = href;
        modalLink.textContent = hrefLabel || 'view set →';
        modalLink.hidden = false;
      } else {
        modalLink.hidden = true;
      }
    }
    if (modalCounter) modalCounter.textContent = `${currentIndex + 1} / ${triggers.length}`;
  }

  allTriggers.forEach((trigger) => {
    trigger.addEventListener('click', (e) => {
      // Without JS the anchor just opens the full-size image; with JS we take
      // over and show it in the lightbox instead.
      e.preventDefault();
      const list = visibleTriggers();
      triggers = list.length > 0 ? list : allTriggers;
      const idx = triggers.indexOf(trigger);
      showPhoto(idx === -1 ? 0 : idx);
      modal?.showModal();
    });
  });

  modalClose?.addEventListener('click', () => modal?.close());
  modalPrev?.addEventListener('click', () => showPhoto(currentIndex - 1));
  modalNext?.addEventListener('click', () => showPhoto(currentIndex + 1));

  // Clicking the backdrop (the dialog element itself) closes.
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.close();
  });

  document.addEventListener('keydown', (e) => {
    if (!modal?.open) return;
    if (e.key === 'ArrowLeft') showPhoto(currentIndex - 1);
    if (e.key === 'ArrowRight') showPhoto(currentIndex + 1);
  });
</script>
