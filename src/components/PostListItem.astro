---
import { Image } from 'astro:assets';
import { formatDate } from '../lib/dates';

interface Props {
  title: string;
  type: 'essay' | 'note';
  topics: string[];
  date: string;
  excerpt: string;
  url: string;
  readingTime?: number;
  stage?: 'seedling' | 'budding' | 'evergreen' | 'none';
  cover?: ImageMetadata;
}

const { title, type, topics, date, excerpt, url, readingTime, cover } = Astro.props;
---

<article class="post-row-inner group">
  <div class="min-w-0 flex flex-col gap-3">
    <p class="m-0 flex flex-wrap items-center gap-x-3 gap-y-1 mono-micro">
      <span class="text-wine-400">{type}</span>
      <span aria-hidden="true" class="text-paper-600">/</span>
      <time datetime={date}>{formatDate(date)}</time>
      {readingTime !== undefined && (
        <>
          <span aria-hidden="true" class="text-paper-600">/</span>
          <span>{readingTime} min</span>
        </>
      )}
    </p>

    {/* h2, not h3: both callers (/thoughts, /topics/[topic]) render this
        directly under the page h1, and h1 -> h3 is a heading-level skip. */}
    <h2 class="m-0 text-h3 leading-tight">
      <a href={url} class="post-link group-hover:text-wine-300 transition-colors">
        {title}
      </a>
    </h2>

    {excerpt && (
      <p class="m-0 text-paper-400 leading-relaxed max-w-[62ch]">{excerpt}</p>
    )}

    {topics.length > 0 && (
      <ul class="m-0 p-0 mt-1 list-none flex flex-wrap gap-2">
        {topics.map((topic) => (
          <li class="tag">{topic}</li>
        ))}
      </ul>
    )}
  </div>

  {cover && (
    <Image
      src={cover}
      alt=""
      width={320}
      height={224}
      class="post-cover"
    />
  )}
</article>

<style>
  .post-row-inner {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding-block: clamp(1.75rem, 1.25rem + 1.6vw, 2.5rem);
  }

  /* Stretch the title link over the whole row. The topic chips are plain
   * <li>s here rather than links, so nothing is swallowed by the overlay. */
  .post-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .post-cover {
    display: none;
    width: 10rem;
    height: 7rem;
    flex-shrink: 0;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    /* Only lightly held back: several covers are night shots that vanish
     * entirely against the ground at a heavier dim. */
    filter: grayscale(0.85) brightness(1.05);
    transition: filter 0.4s var(--ease-out-quint);
  }
  .group:hover .post-cover { filter: grayscale(0) brightness(1); }

  @media (min-width: 40rem) {
    .post-cover { display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    .post-cover { filter: none; }
  }
</style>
