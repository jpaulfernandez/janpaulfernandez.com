---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  type: 'essay' | 'note';
  topics: string[];
  date: string;
  excerpt: string;
  url: string;
  readingTime?: number;
  stage?: 'seedling' | 'budding' | 'evergreen' | 'none';
  cover?: ImageMetadata;
}

const { title, type, topics, date, excerpt, url, readingTime, cover } = Astro.props;
---

<article class="group relative py-5">
  <div class="flex-1 min-w-0 flex flex-col gap-2">
    <p class="m-0 flex flex-wrap items-center gap-x-2 gap-y-1 text-small text-moss-500 tabular-nums">
      <span class="text-moss-700">{type}</span>
      <span aria-hidden="true">·</span>
      <time datetime={date}>
        {new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
      </time>
      {readingTime !== undefined && (
        <>
          <span aria-hidden="true">·</span>
          <span>{readingTime} min</span>
        </>
      )}
    </p>

    <h3 class="font-bold text-moss-900 leading-snug m-0 text-body">
      <a href={url} class="post-link no-underline text-moss-900 group-hover:text-citrus-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-citrus-500 rounded-sm">
        {title}
      </a>
    </h3>

    {excerpt && (
      <p class="text-moss-700 text-small leading-relaxed line-clamp-2 m-0">
        {excerpt}
      </p>
    )}

    {topics.length > 0 && (
      <p class="m-0 flex flex-wrap gap-x-2 text-small text-moss-500">
        {topics.map((topic) => (
          <span>#{topic}</span>
        ))}
      </p>
    )}
  </div>

  {cover && (
    <Image
      src={cover}
      alt=""
      width={120}
      height={80}
      class="hidden sm:block w-20 h-14 shrink-0 object-cover absolute right-0 top-5"
    />
  )}
</article>

<style>
  /* Stretch the title link over the whole row (topics aren't links, so nothing is lost). */
  .post-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }
</style>
