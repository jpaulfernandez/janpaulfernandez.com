---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'career'>[];
  variant?: 'compact' | 'full';
  sortOrder?: 'asc' | 'desc';
}

const { entries, variant = 'compact', sortOrder = 'desc' } = Astro.props;

// Sort entries by order (desc = latest first, asc = oldest first)
const sortedEntries = [...entries].sort((a, b) =>
  sortOrder === 'desc' ? b.data.order - a.data.order : a.data.order - b.data.order
);

const processedEntries = await Promise.all(
  sortedEntries.map(async (entry) => {
    const { Content } = await render(entry);
    return {
      ...entry,
      Content,
    };
  })
);
---

<div class="rail" data-reveal-stagger>
  {
    processedEntries.map(({ data, Content, id }) => (
      <article class="rail-item" id={variant === 'full' ? id : undefined} data-reveal="up">
        <span class="rail-date">{data.period}</span>

        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <h3 class="m-0">{data.role}</h3>
            <p class="text-paper-400 mb-0 mt-2 text-small">{data.org}</p>
          </div>

          {data.logo && (
            <Image
              src={data.logo}
              alt={`${data.org} logo`}
              class="career-logo"
              width={40}
              height={40}
            />
          )}
        </div>

        {variant === 'full' ? (
          <div class="prose mt-6 max-w-[64ch]">
            <Content />
          </div>
        ) : (
          <a href={`/about/#${id}`} class="link-arrow mt-4">
            Read full story
          </a>
        )}
      </article>
    ))
  }
</div>

<style>
  /* Logos are supplied as full-colour marks on light grounds. Rather than
   * ask for a second set of assets, they sit at reduced opacity until the
   * entry is hovered — which also stops six brand colours competing with the
   * one accent the palette allows. */
  .career-logo {
    width: 2.5rem;
    height: 2.5rem;
    object-fit: contain;
    flex-shrink: 0;
    margin-top: 0.25rem;
    opacity: 0.55;
    filter: grayscale(1);
    transition: opacity 0.22s var(--ease-out-quint), filter 0.4s var(--ease-out-quint);
  }
  .rail-item:hover .career-logo { opacity: 1; filter: grayscale(0); }

  @media (prefers-reduced-motion: reduce) {
    .career-logo { opacity: 1; filter: none; }
  }
</style>
