---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'career'>[];
  variant?: 'compact' | 'full';
  sortOrder?: 'asc' | 'desc';
}

const { entries, variant = 'compact', sortOrder = 'desc' } = Astro.props;

// Sort entries by order (desc = latest first, asc = oldest first)
const sortedEntries = [...entries].sort((a, b) =>
  sortOrder === 'desc' ? b.data.order - a.data.order : a.data.order - b.data.order
);

const processedEntries = await Promise.all(
  sortedEntries.map(async (entry) => {
    const { Content } = await render(entry);
    return {
      ...entry,
      Content,
    };
  })
);
---

<div class="rail">
  {
    processedEntries.map(({ data, Content, id }) => (
      <article class="rail-item" id={variant === 'full' ? id : undefined}>
        <span class="rail-date">{data.period}</span>

        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <h3 class="text-h3 font-bold text-ink-900 leading-snug m-0">
              {data.role}
            </h3>
            <p class="text-wine-500 mb-0 mt-1 text-body">
              {data.org}
            </p>
          </div>

          {data.logo && (
            <Image
              src={data.logo}
              alt={`${data.org} logo`}
              class="w-10 h-10 object-contain shrink-0 mt-1"
              width={40}
              height={40}
            />
          )}
        </div>

        {variant === 'full' ? (
          <div class="prose mt-4 text-ink max-w-[68ch]">
            <Content />
          </div>
        ) : (
          <a
            href={`/about/#${id}`}
            class="inline-block mt-3 text-small text-ink-500 hover:text-wine-500 no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500"
          >
            read full story →
          </a>
        )}
      </article>
    ))
  }
</div>
