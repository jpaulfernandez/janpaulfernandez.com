---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'career'>[];
  variant?: 'compact' | 'full';
  sortOrder?: 'asc' | 'desc';
}

const { entries, variant = 'compact', sortOrder = 'desc' } = Astro.props;

// Sort entries by order (desc = latest first, asc = oldest first)
const sortedEntries = [...entries].sort((a, b) =>
  sortOrder === 'desc' ? b.data.order - a.data.order : a.data.order - b.data.order
);

const processedEntries = await Promise.all(
  sortedEntries.map(async (entry) => {
    const { Content } = await render(entry);
    return {
      ...entry,
      Content,
    };
  })
);
---

<div class="flex flex-col divide-y divide-moss-200">
  {
    processedEntries.map(({ data, Content, id }) => (
      <article class={`relative py-6 ${variant === 'full' ? '' : ''}`} id={variant === 'full' ? id : undefined}>
        <div class="flex flex-col md:flex-row md:items-baseline md:gap-6">
          <div class="md:w-32 shrink-0">
            <span class="text-moss-500 text-small tabular-nums">{data.period}</span>
          </div>

          <div class="flex-grow min-w-0">
            <h3 class="text-h3 font-bold text-moss-900 leading-snug m-0">
              {data.role}
            </h3>
            <p class="text-moss-700 mb-0 text-body">
              {data.org}
            </p>

            {variant === 'full' ? (
              <div class="prose mt-4 text-ink max-w-[68ch]">
                <Content />
              </div>
            ) : (
              <a
                href={`/about#${id}`}
                class="inline-block mt-2 text-small text-moss-500 hover:text-moss-900 no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-citrus-500 rounded-sm"
              >
                read full story →
              </a>
            )}
          </div>

          {data.logo && (
            <div class="flex-shrink-0 self-start mt-2 md:mt-0">
              <Image
                src={data.logo}
                alt={`${data.org} logo`}
                class="w-10 h-10 object-contain"
                width={40}
                height={40}
              />
            </div>
          )}
        </div>
      </article>
    ))
  }
</div>
