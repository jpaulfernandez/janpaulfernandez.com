---
// Callout.astro — three variants. Only `warning` spends the accent; the other
// two are carried by the hairline alone, so a page of callouts stays quiet.
interface Props {
  variant?: 'note' | 'idea' | 'warning';
}

const { variant = 'note' } = Astro.props;

const labels: Record<NonNullable<Props['variant']>, string> = {
  note: 'Note',
  idea: 'Idea',
  warning: 'Warning',
};

const label = labels[variant] ?? labels.note;
---
<aside class="callout" data-variant={variant}>
  <p class="label">{label}</p>
  <div class="body"><slot /></div>
</aside>

<style>
  .callout {
    margin-block: 2.5rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-left-width: 2px;
    border-radius: var(--radius-md);
    background-color: var(--surface-1);
  }
  .callout[data-variant='idea'] { border-left-color: var(--color-paper-100); }
  .callout[data-variant='warning'] { border-left-color: var(--color-wine-400); }

  .label {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-paper-400);
  }
  .callout[data-variant='warning'] .label { color: var(--color-wine-300); }
  .callout[data-variant='idea'] .label { color: var(--color-paper-50); }

  .body :global(> p) { margin: 0; }
  .body :global(> * + *) { margin-top: 1rem; }
</style>
