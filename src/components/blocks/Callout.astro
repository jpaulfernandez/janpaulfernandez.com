---
// Callout.astro — three variants, all in mono+b/w with a single accent rule.
interface Props {
  variant?: 'note' | 'idea' | 'warning';
}

const { variant = 'note' } = Astro.props;

const variants: Record<NonNullable<Props['variant']>, {
  classes: string;
  kickerColor: string; // tailwind utility color class
  label: string;
  icon: string;
}> = {
  note: {
    classes: 'border-l-2 border-ink-200 bg-paper-50',
    kickerColor: 'text-ink-700',
    label: 'Note',
    icon: '·',
  },
  idea: {
    classes: 'border-l-2 border-ink-900 bg-paper-50',
    kickerColor: 'text-ink-900',
    label: 'Idea',
    icon: '·',
  },
  warning: {
    classes: 'border-l-2 border-wine-500 bg-paper-50',
    kickerColor: 'text-wine-500',
    label: 'Warning',
    icon: '·',
  },
};

const config = variants[variant] ?? variants.note;
---
<aside class={`my-8 px-6 py-4 ${config.classes}`}>
  <p class={`m-0 mb-4 font-mono uppercase text-xs tracking-widest ${config.kickerColor}`}>
    {config.icon} {config.label}
  </p>
  <div class="prose max-w-none text-ink-900 [&>p]:text-ink-900 [&>p]:m-0 [&>p]:text-body">
    <slot />
  </div>
</aside>
