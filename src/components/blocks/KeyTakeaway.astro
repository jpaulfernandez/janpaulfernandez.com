---
// KeyTakeaway.astro — after Phase 21, the ONLY place on the site where wine
// appears as a field rather than as a link. It survived the de-SaaS pass on
// purpose: it is a semantic block inside long-form prose, not page chrome.
---
<aside class="key-takeaway">
  <p class="label">Key takeaway</p>
  <div class="body"><slot /></div>
</aside>

<style>
  .key-takeaway {
    margin-block: 3rem;
    padding: 1.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background-color: var(--color-blue-100);
  }
  .label {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-red-700);
  }
  .body { color: var(--color-ink-900); }
  .body :global(> p) { margin: 0; }
  .body :global(> * + *) { margin-top: 1rem; }
</style>
