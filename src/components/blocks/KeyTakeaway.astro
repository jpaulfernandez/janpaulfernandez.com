---
// KeyTakeaway.astro — the block the v3 blue tint exists for.
---
<aside class="key-takeaway">
  <p class="label">Key takeaway</p>
  <div class="body"><slot /></div>
</aside>

<style>
  .key-takeaway {
    margin-block: 3rem;
    padding: 1.75rem;
    border: 1px solid var(--color-blue-200);
    /* The red rule is a fill, not text, so red-500 is allowed here. */
    border-left: 3px solid var(--color-red-500);
    border-radius: var(--radius-md);
    background-color: var(--color-blue-100);
  }
  .label {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-red-700); /* 5.27:1 on blue-100 */
  }
  .body { color: var(--color-ink-900); }
  .body :global(> p) { margin: 0; }
  .body :global(> * + *) { margin-top: 1rem; }
</style>
