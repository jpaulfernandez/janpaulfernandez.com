---
// KeyTakeaway.astro — the one wine-filled panel allowed inside an article.
---
<aside class="key-takeaway">
  <p class="label">★ Key takeaway</p>
  <div class="body"><slot /></div>
</aside>

<style>
  .key-takeaway {
    margin-block: 3rem;
    padding: 1.75rem;
    border: 1px solid var(--color-wine-600);
    border-radius: var(--radius-md);
    background:
      linear-gradient(180deg, var(--wine-glow), transparent 70%),
      var(--surface-1);
  }
  .label {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-wine-300);
  }
  .body { color: var(--color-paper-50); }
  .body :global(> p) { margin: 0; }
  .body :global(> * + *) { margin-top: 1rem; }
</style>
