---
// PullQuote.astro — a display-scale interruption in the reading column, set in
// Fraunces italic. The italic is a separate font file; importing it here means
// only pages that render the block carry its @font-face (not preloaded — it is
// never above the fold). Without it the browser synthesises a slanted roman.
import '@fontsource-variable/fraunces/wght-italic.css';
---
<figure class="pull-quote">
  <blockquote><slot /></blockquote>
</figure>

<style>
  .pull-quote {
    margin-block: 3.5rem;
    padding-left: 2rem;
    /* The rule replaces the quotation mark: a glyph at this size reads as an
     * illustration. */
    border-left: 2px solid var(--color-blue-200);
  }
  blockquote {
    margin: 0;
    border: 0;
    padding: 0;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 500;
    font-style: italic;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--color-ink-900);
    max-width: 30ch;
  }
</style>
