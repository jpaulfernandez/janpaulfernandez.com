---
// ArticleLayout.astro
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { blogPosting, breadcrumbs } from '../lib/schema';
import { formatDate } from '../lib/dates';
import type { ThoughtEntry } from '../lib/thoughts';

interface Props {
  post: ThoughtEntry;
  headings: { depth: number; slug: string; text: string }[];
  relatedPosts: ThoughtEntry[];
  prevPost: ThoughtEntry | null;
  nextPost: ThoughtEntry | null;
}

const { post, headings, relatedPosts, prevPost, nextPost } = Astro.props;
const { title, excerpt, publishedDate, updatedDate, type, cover, coverAlt, topics } = post.data;

const wordCount = post.body ? post.body.split(/\s+/).filter(Boolean).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const h2s = headings.filter((h) => h.depth === 2);
const showToc = h2s.length >= 2;

// Article rich results require an image. The /og route generates a stable
// 1200x630 card for every post, so use that rather than leaving `image` off
// whenever a post has no cover (none currently do).
const shareImage = `/og/${post.id}.png`;

const blogPostSchema = blogPosting({
  title,
  excerpt,
  url: `/thoughts/${post.id}/`,
  publishedDate,
  updatedDate,
  cover: shareImage,
  topics,
  wordCount,
  type,
});

const breadcrumbsSchema = breadcrumbs([
  { name: 'Home', url: '/' },
  { name: 'Thoughts', url: '/thoughts/' },
  { name: title, url: `/thoughts/${post.id}/` },
]);
---

<BaseLayout title={title} description={excerpt} ogImage={shareImage} type="article">
  <JsonLd slot="head" data={[blogPostSchema, breadcrumbsSchema]} />

  <article>
    {/* The masthead runs at page width; everything below it drops into the
        reading column, so the title can breathe without the body doing the
        same. */}
    <header class="page-head" data-hero>
      <div class="shell-narrow">
        <a href="/thoughts/" class="mono-micro hover:text-paper-50" data-reveal="fade">
          ← Thoughts
        </a>

        <h1 class="mt-6 text-h1" data-reveal="up" data-reveal-delay="0.05">{title}</h1>

        {excerpt && (
          <p class="lead mt-6 max-w-none" data-reveal="up" data-reveal-delay="0.1">
            {excerpt}
          </p>
        )}

        <div
          class="mt-8 pt-6 border-t border-[var(--line)] flex flex-wrap items-center gap-x-4 gap-y-2 mono-micro"
          data-reveal="fade"
          data-reveal-delay="0.16"
        >
          <span class="text-paper-400">{type}</span>
          <span aria-hidden="true" class="text-paper-600">/</span>
          <span>
            By <a href="/about/" rel="author" class="hover:text-paper-50">Paul Fernandez</a>
          </span>
          <span aria-hidden="true" class="text-paper-600">/</span>
          <time datetime={publishedDate}>{formatDate(publishedDate)}</time>
          {updatedDate && (
            <>
              <span aria-hidden="true" class="text-paper-600">/</span>
              <span>Updated {formatDate(updatedDate)}</span>
            </>
          )}
          <span aria-hidden="true" class="text-paper-600">/</span>
          <span>{readingTime} min</span>
        </div>

        {topics && topics.length > 0 && (
          <ul class="mt-6 list-none m-0 p-0 flex flex-wrap gap-2" data-reveal="fade" data-reveal-delay="0.2">
            {topics.map((topic) => (
              <li>
                <a href={`/topics/${topic}/`} class="tag">{topic}</a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </header>

    {/* A described cover is a real image-search entry; an undescribed one stays
        decorative (alt="") rather than repeating the h1 to a screen reader. */}
    {cover && typeof cover !== 'string' && (
      <figure class="shell m-0 mb-16" data-reveal="scale">
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          width={1600}
          class="w-full h-auto rounded-[var(--radius-lg)] border border-[var(--line)]"
          loading="eager"
          decoding="async"
        />
      </figure>
    )}

    <div class="shell-narrow pb-24 md:pb-32">
      {showToc && (
        <details class="toc group">
          <summary>
            <span class="mono-micro">Table of contents</span>
            <span class="toc-mark" aria-hidden="true">+</span>
          </summary>
          <ol class="toc-list">
            {h2s.map((h) => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ol>
        </details>
      )}

      <div class="prose mt-12">
        <slot />
      </div>

      {(prevPost || nextPost) && (
        <nav aria-label="Pagination" class="mt-20 grid gap-4 sm:grid-cols-2">
          {prevPost ? (
            <a href={`/thoughts/${prevPost.id}/`} class="card card-interactive pt-5 pb-2">
              <span class="mono-micro">← Previous</span>
              <span class="block mt-3 text-paper-50 font-medium leading-snug">
                {prevPost.data.title}
              </span>
            </a>
          ) : (
            <span></span>
          )}
          {nextPost && (
            <a href={`/thoughts/${nextPost.id}/`} class="card card-interactive pt-5 pb-2 sm:text-right">
              <span class="mono-micro">Next →</span>
              <span class="block mt-3 text-paper-50 font-medium leading-snug">
                {nextPost.data.title}
              </span>
            </a>
          )}
        </nav>
      )}

      {relatedPosts.length > 0 && (
        <section class="mt-20">
          <h2 class="kicker">Related</h2>
          <ul class="rows mt-6">
            {relatedPosts.map((rp) => (
              <li>
                <a href={`/thoughts/${rp.id}/`} class="row-link">
                  <span class="row-title text-h3">{rp.data.title}</span>
                  <time class="row-meta" datetime={rp.data.publishedDate}>
                    {rp.data.publishedDate.slice(0, 4)}
                  </time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(7rem, 5rem + 8vw, 10rem) clamp(2.5rem, 2rem + 3vw, 4rem);
  }

  /* Table of contents. A <details>, not a scroll-spy sidebar — the reading
   * column is 46rem and a rail beside it would either crowd the text or push
   * it off-centre, and native <details> costs nothing. */
  .toc {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background-color: var(--surface-1);
    padding: 1rem 1.25rem;
  }
  .toc summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
  }
  .toc summary::-webkit-details-marker { display: none; }
  .toc-mark {
    color: var(--color-paper-400);
    transition: transform 0.3s var(--ease-out-quint);
    font-size: 1.125rem;
    line-height: 1;
  }
  .toc[open] .toc-mark { transform: rotate(45deg); }

  .toc-list {
    margin: 1.25rem 0 0.25rem;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    list-style: decimal;
    font-size: var(--text-small);
  }
  .toc-list li::marker {
    color: var(--color-paper-600);
    font-family: var(--font-mono);
  }
  .toc-list a { color: var(--color-paper-400); }
  .toc-list a:hover { color: var(--color-wine-300); }
</style>
