---
// ArticleLayout.astro
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { blogPosting, breadcrumbs, person } from '../lib/schema';
import { formatDate } from '../lib/dates';
import type { ThoughtEntry } from '../lib/thoughts';

interface Props {
  post: ThoughtEntry;
  headings: { depth: number; slug: string; text: string }[];
  relatedPosts: ThoughtEntry[];
  prevPost: ThoughtEntry | null;
  nextPost: ThoughtEntry | null;
}

const { post, headings, relatedPosts, prevPost, nextPost } = Astro.props;
const { title, excerpt, publishedDate, updatedDate, type, cover, coverAlt, topics } = post.data;

const wordCount = post.body ? post.body.split(/\s+/).filter(Boolean).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const h2s = headings.filter((h) => h.depth === 2);
const showToc = h2s.length >= 2;

// Article rich results require an image. The /og route generates a stable
// 1200x630 card for every post, so use that rather than leaving `image` off
// whenever a post has no cover.
const shareImage = `/og/${post.id}.png`;

// T30/A3. The share card stays the share card, but Article.image should be the
// photograph when there is one — a 1200x630 text card is a worse thing for an
// image index to hold than the actual cover. `cover` is an imported asset, so
// take its resolved src.
const articleImage = cover?.src ?? shareImage;

const blogPostSchema = blogPosting({
  title,
  excerpt,
  url: `/thoughts/${post.id}/`,
  publishedDate,
  updatedDate,
  cover: articleImage,
  topics,
  wordCount,
  type,
});

const breadcrumbsSchema = breadcrumbs([
  { name: 'Home', url: '/' },
  { name: 'Thoughts', url: '/thoughts/' },
  { name: title, url: `/thoughts/${post.id}/` },
]);
---

<BaseLayout title={title} description={excerpt} ogImage={shareImage} type="article">
  <JsonLd slot="head" data={[blogPostSchema, breadcrumbsSchema, person()]} />

  <article>
    {/* The masthead runs at page width; everything below it drops into the
        reading column, so the title can breathe without the body doing the
        same. */}
    <header class="page-head">
      <div class="shell-narrow">
        <a href="/thoughts/" class="mono text-ink-400 no-underline hover:text-ink-900">
          ← Thoughts
        </a>

        <h1 class="mt-6 text-h1">{title}</h1>

        {excerpt && (
          <p class="lead mt-6 max-w-none text-ink-900">
            {excerpt}
          </p>
        )}

        <div
          class="mt-8 pt-6 border-t border-[var(--line)] flex flex-wrap items-center gap-x-4 gap-y-2 mono text-small text-ink-400"
        >
          <span class="uppercase tracking-widest text-micro">{type}</span>
          <span aria-hidden="true">/</span>
          <span>
            By <a href="/about/" rel="author" class="link">Paul Fernandez</a>
          </span>
          <span aria-hidden="true">/</span>
          <time datetime={publishedDate}>{formatDate(publishedDate)}</time>
          {updatedDate && (
            <>
              <span aria-hidden="true">/</span>
              <span>Updated {formatDate(updatedDate)}</span>
            </>
          )}
          <span aria-hidden="true">/</span>
          <span>{readingTime} min</span>
        </div>

        {topics && topics.length > 0 && (
          <ul class="mt-6 list-none m-0 p-0 flex flex-wrap gap-2">
            {topics.map((topic) => (
              <li>
                <a href={`/topics/${topic}/`} class="tag">{topic}</a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </header>

    {/* A described cover is a real image-search entry; an undescribed one stays
        decorative (alt="") rather than repeating the h1 to a screen reader. */}
    {cover && typeof cover !== 'string' && (
      <figure class="shell mb-16">
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[800, 1200, 1600]}
          sizes="(min-width: 84rem) 80rem, 100vw"
          class="w-full h-auto"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    )}

    <div class="shell-narrow pb-24 md:pb-32">
      {showToc && (
        <details class="toc group">
          <summary>
            <span class="mono-micro">Table of contents</span>
            <span class="toc-mark" aria-hidden="true"></span>
          </summary>
          <ol class="toc-list">
            {h2s.map((h) => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ol>
        </details>
      )}

      <div class="prose mt-12">
        <slot />
      </div>

      {(prevPost || nextPost) && (
        <nav aria-label="Pagination" class="mt-20">
          <ul class="rows border-t border-[var(--line)]">
            {prevPost && (
              <li>
                <a href={`/thoughts/${prevPost.id}/`} class="row-link">
                  <span class="row-title text-h3">{prevPost.data.title}</span>
                  <span class="row-meta">← Previous</span>
                </a>
              </li>
            )}
            {nextPost && (
              <li>
                <a href={`/thoughts/${nextPost.id}/`} class="row-link">
                  <span class="row-title text-h3">{nextPost.data.title}</span>
                  <span class="row-meta">Next →</span>
                </a>
              </li>
            )}
          </ul>
        </nav>
      )}

      {relatedPosts.length > 0 && (
        <section class="mt-20">
          <h2 class="kicker">Related</h2>
          <ul class="rows mt-6">
            {relatedPosts.map((rp) => (
              <li>
                <a href={`/thoughts/${rp.id}/`} class="row-link">
                  <span class="row-title text-h3">{rp.data.title}</span>
                  <time class="row-meta" datetime={rp.data.publishedDate}>
                    {rp.data.publishedDate.slice(0, 4)}
                  </time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(7rem, 5rem + 8vw, 10rem) clamp(2.5rem, 2rem + 3vw, 4rem);
  }

  /* Reading measure. The container is .shell-narrow (58rem) so tables,
   * diagrams, code and the blocks have room; running text is held to 38rem
   * (≈ 68ch at 17px Inter). Scoped, so other .prose users keep their own. */
  .prose { max-width: none; }
  .prose > :global(p),
  .prose > :global(ul),
  .prose > :global(ol),
  .prose > :global(blockquote),
  .prose > :global(h2),
  .prose > :global(h3),
  .prose > :global(h4) { max-width: var(--measure); }
  /* Markdown wraps a diagram in a bare <p>; that paragraph is a figure, not
   * text, so it gets the container. */
  .prose > :global(p:has(> img)) { max-width: none; }

  /* Table of contents. A <details>, not a scroll-spy sidebar — a rail beside
   * the column would crowd the text or push it off-centre, and native
   * <details> costs nothing. */
  .toc {
    border: 1px solid var(--color-blue-200);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
  }
  .toc summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
    color: var(--color-ink-900);
  }
  .toc summary::-webkit-details-marker { display: none; }
  /* State, not motion: the mark swaps glyph when the list opens. */
  .toc-mark {
    color: var(--color-ink-900);
    font-size: 1.125rem;
    line-height: 1;
  }
  .toc-mark::before { content: '+'; }
  .toc[open] .toc-mark::before { content: '−'; }

  .toc-list {
    margin: 1.25rem 0 0.25rem;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    list-style: decimal;
    font-size: var(--text-small);
  }
  .toc-list li::marker {
    color: var(--color-ink-400);
    font-family: var(--font-mono);
  }
  .toc-list a { color: var(--color-ink-900); }
  .toc-list a:hover { color: var(--color-red-700); }
</style>
