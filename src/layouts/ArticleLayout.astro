---
// ArticleLayout.astro
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { blogPosting, breadcrumbs } from '../lib/schema';
import { formatDate } from '../lib/dates';
import type { ThoughtEntry } from '../lib/thoughts';

interface Props {
  post: ThoughtEntry;
  headings: { depth: number; slug: string; text: string }[];
  relatedPosts: ThoughtEntry[];
  prevPost: ThoughtEntry | null;
  nextPost: ThoughtEntry | null;
}

const { post, headings, relatedPosts, prevPost, nextPost } = Astro.props;
const { title, excerpt, publishedDate, updatedDate, type, cover, coverAlt, topics } = post.data;

const wordCount = post.body ? post.body.split(/\s+/).filter(Boolean).length : 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const h2s = headings.filter((h) => h.depth === 2);
const showToc = h2s.length >= 2;

// Article rich results require an image. The /og route generates a stable
// 1200x630 card for every post, so use that rather than leaving `image` off
// whenever a post has no cover (none currently do).
const shareImage = `/og/${post.id}.png`;

const blogPostSchema = blogPosting({
  title,
  excerpt,
  url: `/thoughts/${post.id}/`,
  publishedDate,
  updatedDate,
  cover: shareImage,
  topics,
  wordCount,
  type,
});

const breadcrumbsSchema = breadcrumbs([
  { name: 'Home', url: '/' },
  { name: 'Thoughts', url: '/thoughts/' },
  { name: title, url: `/thoughts/${post.id}/` },
]);
---

<BaseLayout title={title} description={excerpt} ogImage={shareImage} type="article">
  <JsonLd slot="head" data={[blogPostSchema, breadcrumbsSchema]} />

  <article>
    <header>
      <div class="flex items-center gap-2 text-small text-ink-500 tabular-nums">
        <a href="/thoughts/" class="text-ink-500 hover:text-ink-900 no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500 rounded-sm">← thoughts</a>
      </div>

      <h1 class="text-ink-900 m-0 mt-4 text-balance">{title}</h1>

      {excerpt && (
        <p class="mt-4 mb-0 text-ink-700 text-body leading-relaxed">{excerpt}</p>
      )}

      <div class="mt-6 flex flex-wrap items-center gap-3 text-small text-ink-500 tabular-nums">
        <span>{type}</span>
        <span aria-hidden="true">·</span>
        <span>by <a href="/about/" rel="author" class="text-ink-700 hover:text-wine-500 no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500 rounded-sm">Paul Fernandez</a></span>
        <span aria-hidden="true">·</span>
        <time datetime={publishedDate}>{formatDate(publishedDate)}</time>
        {updatedDate && (
          <>
            <span aria-hidden="true">·</span>
            <span class="italic">updated {formatDate(updatedDate)}</span>
          </>
        )}
        <span aria-hidden="true">·</span>
        <span>{readingTime} min</span>
      </div>

      {topics && topics.length > 0 && (
        <p class="mt-3 mb-0 text-small text-ink-500 flex flex-wrap gap-x-2">
          {topics.map((topic) => (
            <a href={`/topics/${topic}/`} class="text-ink-700 hover:text-wine-500 no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500 rounded-sm">#{topic}</a>
          ))}
        </p>
      )}

      {/* A described cover is a real image-search entry; an undescribed one stays
          decorative (alt="") rather than repeating the h1 to a screen reader. */}
      {cover && typeof cover !== 'string' && (
        <figure class="mt-8">
          <Image src={cover} alt={coverAlt ?? ''} width={1600} class="w-full h-auto" loading="eager" decoding="async" />
        </figure>
      )}
    </header>

    {/* Table of contents — collapsible, sits above the body */}
    {showToc && (
      <details class="mt-8 border-t border-ink-200 pt-4 group">
        <summary class="cursor-pointer list-none text-small text-ink-700 hover:text-ink-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500 rounded-sm [&::-webkit-details-marker]:hidden flex items-center justify-between">
          <span class="font-mono uppercase tracking-widest">table of contents</span>
          <span class="transition-transform group-open:rotate-180 text-ink-500" aria-hidden="true">+</span>
        </summary>
        <ol class="mt-4 list-decimal pl-6 m-0 flex flex-col gap-2">
          {h2s.map((h) => (
            <li>
              <a href={`#${h.slug}`} class="text-ink-700 hover:text-wine-500 no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500 rounded-sm">
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </details>
    )}

    <div class="prose mt-10 text-ink-900 max-w-none">
      <slot />
    </div>

    {(prevPost || nextPost) && (
      <nav aria-label="Pagination" class="mt-16 pt-6 border-t border-ink-200 flex flex-col sm:flex-row sm:justify-between gap-4">
        <div class="flex-1">
          {prevPost && (
            <a href={`/thoughts/${prevPost.id}/`} class="block no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500 rounded-sm">
              <span class="text-small text-ink-500">← previous</span>
              <span class="block text-ink-900 font-bold text-body mt-1 hover:text-wine-500 transition-colors">{prevPost.data.title}</span>
            </a>
          )}
        </div>
        <div class="flex-1 sm:text-right">
          {nextPost && (
            <a href={`/thoughts/${nextPost.id}/`} class="block no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500 rounded-sm">
              <span class="text-small text-ink-500">next →</span>
              <span class="block text-ink-900 font-bold text-body mt-1 hover:text-wine-500 transition-colors">{nextPost.data.title}</span>
            </a>
          )}
        </div>
      </nav>
    )}

    {relatedPosts.length > 0 && (
      <section class="mt-16 pt-6 border-t border-ink-200">
        <h2 class="kicker mb-6">related</h2>
        <ul class="list-none m-0 p-0 flex flex-col">
          {relatedPosts.map((rp) => (
            <li class="py-2 border-t border-ink-200 first:border-t-0">
              <a href={`/thoughts/${rp.id}/`} class="text-ink-900 hover:text-wine-500 no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500 rounded-sm">
                <span class="text-small text-ink-500 mr-2 tabular-nums">{rp.data.publishedDate.slice(0, 4)}</span>
                {rp.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
