---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Alt text for the share image. Defaults to the page title. */
  ogImageAlt?: string;
  type?: 'website' | 'article';
  /** Home page shows the plain title with no site-name suffix. */
  isHome?: boolean;
  /** Error pages: nothing should nominate a 404 as the canonical version of anything. */
  noCanonical?: boolean;
  bodyClass?: string;
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  type = 'website',
  isHome = false,
  noCanonical = false,
  bodyClass,
} = Astro.props;

// Google cuts titles around 60 characters. When the " — Paul Fernandez" suffix
// is what pushes a title past that, drop the suffix rather than let the suffix
// survive and the headline get truncated — the headline is what earns the click.
const suffixed = `${title} — Paul Fernandez`;
const pageTitle = isHome || suffixed.length > 60 ? title : suffixed;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const resolvedOgImage = new URL(ogImage ?? '/og/home.png', Astro.site);

// Hrefs carry the trailing slash so every internal link points at the same URL
// the page declares as canonical — otherwise the whole link graph lands one
// redirect short of the indexed URL.
const navItems = [
  { href: '/about/', label: 'About' },
  { href: '/thoughts/', label: 'Writing' },
  { href: '/projects/', label: 'Projects' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/now/', label: 'Now' },
  // Phase 21: "Work with me" was a filled button pinned to the top-right of a
  // floating pill nav — the most recognisable SaaS chrome there is. It is a
  // page like any other, so it is now a link like any other.
  { href: '/work-with-me/', label: 'Work with me' },
];

const elsewhere = [
  { href: 'https://www.linkedin.com/in/jpaulfernandez/', label: 'LinkedIn' },
  { href: 'https://www.instagram.com/goofffball/', label: 'Instagram' },
  { href: 'mailto:jpaul.fernandez18@gmail.com', label: 'Email' },
  { href: '/rss.xml', label: 'RSS' },
];

const currentPath = Astro.url.pathname;
const isNavActive = (href: string) => {
  if (href === '/thoughts/') {
    return currentPath.startsWith('/thoughts/') || currentPath.startsWith('/topics/');
  }
  // Every href ends in "/", so a prefix match covers the section's children too.
  return currentPath.startsWith(href);
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      Must run before first paint. global.css hides every [data-reveal] behind
      a `.js` ancestor selector, so this class is what arms the animations —
      and its absence is what guarantees the page is legible when the motion
      bundle fails to load, is blocked, or throws.
    */}
    <script is:inline>document.documentElement.classList.add('js');</script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!noCanonical && <link rel="canonical" href={canonicalURL} />}

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:alt" content={ogImageAlt ?? pageTitle} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Paul Fernandez" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt ?? pageTitle} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#050505" />
    <meta name="color-scheme" content="dark" />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Paul Fernandez" href="/rss.xml" />

    <!-- llms.txt discovery: the plain-text site summary for LLM crawlers. -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="llms-full.txt" />

    <!-- Critical font preloads. Switzer 500 draws every heading above the fold;
         400 draws the body under it. The other three faces load on demand. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/switzer-500.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/switzer-400.woff2" crossorigin />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-KJX3LCC0SZ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-KJX3LCC0SZ');
    </script>

    <slot name="head" />
  </head>

  <body class={`min-h-screen flex flex-col ${bodyClass ?? ''}`}>
    <a href="#main" class="skip-link">Skip to content</a>

    {/*
      Phase 21 shell. The Phase 20 nav was a floating, blurred, glass pill that
      solidified on scroll and hid itself on the way down, with a filled CTA
      pinned beside it. That is the chrome of a product landing page, and it was
      the loudest single thing making this site read as one.

      What replaces it is a masthead: it sits at the top of the document, in
      normal flow, and scrolls away with everything else. A rule underneath, a
      name on the left, the sections on the right. No blur, no fill, no pill,
      no scroll behaviour to write — which is also why initNav() is gone.
    */}
    <header class="site-header">
      <div class="shell flex items-baseline justify-between gap-6 py-6">
        <a href="/" class="wordmark" aria-label="Paul Fernandez — home">Paul Fernandez</a>

        <nav aria-label="Main" class="hidden lg:block">
          <ul class="flex items-baseline gap-6 list-none m-0 p-0">
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isNavActive(item.href) ? 'page' : undefined}
                  class="nav-link"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <button
          type="button"
          class="menu-toggle mono-micro"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-menu-toggle
        >
          Menu
        </button>
      </div>
    </header>

    {/*
      Mobile menu. Phase 21 moved it from a fixed full-screen overlay into
      normal flow, directly under the masthead it belongs to. That removes the
      body scroll lock, the opacity fade, and with it the forced-reflow hack
      that the fade needed in order not to strand a transparent panel full of
      focusable links — the panel is now either in the document or not.
    */}
    <div id="mobile-menu" class="mobile-menu" data-menu hidden>
      <nav aria-label="Mobile" class="shell pb-10">
        <ul class="list-none m-0 p-0 flex flex-col">
          {navItems.map((item) => (
            <li class="border-t border-[var(--line)]">
              <a
                href={item.href}
                aria-current={isNavActive(item.href) ? 'page' : undefined}
                class="mobile-link"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>

        <ul class="list-none m-0 p-0 mt-8 flex flex-wrap gap-x-6 gap-y-2">
          {elsewhere.map((link) => (
            <li>
              <a
                href={link.href}
                {...(link.href.startsWith('http')
                  ? { target: '_blank', rel: 'noopener noreferrer' }
                  : {})}
                class="mono-micro hover:text-paper-50"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell">
        <!-- The statement. One per site, and the last thing anyone reads.
             Phase 21: the wine on "have to build it" is gone, and so is the
             line-by-line mask reveal — it is a plain reveal now. -->
        <p class="footer-statement" data-reveal="up">
          Figuring out what to build,<br />
          with the people who have to build it.
        </p>

        <!-- Phase 21: two buttons under a statement is a conversion block. One
             outlined control, one plain address. -->
        <div class="mt-10 md:mt-12 flex flex-wrap items-center gap-6">
          <a href="/work-with-me/" class="btn btn-primary">Work with me</a>
          <a href="mailto:jpaul.fernandez18@gmail.com" class="footer-link">
            jpaul.fernandez18@gmail.com
          </a>
        </div>

        <div
          class="mt-16 md:mt-24 pt-10 border-t border-[var(--line)] grid gap-10 sm:grid-cols-3"
        >
          <div>
            <h2 class="mono-micro">Explore</h2>
            <ul class="mt-4 list-none m-0 p-0 flex flex-col gap-2">
              {navItems.map((item) => (
                <li>
                  <a href={item.href} class="footer-link">{item.label}</a>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h2 class="mono-micro">Elsewhere</h2>
            <ul class="mt-4 list-none m-0 p-0 flex flex-col gap-2">
              {elsewhere.map((link) => (
                <li>
                  <a
                    href={link.href}
                    {...(link.href.startsWith('http')
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                    class="footer-link"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h2 class="mono-micro">This site</h2>
            <ul class="mt-4 list-none m-0 p-0 flex flex-col gap-2">
              <li><a href="/colophon/" class="footer-link">Colophon</a></li>
              <li><a href="/llms.txt" class="footer-link">llms.txt</a></li>
            </ul>
          </div>

        </div>
      </div>
    </footer>

    <style>
      /* ---- Masthead ----------------------------------------------------- */
      .site-header { border-bottom: 1px solid var(--line); }

      .wordmark {
        font-family: var(--font-display);
        font-weight: 500;
        letter-spacing: -0.02em;
        color: var(--color-paper-50);
      }

      .nav-link {
        font-size: var(--text-small);
        color: var(--color-paper-400);
      }
      .nav-link:hover { color: var(--color-paper-50); }
      /* The current section is marked by an underline rather than a filled
       * chip. A chip is a tab in an app; an underline is a marked-up word. */
      .nav-link[aria-current='page'] {
        color: var(--color-paper-50);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.4em;
      }

      /* Phase 21: the two-bar hamburger is gone — an icon that has to animate
       * into an X to explain itself, when the word fits in the same space. */
      .menu-toggle { color: var(--color-paper-400); }
      .menu-toggle:hover { color: var(--color-paper-50); }
      .menu-toggle[aria-expanded='true']::after { content: ' ×'; }

      /* Not `lg:hidden`: Astro scopes this block's selectors with an attribute,
       * which outranks a single Tailwind class, so the utility would lose. */
      @media (min-width: 64rem) {
        .menu-toggle { display: none; }
        .mobile-menu { display: none; }
      }

      .mobile-link {
        display: block;
        padding: 1rem 0;
        font-family: var(--font-display);
        font-size: var(--text-h3);
        font-weight: 500;
        letter-spacing: -0.02em;
        color: var(--color-paper-100);
      }
      .mobile-link[aria-current='page'] { color: var(--color-paper-50); }

      /* ---- Footer ------------------------------------------------------- */
      /* Phase 21: the wine radial gradient bleeding down from the top edge is
       * deleted. An ambient coloured glow behind a section is the single most
       * legible "AI-generated landing page" tell there is. Flat ground. */
      .site-footer {
        padding-block: clamp(4rem, 2rem + 8vw, 8rem) 3rem;
        border-top: 1px solid var(--line);
      }
      .footer-statement {
        font-family: var(--font-display);
        font-size: clamp(2rem, 1.1rem + 3.8vw, 4rem);
        font-weight: 500;
        line-height: 1.05;
        letter-spacing: -0.035em;
        color: var(--color-paper-50);
        margin: 0;
        max-width: 20ch;
      }
      .footer-link {
        font-size: var(--text-small);
        color: var(--color-paper-400);
      }
      .footer-link:hover { color: var(--color-paper-50); }

      .sr-only {
        position: absolute;
        width: 1px; height: 1px;
        padding: 0; margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
      }
    </style>

    {/*
      Mobile menu. Vanilla, no island — rung 4 of the YAGNI ladder.

      Phase 21 shrank this by half. The panel is in normal flow now rather than
      a fixed overlay, so there is no body scroll to lock and no fade to time,
      which retires the forced-reflow hack the fade needed: [hidden] is the
      entire state, and a hidden element holds nothing in the tab order.
    */}
    <script is:inline>
      (() => {
        const toggle = document.querySelector('[data-menu-toggle]');
        const menu = document.querySelector('[data-menu]');
        if (!toggle || !menu) return;

        const setOpen = (open) => {
          toggle.setAttribute('aria-expanded', String(open));
          menu.hidden = !open;
        };

        toggle.addEventListener('click', () =>
          setOpen(toggle.getAttribute('aria-expanded') !== 'true')
        );
        menu.addEventListener('click', (e) => {
          if (e.target.closest('a')) setOpen(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') setOpen(false);
        });
      })();
    </script>

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
