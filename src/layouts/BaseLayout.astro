---
import '../styles/global.css';
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { PERSON_SUMMARY } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Alt text for the share image. Defaults to the page title. */
  ogImageAlt?: string;
  type?: 'website' | 'article';
  /** Home page shows the plain title with no site-name suffix. */
  isHome?: boolean;
  /** Error pages: nothing should nominate a 404 as the canonical version of anything. */
  noCanonical?: boolean;
  bodyClass?: string;
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  type = 'website',
  isHome = false,
  noCanonical = false,
  bodyClass,
} = Astro.props;

// Google cuts titles around 60 characters. When the " — Paul Fernandez" suffix
// is what pushes a title past that, drop the suffix rather than let the suffix
// survive and the headline get truncated — the headline is what earns the click.
const suffixed = `${title} — Paul Fernandez`;
const pageTitle = isHome || suffixed.length > 60 ? title : suffixed;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const resolvedOgImage = new URL(ogImage ?? '/og/home.png', Astro.site);

// Hrefs carry the trailing slash so every internal link points at the same URL
// the page declares as canonical — otherwise the whole link graph lands one
// redirect short of the indexed URL.
// rebuild-plan §4: six sections, left to right. Home is the wordmark.
const navItems = [
  { href: '/work-with-me/', label: 'Work with me' },
  { href: '/projects/', label: 'Projects' },
  { href: '/thoughts/', label: 'Thoughts' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/about/', label: 'About' },
  { href: '/now/', label: 'Now' },
];

// The one red fill in the chrome. Lands on the enquiry form on Work with me.
const cta = { href: '/work-with-me/#enquire', label: 'Book a scoping call' };

// GitHub is omitted until Paul confirms the profile URL (plan.md, Blocked).
const elsewhere = [
  { href: 'mailto:jpaul.fernandez18@gmail.com', label: 'Email' },
  { href: 'https://www.linkedin.com/in/jpaulfernandez/', label: 'LinkedIn' },
  { href: 'https://www.instagram.com/goofffball/', label: 'Instagram' },
  { href: '/rss.xml', label: 'RSS' },
];

const thisSite = [
  { href: '/sitemap/', label: 'Sitemap' },
  { href: '/colophon/', label: 'Colophon' },
  { href: '/llms.txt', label: 'llms.txt' },
];

const year = new Date().getFullYear();

const currentPath = Astro.url.pathname;
const isNavActive = (href: string) => {
  if (href === '/thoughts/') {
    return currentPath.startsWith('/thoughts/') || currentPath.startsWith('/topics/');
  }
  // Every href ends in "/", so a prefix match covers the section's children too.
  return currentPath.startsWith(href);
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      Must run before first paint. Progressive-enhancement scripts (the
      Thoughts/Projects filters, the Gallery controls in Phase 35) key off
      this class: any hidden resting state sits behind a `.js` ancestor
      selector, so a page whose scripts are blocked or broken stays usable.
    */}
    <script is:inline>document.documentElement.classList.add('js');</script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!noCanonical && <link rel="canonical" href={canonicalURL} />}

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:alt" content={ogImageAlt ?? pageTitle} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Paul Fernandez" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt ?? pageTitle} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#FFFFFF" />
    <meta name="color-scheme" content="light" />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Paul Fernandez" href="/rss.xml" />

    <!-- llms.txt discovery: the plain-text site summary for LLM crawlers. -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="llms-full.txt" />

    <!-- Critical font preloads: Fraunces draws the headings above the fold,
         Inter the body under it. JetBrains Mono and other subsets load on demand. -->
    <link rel="preload" as="font" type="font/woff2" href={frauncesUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interUrl} crossorigin />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-KJX3LCC0SZ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-KJX3LCC0SZ');
    </script>

    <slot name="head" />
  </head>

  <body class={`min-h-screen flex flex-col ${bodyClass ?? ''}`}>
    <a href="#main" class="skip-link">Skip to content</a>

    {/*
      v3 masthead: a plain bar in normal flow with a 1px rule under it.
      Wordmark left, six section links, one red button right. Below 64rem the
      links fold into a native <details> sheet — no script, no aria-expanded
      to keep in sync; it closes on navigation because the page reloads.
    */}
    <header class="site-header">
      <div class="shell header-bar">
        <a href="/" class="wordmark" aria-label="Paul Fernandez — home">Paul Fernandez</a>

        <nav aria-label="Main" class="desktop-nav">
          <ul class="nav-list">
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isNavActive(item.href) ? 'page' : undefined}
                  class="nav-link"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="header-actions">
          <a href={cta.href} class="btn btn-primary header-cta">{cta.label}</a>

          <details class="mobile-nav">
            <summary class="mobile-summary mono-micro">Menu</summary>
            <nav aria-label="Mobile" class="mobile-sheet">
              <div class="shell">
                <ul class="mobile-list">
                  {navItems.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        aria-current={isNavActive(item.href) ? 'page' : undefined}
                        class="mobile-link"
                      >
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
                <a href={cta.href} class="btn btn-primary mobile-cta">{cta.label}</a>
              </div>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell">
        <p class="subtext footer-summary">{PERSON_SUMMARY}</p>

        <div class="footer-rows">
          <ul class="footer-list" aria-label="Elsewhere">
            {elsewhere.map((link) => (
              <li>
                <a
                  href={link.href}
                  {...(link.href.startsWith('http')
                    ? { target: '_blank', rel: 'noopener noreferrer' }
                    : {})}
                  class="footer-link"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
          <ul class="footer-list" aria-label="This site">
            {thisSite.map((link) => (
              <li><a href={link.href} class="footer-link">{link.label}</a></li>
            ))}
          </ul>
          <p class="mono-micro footer-copy">© {year} Paul Fernandez</p>
        </div>
      </div>
    </footer>

    <style>
      /* ---- Masthead ----------------------------------------------------- */
      .site-header {
        position: relative;
        border-bottom: 1px solid var(--line);
        background: var(--color-paper);
      }
      .header-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding-block: 1rem;
      }

      .wordmark {
        font-family: var(--font-display);
        font-size: var(--text-lead);
        font-weight: 500;
        letter-spacing: -0.02em;
        color: var(--color-ink-900);
        text-decoration: none;
      }

      .nav-list {
        display: flex;
        align-items: baseline;
        gap: 1.5rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .nav-link {
        font-size: var(--text-small);
        color: var(--color-ink-900);
        text-decoration: none;
      }
      .nav-link:hover,
      .nav-link[aria-current='page'] {
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.4em;
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 1.5rem;
      }
      .header-cta { font-size: var(--text-small); }

      /* Mobile sheet: native <details>. The marker is replaced by the word. */
      .mobile-summary {
        cursor: pointer;
        list-style: none;
        color: var(--color-ink-900);
        padding-block: 0.5rem;
      }
      .mobile-summary::-webkit-details-marker { display: none; }
      .mobile-nav[open] .mobile-summary::after { content: ' ×'; }

      .mobile-sheet {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 10;
        background: var(--color-paper);
        border-bottom: 1px solid var(--line);
        padding-bottom: 2rem;
      }
      .mobile-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .mobile-list li + li { border-top: 1px solid var(--line); }
      .mobile-link {
        display: block;
        padding: 0.875rem 0;
        font-family: var(--font-display);
        font-size: var(--text-h3);
        font-weight: 500;
        letter-spacing: -0.02em;
        color: var(--color-ink-900);
        text-decoration: none;
      }
      .mobile-link[aria-current='page'] {
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
      }
      .mobile-cta { margin-top: 1.5rem; }

      /* Breakpoints by media query, not `md:`/`lg:` utilities: Astro scopes
       * these selectors with an attribute, which outranks a single Tailwind
       * class, so a utility would lose (CLAUDE.md). */
      .desktop-nav,
      .header-cta { display: none; }
      @media (min-width: 48rem) {
        .header-cta { display: inline-flex; }
        .mobile-cta { display: none; }
      }
      @media (min-width: 64rem) {
        .desktop-nav { display: block; }
        .mobile-nav { display: none; }
      }

      /* ---- Footer ------------------------------------------------------- */
      .site-footer {
        padding-block: var(--space-xl);
        border-top: 1px solid var(--line);
      }
      .footer-summary { margin: 0; max-width: var(--measure); }
      .footer-rows {
        margin-top: var(--space-l);
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 1rem 2.5rem;
      }
      .footer-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .footer-link {
        font-size: var(--text-small);
        color: var(--color-ink-600);
        text-decoration: none;
      }
      .footer-link:hover {
        color: var(--color-ink-900);
        text-decoration: underline;
        text-underline-offset: 0.3em;
      }
      .footer-copy { margin: 0; }
    </style>

  </body>
</html>
