---
import '../styles/global.css';

// Import the exact critical font files as URL assets so the preload hrefs
// always match the hashed filenames Astro/Vite emits at build time.
// Phase 8: Courier Prime replaces Archivo Black + Lato; preload 400 + 700.
import courierPrime400Woff2 from '@fontsource/courier-prime/files/courier-prime-latin-400-normal.woff2?url';
import courierPrime700Woff2 from '@fontsource/courier-prime/files/courier-prime-latin-700-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Alt text for the share image. Defaults to the page title. */
  ogImageAlt?: string;
  type?: 'website' | 'article';
  /** Home page shows the plain title with no site-name suffix. */
  isHome?: boolean;
  /** Error pages: nothing should nominate a 404 as the canonical version of anything. */
  noCanonical?: boolean;
  bodyClass?: string;
}

const { title, description, ogImage, ogImageAlt, type = 'website', isHome = false, noCanonical = false, bodyClass } = Astro.props;

// Google cuts titles around 60 characters. When the " — Paul Fernandez" suffix
// is what pushes a title past that, drop the suffix rather than let the suffix
// survive and the headline get truncated — the headline is what earns the click.
const suffixed = `${title} — Paul Fernandez`;
const pageTitle = isHome || suffixed.length > 60 ? title : suffixed;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// The /og/*.png route generates real 1200x630 cards at build time; /og/home.png
// is the site-wide fallback for any page without its own card. (There is no
// og-default.png in public/ — pointing at one shipped a 404 on every share.)
const resolvedOgImage = new URL(ogImage ?? '/og/home.png', Astro.site);

// Hrefs carry the trailing slash so every internal link points at the same URL
// the page declares as canonical — otherwise the whole link graph lands one
// redirect short of the indexed URL.
const navItems = [
  { href: '/about/', label: 'me' },
  { href: '/work-with-me/', label: 'work' },
  { href: '/projects/', label: 'projects' },
  { href: '/thoughts/', label: 'thoughts' },
  { href: '/gallery/', label: 'gallery' },
  { href: '/now/', label: 'now' },
];

const currentPath = Astro.url.pathname;
const isNavActive = (href: string) => {
  if (href === '/thoughts/') {
    return currentPath.startsWith('/thoughts/') || currentPath.startsWith('/topics/');
  }
  // Every href ends in "/", so a prefix match covers the section's children too.
  return currentPath.startsWith(href);
};

const secondaryLinks = [
  { href: '/colophon/', label: 'colophon' },
  { href: '/rss.xml', label: 'rss' },
  { href: 'mailto:jpaul.fernandez18@gmail.com', label: 'email' },
  { href: 'https://www.linkedin.com/in/jpaulfernandez/', label: 'linkedin', external: true },
  { href: 'https://www.instagram.com/goofffball/', label: 'instagram', external: true },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!noCanonical && <link rel="canonical" href={canonicalURL} />}

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:alt" content={ogImageAlt ?? pageTitle} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Paul Fernandez" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt ?? pageTitle} />

    <!-- Favicon — magenta square (Phase 8). -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#FAF6F4" />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Paul Fernandez" href="/rss.xml" />

    <!-- llms.txt discovery: the plain-text site summary for LLM crawlers. -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="llms-full.txt" />

    <!-- Critical font preloads (Courier Prime 400 + 700, self-hosted @fontsource). -->
    <link rel="preload" as="font" type="font/woff2" href={courierPrime400Woff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={courierPrime700Woff2} crossorigin />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-KJX3LCC0SZ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-KJX3LCC0SZ');
    </script>

    <slot name="head" />
  </head>
  <body class={`min-h-screen flex flex-col ${bodyClass ?? ''}`}>
    <a href="#main" class="skip-link">Skip to content</a>

    {/*
      Phase 8 shell — floating sidebar anchored next to main content.
        • Mobile (< lg): site header sits inline at the top of the body, right-aligned.
        • lg+: sidebar sits directly to the left of the main content column (tight gap),
          vertically centered in the viewport, right-aligned toward the content.
        • Main content has a generous reading width (max-w-3xl).
    */}
    <div class="w-full max-w-5xl mx-auto flex-1 lg:flex lg:justify-center lg:items-start lg:gap-10 xl:gap-12 px-6">
      <header class="pt-10 pb-8 lg:py-0 flex flex-col items-end text-right lg:sticky lg:top-0 lg:h-screen lg:justify-center lg:w-44 xl:w-48 shrink-0">
        <a
          href="/"
          class="site-name block font-bold text-ink-900 no-underline tracking-tight leading-none text-body text-right focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500 rounded-sm px-1"
        >
          Paul Fernandez
        </a>

        <span class="site-meta mt-2 block text-ink-500 text-small tracking-wide text-right">
          technologist · philippines
        </span>

        <nav aria-label="Main" class="mt-8 lg:mt-10">
          <ul class="flex flex-wrap justify-end gap-x-6 gap-y-2 list-none m-0 p-0 lg:flex-col lg:items-end lg:gap-y-3">
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isNavActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'nav-link text-body no-underline text-ink-700 hover:text-ink-900',
                    'focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500 rounded-sm px-1',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        {/* Secondary links — under the primary nav, right-aligned. */}
        <ul class="mt-8 lg:mt-10 hidden lg:flex flex-col items-end gap-y-2 text-small text-ink-500 list-none m-0 p-0">
          {secondaryLinks.map((link) => (
            <li>
              <a
                href={link.href}
                {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                class="text-ink-500 hover:text-ink-900 no-underline transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500 rounded-sm px-1"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </header>

      <div class="flex-1 min-w-0 max-w-3xl flex flex-col min-h-screen">
        <!-- Main content — wider reading column (max-w-3xl). -->
        <main id="main" class="flex-1 py-12 md:py-20">
          <slot />
        </main>

        <!-- Footer — aligned with main content. -->
        <footer class="py-8 border-t border-ink-200/60">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-3 text-small">
            <p class="m-0 text-ink-500">&copy; {new Date().getFullYear()} Paul Fernandez</p>
            {/* Mobile-only secondary links (< lg), since the lg+ sidebar owns them. */}
            <ul class="flex flex-wrap gap-x-6 gap-y-1 list-none m-0 p-0 lg:hidden">
              {secondaryLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    class="text-ink-500 hover:text-ink-900 no-underline transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500 rounded-sm px-1"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </footer>
      </div>
    </div>

    <style>
      /* Magenta ● marks the active page — single accent. The marker is part
       * of the link's inline content, so right-alignment pulls label+marker
       * toward the right edge together. */
      .nav-link[aria-current='page'] {
        color: var(--color-wine-500);
        font-weight: 700;
      }
      .nav-link[aria-current='page']::before {
        content: '■';
        color: var(--color-wine-500);
        margin-right: 0.4em;
        font-size: 0.7em;
        vertical-align: 0.25em;
      }
    </style>
  </body>
</html>
