---
import '../styles/global.css';

// Import the exact critical font files as URL assets so the preload hrefs
// always match the hashed filenames Astro/Vite emits at build time.
// Phase 8: Courier Prime replaces Archivo Black + Lato; preload 400 + 700.
import courierPrime400Woff2 from '@fontsource/courier-prime/files/courier-prime-latin-400-normal.woff2?url';
import courierPrime700Woff2 from '@fontsource/courier-prime/files/courier-prime-latin-700-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  type?: 'website' | 'article';
  /** Home page shows the plain title with no site-name suffix. */
  isHome?: boolean;
  bodyClass?: string;
  /** Inverts the whole shell to pure black — used by the colophon page. */
  dark?: boolean;
}

const {
  title,
  description,
  ogImage,
  type = 'website',
  isHome = false,
  bodyClass,
  dark = false,
} = Astro.props;

const pageTitle = isHome ? title : `${title} — Paul Fernandez`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const resolvedOgImage = new URL(ogImage ?? '/og-default.png', Astro.site);

const navItems = [
  { href: '/about', label: 'me' },
  { href: '/work-with-me', label: 'work' },
  { href: '/projects', label: 'projects' },
  { href: '/thoughts', label: 'thoughts' },
  { href: '/gallery', label: 'gallery' },
  { href: '/now', label: 'now' },
];

const currentPath = Astro.url.pathname;
const isNavActive = (href: string) => {
  if (href === '/thoughts') {
    return currentPath.startsWith('/thoughts') || currentPath.startsWith('/topics');
  }
  return currentPath === href || currentPath.startsWith(`${href}/`);
};

const secondaryLinks = [
  { href: '/colophon', label: 'colophon' },
  { href: '/rss.xml', label: 'rss' },
  { href: 'mailto:jpaul.fernandez18@gmail.com', label: 'email' },
  { href: 'https://www.linkedin.com/in/jpaulfernandez/', label: 'linkedin', external: true },
  { href: 'https://www.instagram.com/goofffball/', label: 'instagram', external: true },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={resolvedOgImage} />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Favicon — magenta square (Phase 8). -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Paul Fernandez" href="/rss.xml" />

    <!-- Critical font preloads (Courier Prime 400 + 700, self-hosted @fontsource). -->
    <link rel="preload" as="font" type="font/woff2" href={courierPrime400Woff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={courierPrime700Woff2} crossorigin />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-KJX3LCC0SZ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-KJX3LCC0SZ');
    </script>

    <slot name="head" />
  </head>
  <body class={`min-h-screen flex flex-col ${dark ? 'dark' : ''} ${bodyClass ?? ''}`}>
    <a href="#main" class="skip-link">Skip to content</a>

    {/*
      Phase 11 shell — nav rail pinned to the left edge of the viewport.
        • Mobile (< lg): header sits inline at the top of the body, left-aligned;
          the primary links form a 3×2 grid of full-width tap rows.
        • lg+: header is fixed to the left viewport edge, vertically centered,
          left-aligned; the content column is centered in the remaining width.
        • Main content keeps the max-w-3xl reading width.
    */}
    <header class="px-6 pt-10 pb-8 lg:py-0 lg:fixed lg:inset-y-0 lg:left-0 lg:z-40 lg:w-52 xl:w-64 lg:px-8 flex flex-col items-start text-left lg:justify-center shrink-0">
      <a
        href="/"
        class="site-name block font-bold text-ink-900 dark:text-paper-100 no-underline tracking-tight leading-none text-body focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500 dark:focus-visible:ring-wine-300 rounded-sm px-1"
      >
        Paul Fernandez
      </a>

      <span class="site-meta mt-2 block text-ink-500 dark:text-ink-200 text-small tracking-wide">
        technologist · philippines
      </span>

      <nav aria-label="Main" class="mt-8 lg:mt-10">
        <ul class="grid grid-cols-3 gap-x-4 gap-y-1 list-none m-0 p-0 lg:flex lg:flex-col lg:items-start lg:gap-y-3">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isNavActive(item.href) ? 'page' : undefined}
                class:list={[
                  'nav-link block py-2 lg:py-0 text-body no-underline text-ink-700 dark:text-ink-200 hover:text-ink-900 dark:hover:text-paper-50',
                  'focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500 dark:focus-visible:ring-wine-300 rounded-sm px-1',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      {/* Secondary links — lg+ only; on mobile they live in the footer. */}
      <ul class="mt-8 lg:mt-10 hidden lg:flex flex-col items-start gap-y-2 text-small list-none m-0 p-0">
        {secondaryLinks.map((link) => (
          <li>
            <a
              href={link.href}
              {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              class="text-ink-500 dark:text-ink-200 hover:text-ink-900 dark:hover:text-paper-50 no-underline transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500 dark:focus-visible:ring-wine-300 rounded-sm px-1"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </header>

    <div class="flex-1 flex flex-col min-h-screen lg:pl-52 xl:pl-64">
      <div class="flex-1 w-full max-w-3xl mx-auto px-6 flex flex-col min-w-0">
        <!-- Main content — wider reading column (max-w-3xl). -->
        <main id="main" class="flex-1 py-12 md:py-20">
          <slot />
        </main>

        <!-- Footer — aligned with main content. -->
        <footer class="py-8 border-t border-ink-200/60 dark:border-paper-100/20">
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-3 text-small">
            <p class="m-0 text-ink-500 dark:text-ink-200">&copy; {new Date().getFullYear()} Paul Fernandez</p>
            {/* Mobile-only secondary links (< lg), since the lg+ rail owns them. */}
            <ul class="flex flex-wrap gap-x-6 gap-y-1 list-none m-0 p-0 lg:hidden">
              {secondaryLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    class="text-ink-500 dark:text-ink-200 hover:text-ink-900 dark:hover:text-paper-50 no-underline transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500 dark:focus-visible:ring-wine-300 rounded-sm px-1"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </footer>
      </div>
    </div>

    <style>
      /* Magenta ● marks the active page — single accent. The marker is part
       * of the link's inline content, so right-alignment pulls label+marker
       * toward the right edge together. */
      .nav-link[aria-current='page'] {
        color: var(--color-wine-500);
        font-weight: 700;
      }
      .nav-link[aria-current='page']::before {
        content: '■';
        color: var(--color-wine-500);
        margin-right: 0.4em;
        font-size: 0.7em;
        vertical-align: 0.25em;
      }
    </style>
  </body>
</html>
