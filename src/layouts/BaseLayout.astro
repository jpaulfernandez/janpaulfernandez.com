---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Alt text for the share image. Defaults to the page title. */
  ogImageAlt?: string;
  type?: 'website' | 'article';
  /** Home page shows the plain title with no site-name suffix. */
  isHome?: boolean;
  /** Error pages: nothing should nominate a 404 as the canonical version of anything. */
  noCanonical?: boolean;
  bodyClass?: string;
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  type = 'website',
  isHome = false,
  noCanonical = false,
  bodyClass,
} = Astro.props;

// Google cuts titles around 60 characters. When the " — Paul Fernandez" suffix
// is what pushes a title past that, drop the suffix rather than let the suffix
// survive and the headline get truncated — the headline is what earns the click.
const suffixed = `${title} — Paul Fernandez`;
const pageTitle = isHome || suffixed.length > 60 ? title : suffixed;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const resolvedOgImage = new URL(ogImage ?? '/og/home.png', Astro.site);

// Hrefs carry the trailing slash so every internal link points at the same URL
// the page declares as canonical — otherwise the whole link graph lands one
// redirect short of the indexed URL.
const navItems = [
  { href: '/about/', label: 'About' },
  { href: '/thoughts/', label: 'Writing' },
  { href: '/projects/', label: 'Projects' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/now/', label: 'Now' },
];

const elsewhere = [
  { href: 'https://www.linkedin.com/in/jpaulfernandez/', label: 'LinkedIn' },
  { href: 'https://www.instagram.com/goofffball/', label: 'Instagram' },
  { href: 'mailto:jpaul.fernandez18@gmail.com', label: 'Email' },
  { href: '/rss.xml', label: 'RSS' },
];

const currentPath = Astro.url.pathname;
const isNavActive = (href: string) => {
  if (href === '/thoughts/') {
    return currentPath.startsWith('/thoughts/') || currentPath.startsWith('/topics/');
  }
  // Every href ends in "/", so a prefix match covers the section's children too.
  return currentPath.startsWith(href);
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      Must run before first paint. global.css hides every [data-reveal] behind
      a `.js` ancestor selector, so this class is what arms the animations —
      and its absence is what guarantees the page is legible when the motion
      bundle fails to load, is blocked, or throws.
    */}
    <script is:inline>document.documentElement.classList.add('js');</script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!noCanonical && <link rel="canonical" href={canonicalURL} />}

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:alt" content={ogImageAlt ?? pageTitle} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Paul Fernandez" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={ogImageAlt ?? pageTitle} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#050505" />
    <meta name="color-scheme" content="dark" />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="Paul Fernandez" href="/rss.xml" />

    <!-- llms.txt discovery: the plain-text site summary for LLM crawlers. -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="llms-full.txt" />

    <!-- Critical font preloads. Switzer 500 draws every heading above the fold;
         400 draws the body under it. The other three faces load on demand. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/switzer-500.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/switzer-400.woff2" crossorigin />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-KJX3LCC0SZ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-KJX3LCC0SZ');
    </script>

    <slot name="head" />
  </head>

  <body class={`min-h-screen flex flex-col ${bodyClass ?? ''}`}>
    <a href="#main" class="skip-link">Skip to content</a>

    {/*
      Phase 20 shell. The Phase 8 sidebar is gone: it worked at a 736px reading
      column but it caps the page at that width forever, and a display face at
      104px needs the whole viewport. The nav is now a floating bar, so full-
      bleed sections can run edge to edge underneath it.
    */}
    <header
      data-nav
      data-scrolled="false"
      data-hidden="false"
      class="site-nav fixed inset-x-0 top-0 z-100"
    >
      <div class="shell flex items-center justify-between gap-4 py-4">
        <!-- Wordmark -->
        <a href="/" class="group flex items-center gap-3 shrink-0" aria-label="Paul Fernandez — home">
          <span class="h-2 w-2 shrink-0 rounded-full bg-wine-400" aria-hidden="true"></span>
          <span class="font-display font-medium tracking-tight text-paper-50 leading-none">
            Paul Fernandez
          </span>
        </a>

        <!-- Desktop pill -->
        <nav aria-label="Main" class="hidden lg:block">
          <ul class="nav-pill flex items-center gap-1 list-none m-0 p-1">
            {navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isNavActive(item.href) ? 'page' : undefined}
                  class="nav-link"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="flex items-center gap-2 shrink-0">
          <a href="/work-with-me/" class="btn btn-primary hidden sm:inline-flex text-small">
            Work with me
          </a>

          <button
            type="button"
            class="menu-toggle"
            aria-expanded="false"
            aria-controls="mobile-menu"
            data-menu-toggle
          >
            <span class="sr-only">Menu</span>
            <span class="menu-bars" aria-hidden="true"><i></i><i></i></span>
          </button>
        </div>
      </div>
    </header>

    <!-- Mobile menu. A plain hidden panel, not a <dialog>: it needs to sit
         under the nav bar rather than over it, so the toggle stays visible. -->
    <div id="mobile-menu" class="mobile-menu lg:hidden" data-menu hidden>
      <nav aria-label="Mobile" class="shell pt-32 pb-12">
        <ul class="list-none m-0 p-0 flex flex-col">
          {navItems.map((item) => (
            <li class="border-b border-[var(--line)]">
              <a
                href={item.href}
                aria-current={isNavActive(item.href) ? 'page' : undefined}
                class="mobile-link"
              >
                {item.label}
                <span aria-hidden="true" class="text-paper-600">↗</span>
              </a>
            </li>
          ))}
        </ul>

        <a href="/work-with-me/" class="btn btn-primary mt-8 w-full justify-center">
          Work with me
        </a>

        <ul class="list-none m-0 p-0 mt-8 flex flex-wrap gap-x-6 gap-y-2">
          {elsewhere.map((link) => (
            <li>
              <a
                href={link.href}
                {...(link.href.startsWith('http')
                  ? { target: '_blank', rel: 'noopener noreferrer' }
                  : {})}
                class="mono-micro hover:text-paper-50"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell">
        <!-- The statement. One per site, and the last thing anyone reads. -->
        <p class="footer-statement" data-split="lines">
          Figuring out what to build,<br />
          with the people who <span class="flare">have to build it</span>.
        </p>

        <div class="mt-12 md:mt-16 flex flex-wrap items-center gap-4">
          <a href="/work-with-me/" class="btn btn-primary">Work with me</a>
          <a href="mailto:jpaul.fernandez18@gmail.com" class="btn btn-ghost">Send an email</a>
        </div>

        <div
          class="mt-16 md:mt-24 pt-10 border-t border-[var(--line)] grid gap-10 sm:grid-cols-3"
        >
          <div>
            <h2 class="mono-micro">Explore</h2>
            <ul class="mt-4 list-none m-0 p-0 flex flex-col gap-2">
              {navItems.map((item) => (
                <li>
                  <a href={item.href} class="footer-link">{item.label}</a>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h2 class="mono-micro">Elsewhere</h2>
            <ul class="mt-4 list-none m-0 p-0 flex flex-col gap-2">
              {elsewhere.map((link) => (
                <li>
                  <a
                    href={link.href}
                    {...(link.href.startsWith('http')
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                    class="footer-link"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h2 class="mono-micro">This site</h2>
            <ul class="mt-4 list-none m-0 p-0 flex flex-col gap-2">
              <li><a href="/colophon/" class="footer-link">Colophon</a></li>
              <li><a href="/llms.txt" class="footer-link">llms.txt</a></li>
            </ul>
          </div>

        </div>
      </div>
    </footer>

    <style>
      /* ---- Nav ---------------------------------------------------------- */
      .site-nav {
        transition: transform 0.3s var(--ease-out-quint), background-color 0.22s var(--ease-out-quint), backdrop-filter 0.22s var(--ease-out-quint), border-color 0.22s var(--ease-out-quint);
        border-bottom: 1px solid transparent;
      }
      .site-nav[data-scrolled='true'] {
        background-color: rgba(5, 5, 5, 0.72);
        backdrop-filter: blur(16px) saturate(140%);
        -webkit-backdrop-filter: blur(16px) saturate(140%);
        border-bottom-color: var(--line);
      }
      .site-nav[data-hidden='true'] { transform: translateY(-100%); }

      .nav-pill {
        background-color: var(--surface-1);
        border: 1px solid var(--line);
        border-radius: var(--radius-pill);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      }
      .nav-link {
        display: block;
        padding: 0.5rem 1rem;
        border-radius: var(--radius-pill);
        font-size: var(--text-small);
        font-weight: 500;
        letter-spacing: -0.005em;
        color: var(--color-paper-400);
        transition: color 0.22s var(--ease-out-quint), background-color 0.22s var(--ease-out-quint);
      }
      .nav-link:hover { color: var(--color-paper-50); background-color: var(--surface-2); }
      .nav-link[aria-current='page'] {
        color: var(--color-paper-50);
        background-color: var(--surface-3);
      }

      .menu-toggle {
        display: grid;
        place-items: center;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: var(--radius-pill);
        background-color: var(--surface-1);
        border: 1px solid var(--line);
        color: var(--color-paper-100);
      }
      /* Not `lg:hidden`: Astro scopes this block's selectors with an attribute,
       * which outranks a single Tailwind class, so the utility would lose to
       * `display: grid` above. Same reason the mobile menu hides here. */
      @media (min-width: 64rem) {
        .menu-toggle { display: none; }
        .mobile-menu { display: none; }
      }
      .menu-bars { display: grid; gap: 5px; width: 1rem; }
      .menu-bars i {
        display: block;
        height: 1.5px;
        background-color: currentColor;
        transition: transform 0.3s var(--ease-out-quint), opacity 0.22s;
      }
      [aria-expanded='true'] .menu-bars i:first-child { transform: translateY(3.25px) rotate(45deg); }
      [aria-expanded='true'] .menu-bars i:last-child { transform: translateY(-3.25px) rotate(-45deg); }

      .mobile-menu {
        position: fixed;
        inset: 0;
        z-index: 90;
        background-color: var(--color-ink-950);
        overflow-y: auto;
        opacity: 0;
        transition: opacity 0.22s var(--ease-out-quint);
      }
      .mobile-menu[data-open='true'] { opacity: 1; }

      .mobile-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.25rem 0;
        font-family: var(--font-display);
        font-size: var(--text-h2);
        font-weight: 500;
        letter-spacing: -0.03em;
        color: var(--color-paper-100);
      }
      .mobile-link[aria-current='page'] { color: var(--color-wine-300); }

      /* ---- Footer ------------------------------------------------------- */
      .site-footer {
        padding-block: clamp(4rem, 2rem + 8vw, 8rem) 3rem;
        border-top: 1px solid var(--line);
        background:
          radial-gradient(90% 120% at 50% 0%, rgba(224, 68, 111, 0.08), transparent 60%),
          var(--color-ink-950);
      }
      .footer-statement {
        font-family: var(--font-display);
        font-size: clamp(2rem, 1.1rem + 3.8vw, 4rem);
        font-weight: 500;
        line-height: 1.05;
        letter-spacing: -0.035em;
        color: var(--color-paper-50);
        margin: 0;
        max-width: 20ch;
      }
      .footer-link {
        font-size: var(--text-small);
        color: var(--color-paper-400);
      }
      .footer-link:hover { color: var(--color-paper-50); }

      .sr-only {
        position: absolute;
        width: 1px; height: 1px;
        padding: 0; margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
      }
    </style>

    {/*
      Mobile menu. Vanilla, ~30 lines, no island — rung 4 of the YAGNI ladder.
      It toggles [hidden] for correctness (nothing focusable while closed) and
      a data attribute for the fade, with a frame between the two so the
      transition has something to animate from.
    */}
    <script is:inline>
      (() => {
        const toggle = document.querySelector('[data-menu-toggle]');
        const menu = document.querySelector('[data-menu]');
        const nav = document.querySelector('[data-nav]');
        if (!toggle || !menu) return;

        const setOpen = (open) => {
          toggle.setAttribute('aria-expanded', String(open));
          document.body.style.overflow = open ? 'hidden' : '';
          if (open) {
            nav && (nav.dataset.menuOpen = 'true');
            menu.hidden = false;
            // Force a reflow so the transition has a frame to start from.
            // requestAnimationFrame would be the idiomatic way, but it is
            // throttled to nothing in a backgrounded tab — which would leave
            // the panel at opacity 0 while un-hidden: invisible, and still
            // holding every link in the tab order.
            void menu.offsetHeight;
            menu.dataset.open = 'true';
          } else {
            nav && delete nav.dataset.menuOpen;
            menu.dataset.open = 'false';
            setTimeout(() => (menu.hidden = true), 350);
          }
        };

        toggle.addEventListener('click', () =>
          setOpen(toggle.getAttribute('aria-expanded') !== 'true')
        );
        menu.addEventListener('click', (e) => {
          if (e.target.closest('a')) setOpen(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') setOpen(false);
        });
      })();
    </script>

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
