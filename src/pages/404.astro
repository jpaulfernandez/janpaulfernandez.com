---
// 404.astro — branded not-found page. Without this, Vercel serves its own bare
// NOT_FOUND body (with an internal region ID) for every mistyped URL.
import BaseLayout from '../layouts/BaseLayout.astro';

const destinations = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/thoughts/', label: 'Writing' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/work-with-me/', label: 'Work with me' },
];
---

<BaseLayout title="Page not found" description="That page doesn't exist — here's the way back." noCanonical>
  <meta slot="head" name="robots" content="noindex" />

  <section class="page-404" data-hero>
    <div class="shell">
      <h1 class="display" data-reveal="up" data-reveal-delay="0.05">
        404
      </h1>
      <p class="lead mt-8" data-reveal="up" data-reveal-delay="0.1">
        That page doesn't exist. It may have moved, or the link may be wrong.
      </p>

      <nav aria-label="Suggested pages" class="mt-12" data-reveal="up" data-reveal-delay="0.16">
        <ul class="flex flex-wrap gap-3 list-none m-0 p-0">
          {destinations.map((d) => (
            <li><a href={d.href} class="tag">{d.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .page-404 {
    display: flex;
    align-items: center;
    min-height: 70svh;
    padding-block: clamp(8rem, 6rem + 8vw, 12rem) 6rem;
  }
</style>
