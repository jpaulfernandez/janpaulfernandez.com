---
// 404.astro — branded not-found page. Without this, Vercel serves its own bare
// NOT_FOUND body (with an internal region ID) for every mistyped URL.
import BaseLayout from '../layouts/BaseLayout.astro';

// The v3 IA, in nav order.
const destinations = [
  { href: '/', label: 'Home' },
  { href: '/work-with-me/', label: 'Work with me' },
  { href: '/projects/', label: 'Projects' },
  { href: '/thoughts/', label: 'Thoughts' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/about/', label: 'About' },
  { href: '/now/', label: 'Now' },
];
---

<BaseLayout title="Page not found" description="That page doesn't exist — here's the way back." noCanonical>
  <meta slot="head" name="robots" content="noindex" />

  <section class="page-404">
    <div class="shell">
      <h1 class="display">
        404
      </h1>
      <p class="lead mt-8">
        Nothing here. Either I moved it and forgot to leave a note, or the link was wrong to begin with. The things that do exist:
      </p>

      <nav aria-label="Suggested pages" class="mt-12 max-w-[var(--measure)]">
        <ul class="rows border-t border-[var(--line)]">
          {destinations.map((d) => (
            <li>
              <a href={d.href} class="row-link">
                <span class="row-title">{d.label}</span>
                <span class="row-meta">{d.href}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .page-404 {
    display: flex;
    align-items: center;
    min-height: 70svh;
    padding-block: clamp(8rem, 6rem + 8vw, 12rem) 6rem;
  }
</style>
