---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import JsonLd from '../components/JsonLd.astro';
import { person, profilePage, breadcrumbs } from '../lib/schema';
import portrait from '../assets/paul.webp';

const aboutEntry = await getEntry('about', 'about');
if (!aboutEntry) {
  throw new Error('About page singleton is missing. Run seed scripts first.');
}
const { Content: AboutIntro } = await render(aboutEntry);

const careerEntries = await getCollection('career');

// T30. These overrides used to restate the defaults — and after the Person
// node was enriched they were actively stale, pinning this page (the strongest
// entity page on the site) to the five generic knowsAbout nouns the change was
// meant to remove. The defaults in `person()` are the single source now.
const detailedPerson = person();

const seoData = [
  profilePage({ url: '/about/', name: 'Jan Paul Fernandez' }),
  detailedPerson,
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'About', url: '/about/' },
  ]),
];
---

<BaseLayout
  title="About"
  description="My background, work philosophy, and full career track record — from PSBank and Rappler to MMDC."
  ogImage="/og/about.png"
>
  <JsonLd data={seoData} slot="head" />

  <section class="page-head">
    <div class="shell">

      {/* The portrait is tall, so the copy shares its column-height rather
          than leaving the top of the page empty beside it. */}
      <div class="mt-8 grid gap-x-16 gap-y-12 lg:grid-cols-[1.35fr_0.65fr] lg:items-start">
        <div>
          <h1 class="display">
            Jan Paul Fernandez
          </h1>
          <div class="prose mt-10 max-w-[54ch]">
            <AboutIntro />
          </div>
        </div>

        <figure class="portrait m-0 lg:mt-4">
          <Image
            src={portrait}
            alt="Paul Fernandez"
            width={720}
            widths={[480, 720]}
            sizes="(min-width: 1024px) 400px, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      </div>
    </div>
  </section>

  <div class="shell pb-24 md:pb-32">

    <section class="section pt-0" aria-labelledby="experience-heading">
      <h2 id="experience-heading" class="kicker">Experience</h2>
      <div class="mt-12">
        <Timeline entries={careerEntries} variant="full" />
      </div>
    </section>

    {/* How I work — continues the Experience argument: the habits behind it.
        Copy from program spec doc 09 (§1 proof points, §4 About), first
        person; hard-coded here because about.md stays byte-identical
        (docs/rebuild README, departure 5). */}
    <section class="section-tight" aria-labelledby="how-heading">
      <h2 id="how-heading" class="kicker">How I work</h2>
      <ul class="rows how mt-8">
        <li>
          <h3 class="m-0">Simplify, then do.</h3>
          <p class="subtext m-0">
            I simplify until someone can retell it at dinner, then put them to
            work on their own documents. People forget slides. They remember
            what they did.
          </p>
        </li>
        <li>
          <h3 class="m-0">Artefacts leave the room.</h3>
          <p class="subtext m-0">
            Every session produces something you keep: a draft AI policy,
            process maps, vendor scorecards, prompt libraries, a working
            automation, a tested prototype agent.
          </p>
        </li>
        <li>
          <h3 class="m-0">Vendor-neutral.</h3>
          <p class="subtext m-0">
            I build with Claude and Codex but teach the concepts rather than a
            product. You get the same advice whichever tools you choose.
          </p>
        </li>
      </ul>
    </section>

    {/* Connect — the turn to action. Text links only: the header's red
        button is the one red fill in view. */}
    <section class="section section-ruled pb-0" aria-labelledby="contact-heading">
      <h2 id="contact-heading" class="kicker">Connect</h2>
      <p class="statement-sm mt-10 max-w-[24ch]">
        I work with teams three ways: with you, for you, or as an adviser.
      </p>
      <p class="mt-8 mb-0 flex flex-wrap gap-x-8 gap-y-3">
        <a href="/work-with-me/" class="link">Work with me</a>
        <a
          href="https://www.linkedin.com/in/jpaulfernandez/"
          target="_blank"
          rel="noopener noreferrer"
          class="link"
        >LinkedIn<span class="sr-only"> (opens in a new tab)</span> ↗</a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(8rem, 6rem + 8vw, 12rem) clamp(3rem, 2rem + 4vw, 5rem);
  }

  /* How I work: label left, sentence right from 768px; stacked below. */
  .how > li {
    display: grid;
    gap: 0.75rem;
    padding-block: var(--space-m);
  }
  @media (min-width: 768px) {
    .how > li {
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: 2rem;
      align-items: baseline;
    }
  }
  /* Connect's rule closes the list; a second hairline would double it. */
  .how > li:last-child { border-bottom: 0; }
  .how .subtext { max-width: 60ch; }
</style>
