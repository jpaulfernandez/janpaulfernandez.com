---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import JsonLd from '../components/JsonLd.astro';
import { person, profilePage, breadcrumbs } from '../lib/schema';
import portrait from '../assets/paul.webp';

const aboutEntry = await getEntry('about', 'about');
if (!aboutEntry) {
  throw new Error('About page singleton is missing. Run seed scripts first.');
}
const { Content: AboutIntro } = await render(aboutEntry);

const careerEntries = await getCollection('career');

// Detailed Person info for About page JSON-LD
const detailedPerson = person({
  alumniOf: 'Nueva Ecija University of Science and Technology',
  worksFor: 'Mapúa Malayan Digital College (under MMCL)',
  knowsAbout: [
    'Technology',
    'Digital Transformation',
    'AI Implementation',
    'Economy',
    'Psychology',
  ],
});

const seoData = [
  profilePage(),
  detailedPerson,
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'About', url: '/about/' },
  ]),
];
---

<BaseLayout
  title="About"
  description="Learn about Paul Fernandez's technical background, work philosophy, and full career track record."
  ogImage="/og/about.png"
>
  <JsonLd data={seoData} slot="head" />

  <section class="page-head" data-hero>
    <div class="shell">

      {/* The portrait is tall, so the copy shares its column-height rather
          than leaving the top of the page empty beside it. */}
      <div class="mt-8 grid gap-x-16 gap-y-12 lg:grid-cols-[1.35fr_0.65fr] lg:items-start">
        <div>
          <h1 class="display" data-reveal="up" data-reveal-delay="0.05">
            Jan Paul Fernandez
          </h1>
          <div class="prose mt-10 max-w-[54ch]" data-reveal="up" data-reveal-delay="0.12">
            <AboutIntro />
          </div>
        </div>

        <figure class="portrait m-0 lg:mt-4" data-reveal="scale" data-reveal-delay="0.18">
          <Image
            src={portrait}
            alt="Paul Fernandez"
            widths={[480, 720]}
            sizes="(min-width: 1024px) 400px, 100vw"
            loading="eager"
          />
        </figure>
      </div>
    </div>
  </section>

  <div class="shell pb-24 md:pb-32">

    <section class="section pt-0" aria-labelledby="experience-heading">
      <h2 id="experience-heading" class="kicker">Experience</h2>
      <div class="mt-12">
        <Timeline entries={careerEntries} variant="full" />
      </div>
    </section>

    <section aria-labelledby="contact-heading">
      <h2 id="contact-heading" class="kicker">Connect</h2>
      <p class="statement-sm mt-10 max-w-[22ch]" data-reveal="up">
        Available for consultation, talks, and
        fractional product ownership.
      </p>
      <div class="mt-10 flex flex-wrap gap-3" data-reveal="up">
        <a href="/work-with-me/" class="btn btn-primary">Work with me</a>
        <a
          href="https://www.linkedin.com/in/jpaulfernandez/"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost"
        >
          LinkedIn ↗
        </a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(8rem, 6rem + 8vw, 12rem) clamp(3rem, 2rem + 4vw, 5rem);
  }

  .portrait {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .portrait :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.4s var(--ease-out-quint);
  }
  .portrait:hover :global(img) { filter: grayscale(0) contrast(1); }

  .statement-sm {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-paper-50);
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .portrait :global(img) { filter: grayscale(0); }
  }
</style>
