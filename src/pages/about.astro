---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import JsonLd from '../components/JsonLd.astro';
import { person, profilePage, breadcrumbs } from '../lib/schema';

const aboutEntry = await getEntry('about', 'about');
if (!aboutEntry) {
  throw new Error('About page singleton is missing. Run seed scripts first.');
}
const { Content: AboutIntro } = await render(aboutEntry);

const careerEntries = await getCollection('career');

// Detailed Person info for About page JSON-LD
const detailedPerson = person({
  alumniOf: 'Nueva Ecija University of Science and Technology',
  worksFor: 'Mapúa Malayan Digital College (under MMCL)',
  knowsAbout: [
    'Technology',
    'Digital Transformation',
    'AI Implementation',
    'Economy',
    'Psychology',
  ],
});

const seoData = [
  profilePage(),
  detailedPerson,
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'About', url: '/about/' },
  ]),
];
---

<BaseLayout
  title="About"
  description="Learn about Paul Fernandez's technical background, work philosophy, and full career track record."
  ogImage="/og/about.png"
>
  <JsonLd data={seoData} slot="head" />

  <article>
    <header>
      <h1 class="display m-0">Jan Paul <span class="flare">Fernandez</span></h1>
      <div class="prose mt-8 text-ink-700">
        <AboutIntro />
      </div>
    </header>

    <section class="mt-20 md:mt-24" aria-labelledby="experience-heading">
      <h2 id="experience-heading" class="kicker mb-8">
        experience
      </h2>
      <Timeline entries={careerEntries} variant="full" />
    </section>

    <section class="mt-20 md:mt-24" aria-labelledby="contact-heading">
      <h2 id="contact-heading" class="kicker mb-6">
        connect
      </h2>
      <p class="text-body text-ink-700 leading-relaxed m-0">
        Available for consultation, talks, and fractional product ownership.
      </p>
      <p class="mt-3 mb-0 text-small">
        <a href="/work-with-me/" class="text-ink-900 no-underline hover:text-wine-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500 rounded-sm">work with me →</a>
        <span class="text-ink-500 mx-2" aria-hidden="true">·</span>
        <a
          href="https://www.linkedin.com/in/jpaulfernandez/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-ink-900 no-underline hover:text-wine-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500 rounded-sm"
        >
          linkedin ↗
        </a>
      </p>
    </section>
  </article>
</BaseLayout>
