---
// colophon.astro — how the site is built. Static page: no collection, because
// nothing else consumes this content and Paul edits it about once a year.
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { breadcrumbs } from '../lib/schema';

const seoData = [
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'Colophon', url: '/colophon' },
  ]),
];

const stack = [
  { label: 'framework', value: 'Astro 5', note: 'Static output. Zero client JS on every page but the two filter scripts.' },
  { label: 'styles', value: 'Tailwind 4', note: 'CSS-first config. One 8-pt spacing scale, one type scale, no plugins.' },
  { label: 'content', value: 'Keystatic', note: 'Git-based CMS — edits are commits, so there is no database to lose.' },
  { label: 'type', value: 'Archivo Black · Lato · Courier Prime', note: 'Self-hosted. Display, body, labels — one face per job, no overlap.' },
  { label: 'hosting', value: 'Vercel', note: 'Static build, pushed from main.' },
  { label: 'forms', value: 'Web3Forms', note: 'The contact form posts straight to email. No backend of my own.' },
];

const principles = [
  'Static HTML before an island. Vanilla JS before a framework. CSS before JS.',
  'Reading time is Math.ceil(words / 200), not a dependency.',
  'Lines structure the page; colour only marks — a rule, a tick, a word.',
  'Wine leads; slate and olive answer, one accent per section. Never body text.',
  'Every colour used at body size clears WCAG AA against the paper.',
];
---

<BaseLayout
  title="Colophon"
  description="How janpaulfernandez.com is built — the stack, the type, and the rules it follows."
  dark
>
  <JsonLd data={seoData} slot="head" />

  <article>
    <header>
      <h1 class="m-0">Colo<span class="flare">phon</span></h1>
      <p class="mt-8 mb-0 text-ink-700 dark:text-ink-200 text-body leading-relaxed max-w-prose">
        What this site is made of, and the rules it follows. Kept here so the
        next person who asks — usually me, a year from now — has an answer.
      </p>
    </header>

    <section class="mt-24" aria-labelledby="stack-heading" style="--accent: var(--color-wine-300)">
      <h2 id="stack-heading" class="kicker">stack</h2>
      <dl class="mt-8 m-0">
        {stack.map((item) => (
          <div class="grid md:grid-cols-[8rem_1fr] gap-x-8 gap-y-1 py-6 border-b border-ink-200 dark:border-paper-100/20">
            <dt class="text-small text-ink-500 dark:text-paper-100/60 uppercase tracking-widest">{item.label}</dt>
            <dd class="m-0">
              <span class="block font-bold text-h3 leading-tight text-ink-900 dark:text-paper-50">{item.value}</span>
              <span class="block mt-2 text-ink-700 dark:text-ink-200 text-body max-w-prose">{item.note}</span>
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="mt-24" aria-labelledby="rules-heading" style="--accent: var(--color-olive-300)">
      <h2 id="rules-heading" class="kicker">rules</h2>
      <ul class="mt-8 m-0 p-0 list-none flex flex-col gap-4">
        {principles.map((line) => (
          <li class="flex gap-4 text-ink-700 dark:text-ink-200 text-body leading-relaxed max-w-prose">
            <span class="text-wine-500 dark:text-wine-300 shrink-0" aria-hidden="true">—</span>
            <span>{line}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-24" aria-labelledby="source-heading" style="--accent: var(--color-slate-300)">
      <h2 id="source-heading" class="kicker">source</h2>
      <p class="mt-8 mb-0 text-ink-700 dark:text-ink-200 text-body leading-relaxed max-w-prose">
        Photography is mine. Words are mine. If something here is useful to you,
        take it — no attribution needed.
      </p>
    </section>
  </article>
</BaseLayout>
