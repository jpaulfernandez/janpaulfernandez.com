---
// [slug].astro (Individual gallery set / photo page)
import BaseLayout from '../../layouts/BaseLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import JsonLd from '../../components/JsonLd.astro';
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { lightboxWidth } from '../../lib/gallery';
import { formatDate } from '../../lib/dates';
import { imageGallery, breadcrumbs } from '../../lib/schema';

export async function getStaticPaths() {
  const allItems = await getCollection('gallery');
  return allItems.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;

const dateFormatted = formatDate(item.data.publishedDate);

// Build the full photo list combining cover (if present) and additional photos.
// The cover is normally also photos[0]; the dedupe below then drops that entry,
// so the cover has to inherit its caption here or the first frame of every set
// silently loses the one it was given.
const captionFor = (image: ImageMetadata) =>
  item.data.photos.find((p) => p.image === image)?.caption || '';

type Photo = {
  image: ImageMetadata;
  caption: string;
  /** Resolved lightbox source and its real dimensions — not the original's. */
  fullSrc: string;
  fullWidth: number;
  fullHeight: number;
};

const photoList: Photo[] = [];
if (item.data.cover) {
  photoList.push({
    image: item.data.cover,
    caption: captionFor(item.data.cover),
    fullSrc: '',
    fullWidth: 0,
    fullHeight: 0,
  });
}
if (item.data.photos && item.data.photos.length > 0) {
  item.data.photos.forEach((p) => {
    if (!photoList.some((existing) => existing.image === p.image)) {
      photoList.push({
        image: p.image,
        caption: p.caption || '',
        fullSrc: '',
        fullWidth: 0,
        fullHeight: 0,
      });
    }
  });
}

// Lightbox sources: 1600px on the long edge, not the multi-megabyte original.
await Promise.all(
  photoList.map(async (photo) => {
    const rendered = await getImage({ src: photo.image, width: lightboxWidth(photo.image) });
    photo.fullSrc = rendered.src;
    // The ImageObject below points at this render, so it must declare this
    // render's dimensions rather than the (much larger) original's.
    photo.fullWidth = Number(rendered.attributes.width ?? rendered.options.width);
    photo.fullHeight = Number(rendered.attributes.height ?? rendered.options.height);
  })
);

// One alt string per photo, shared by the <img>, the lightbox and the
// ImageObject markup — so a caption written in Keystatic improves all three.
const altFor = (photo: Photo, idx: number) =>
  photo.caption || `${item.data.title} — photo ${idx + 1} of ${photoList.length}`;

const seoData = [
  imageGallery({
    title: item.data.title,
    description: item.data.description,
    url: `/gallery/${item.id}/`,
    datePublished: item.data.publishedDate,
    images: photoList.map((photo, idx) => ({
      url: photo.fullSrc,
      caption: altFor(photo, idx),
      width: photo.fullWidth,
      height: photo.fullHeight,
    })),
  }),
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'Gallery', url: '/gallery/' },
    { name: item.data.title, url: `/gallery/${item.id}/` },
  ]),
];
---

<BaseLayout
  title={item.data.title}
  description={item.data.description || item.data.title}
  ogImage={`/og/gallery-${item.id}.png`}
>
  <JsonLd slot="head" data={seoData} />

  <article>
    <p class="m-0 text-small text-ink-500">
      <a href="/gallery/" class="text-ink-500 hover:text-ink-900 no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500 rounded-sm">← gallery</a>
    </p>

    <header class="mt-3">
      <p class="m-0 text-small text-ink-500 tabular-nums">
        <time datetime={item.data.publishedDate}>{dateFormatted}</time>
        <span class="mx-1" aria-hidden="true">·</span>
        <span>{photoList.length} photos</span>
      </p>
      <h1 class="text-ink-900 m-0 mt-2">{item.data.title}</h1>

      {item.data.description && (
        <p class="mt-3 mb-0 text-ink-700 text-body leading-relaxed">{item.data.description}</p>
      )}

      {item.data.tags && item.data.tags.length > 0 && (
        <p class="m-0 mt-4 text-small text-ink-500 flex flex-wrap gap-x-2">
          {item.data.tags.map((tag) => <span>#{tag}</span>)}
        </p>
      )}
    </header>

    {/* Photo grid — true aspect ratios, laid out by CSS columns. */}
    <div class="gallery-masonry mt-10">
      {photoList.map((photo, idx) => (
        <a
          href={photo.fullSrc}
          class="photo-trigger gallery-masonry-item"
          data-src={photo.fullSrc}
          data-alt={altFor(photo, idx)}
          data-caption={photo.caption}
          aria-label={`View larger: ${altFor(photo, idx)}`}
        >
          <Image
            src={photo.image}
            alt={altFor(photo, idx)}
            class="gallery-masonry-img"
            width={640}
            loading={idx < 6 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </a>
      ))}
    </div>
  </article>

  <Lightbox />
</BaseLayout>

<style>
  .gallery-masonry {
    columns: 1;
    column-gap: 1rem;
  }
  @media (min-width: 640px) {
    .gallery-masonry { columns: 2; }
  }
  /* An <a> now, not a <button>: the href is the full-size image, so the wall
     still works with JS off. These reset the anchor back to a bare frame. */
  .gallery-masonry-item {
    display: block;
    text-decoration: none;
    color: inherit;
    width: 100%;
    margin: 0 0 1rem;
    padding: 0;
    border: 0;
    background: var(--color-ink-200);
    cursor: zoom-in;
    overflow: hidden;
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
  }
  .gallery-masonry-item:focus-visible {
    outline: 2px solid var(--color-wine-500);
    outline-offset: 2px;
  }
  .gallery-masonry-img {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 0.2s ease-out;
  }
  /* Phase 14: the hover zoom is gone — a gentle dim alone marks the hover. */
  .gallery-masonry-item:hover .gallery-masonry-img { opacity: 0.85; }
</style>
