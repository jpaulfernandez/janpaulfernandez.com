---
// [slug].astro (Individual gallery set / photo page)
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allItems = await getCollection('gallery');
  return allItems.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;

const dateFormatted = new Date(item.data.publishedDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

// Build the full photo list combining cover (if present) and additional photos
const photoList: Array<{ image: any; caption: string }> = [];
if (item.data.cover) {
  photoList.push({
    image: item.data.cover,
    caption: item.data.description || item.data.title,
  });
}
if (item.data.photos && item.data.photos.length > 0) {
  item.data.photos.forEach((p) => {
    if (!photoList.some((existing) => existing.image === p.image)) {
      photoList.push({
        image: p.image,
        caption: p.caption || item.data.title,
      });
    }
  });
}
---

<BaseLayout title={`${item.data.title} — Gallery`} description={item.data.description || item.data.title}>
  <article>
    <p class="m-0 text-small text-moss-500">
      <a href="/gallery" class="text-moss-500 hover:text-moss-900 no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-citrus-500 rounded-sm">← gallery</a>
    </p>

    <header class="mt-3">
      <p class="m-0 text-small text-moss-500 tabular-nums">
        <time datetime={item.data.publishedDate}>{dateFormatted}</time>
        <span class="mx-1" aria-hidden="true">·</span>
        <span>{photoList.length} photos</span>
      </p>
      <h1 class="text-moss-900 m-0 mt-2">{item.data.title}</h1>

      {item.data.description && (
        <p class="mt-3 mb-0 text-moss-700 text-body leading-relaxed">{item.data.description}</p>
      )}

      {item.data.tags && item.data.tags.length > 0 && (
        <p class="m-0 mt-4 text-small text-moss-500 flex flex-wrap gap-x-2">
          {item.data.tags.map((tag) => <span>#{tag}</span>)}
        </p>
      )}
    </header>

    {/* Photo grid */}
    <div class="gallery-masonry mt-10">
      {photoList.map((photo, idx) => (
        <div class="gallery-masonry-item mb-4 break-inside-avoid group">
          <button
            type="button"
            class="photo-trigger block w-full focus:outline-none focus-visible:ring-2 focus-visible:ring-citrus-500"
            data-index={idx}
            data-caption={photo.caption}
            data-src={photo.image ? (typeof photo.image === 'string' ? photo.image : photo.image.src) : ''}
            aria-label={`View larger: ${photo.caption || 'Photo ' + (idx + 1)}`}
          >
            {photo.image && (
              <Image
                src={photo.image}
                alt={photo.caption || `${item.data.title} photo ${idx + 1}`}
                class="w-full h-auto object-cover"
                width={800}
                height={600}
              />
            )}
          </button>
        </div>
      ))}
    </div>
  </article>

  <dialog id="photo-modal" class="lightbox-dialog">
    <div class="lightbox-inner">
      <button id="modal-close" type="button" class="lightbox-close" aria-label="Close lightbox">
        ✕
      </button>
      <div class="lightbox-image-wrap">
        <img id="modal-img" src="" alt="" class="lightbox-img" />
      </div>
      <div class="lightbox-controls">
        <button id="modal-prev" type="button" class="lightbox-btn" aria-label="Previous">←</button>
        <span id="modal-counter" class="lightbox-counter"></span>
        <button id="modal-next" type="button" class="lightbox-btn" aria-label="Next">→</button>
      </div>
    </div>
  </dialog>
</BaseLayout>

<style>
  .gallery-masonry {
    columns: 1;
    column-gap: 1rem;
  }
  @media (min-width: 640px) {
    .gallery-masonry { columns: 2; }
  }
  .gallery-masonry-item { break-inside: avoid; }

  .lightbox-dialog {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(14, 14, 14, 0.95);
    color: #FAFAF8;
    z-index: 9999;
  }
  .lightbox-dialog::backdrop { background: rgba(14, 14, 14, 0.95); }

  .lightbox-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 1rem;
    box-sizing: border-box;
  }

  .lightbox-close,
  .lightbox-btn {
    background: transparent;
    border: 1px solid rgba(245, 241, 230, 0.4);
    color: #FAFAF8;
    padding: 0.5rem 0.75rem;
    cursor: pointer;
    font-family: var(--font-body);
  }
  .lightbox-close:hover,
  .lightbox-btn:hover {
    border-color: var(--color-citrus-500);
    color: var(--color-citrus-500);
    background: transparent;
  }
  .lightbox-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
  }

  .lightbox-image-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    width: 100%;
    max-height: calc(100vh - 6rem);
  }
  .lightbox-img {
    max-width: 100%;
    max-height: calc(100vh - 6rem);
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .lightbox-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding-top: 0.75rem;
    flex-shrink: 0;
  }
  .lightbox-counter {
    color: rgba(245, 241, 230, 0.6);
    min-width: 4rem;
    text-align: center;
    font-size: 0.875rem;
  }

  .lightbox-dialog[open] { animation: lightbox-in 0.2s ease-out; }
  @keyframes lightbox-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox-dialog[open] { animation: none; }
  }
</style>

<script>
  const modal = document.getElementById('photo-modal') as HTMLDialogElement;
  const modalImg = document.getElementById('modal-img') as HTMLImageElement;
  const modalCounter = document.getElementById('modal-counter');
  const modalClose = document.getElementById('modal-close');
  const modalPrev = document.getElementById('modal-prev');
  const modalNext = document.getElementById('modal-next');
  const triggers = document.querySelectorAll('.photo-trigger') as NodeListOf<HTMLElement>;

  let currentIndex = 0;
  const totalPhotos = triggers.length;

  function showPhoto(index: number) {
    if (totalPhotos === 0) return;
    currentIndex = (index + totalPhotos) % totalPhotos;
    const trigger = triggers[currentIndex];
    if (!trigger) return;

    const src = trigger.getAttribute('data-src') || '';

    if (modalImg) modalImg.src = src;
    if (modalCounter) modalCounter.textContent = `${currentIndex + 1} / ${totalPhotos}`;
  }

  triggers.forEach((trigger, idx) => {
    trigger.addEventListener('click', () => {
      showPhoto(idx);
      modal?.showModal();
    });
  });

  modalClose?.addEventListener('click', () => {
    modal?.close();
  });

  modalPrev?.addEventListener('click', () => showPhoto(currentIndex - 1));
  modalNext?.addEventListener('click', () => showPhoto(currentIndex + 1));

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.close();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (!modal?.open) return;
    if (e.key === 'ArrowLeft') showPhoto(currentIndex - 1);
    if (e.key === 'ArrowRight') showPhoto(currentIndex + 1);
  });
</script>
