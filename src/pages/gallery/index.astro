---
// index.astro (Gallery index — photobook list)
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const allItems = (await getCollection('gallery')).sort(
  (a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime()
);

// Derive unique tags from actual items
const allTags = Array.from(
  new Set(allItems.flatMap((item) => item.data.tags || []))
).sort();

const description = 'Photography by Paul Fernandez — concerts, festivals, places.';
---

<BaseLayout title="Gallery" description={description}>
  <article>
    <header>
      <h1 class="text-moss-900 m-0">Gallery</h1>
      <p class="mt-4 mb-0 text-moss-700 text-body leading-relaxed">
        Photography — concerts, festivals, places.
      </p>
    </header>

    {allItems.length > 0 && (
      <>
        {allTags.length > 0 && (
          <div class="mt-10 flex flex-wrap gap-2" data-filter-group="tag">
            <button class="filter-chip cursor-pointer px-3 py-1 text-small text-moss-700 underline underline-offset-4 decoration-moss-200 aria-pressed:decoration-moss-900 aria-pressed:text-moss-900 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-citrus-500" aria-pressed="true" data-value="all">all</button>
            {allTags.map((tag) => (
              <button class="filter-chip cursor-pointer px-3 py-1 text-small text-moss-700 underline underline-offset-4 decoration-moss-200 aria-pressed:decoration-moss-900 aria-pressed:text-moss-900 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-citrus-500" aria-pressed="false" data-value={tag}>
                #{tag}
              </button>
            ))}
          </div>
        )}

        <div class="mt-2 flex items-center justify-between text-small text-moss-500 tabular-nums">
          <span id="gallery-counter">
            {allItems.length} {allItems.length === 1 ? 'collection' : 'collections'}
          </span>
          <div id="filter-aria-announcer" aria-live="polite" class="sr-only">
            Showing {allItems.length} collections
          </div>
        </div>

        <div id="gallery-grid" class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-12">
          {allItems.map((item) => {
            const dateFormatted = new Date(item.data.publishedDate).toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'short',
            });

            return (
              <a
                href={`/gallery/${item.id}`}
                class="gallery-card group flex flex-col no-underline text-moss-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-citrus-500 rounded-sm"
                data-tags={item.data.tags?.join(',')}
              >
                {item.data.cover && (
                  <div class="aspect-[4/3] w-full overflow-hidden bg-moss-200">
                    <Image
                      src={item.data.cover}
                      alt={item.data.title}
                      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
                      width={800}
                      height={600}
                    />
                  </div>
                )}

                <div class="mt-3 flex flex-col gap-1">
                  <time datetime={item.data.publishedDate} class="text-small text-moss-500 tabular-nums">
                    {dateFormatted}
                  </time>
                  <h2 class="font-bold text-moss-900 m-0 group-hover:text-citrus-500 transition-colors">
                    {item.data.title}
                  </h2>
                  {item.data.tags && item.data.tags.length > 0 && (
                    <p class="m-0 text-small text-moss-500 flex flex-wrap gap-x-2">
                      {item.data.tags.slice(0, 4).map((tag) => (
                        <span>#{tag}</span>
                      ))}
                    </p>
                  )}
                </div>
              </a>
            );
          })}
        </div>

        <div id="empty-state" class="hidden text-center py-12 border border-moss-200 mt-8">
          <p class="text-moss-700 mb-2">No gallery collections match this filter.</p>
          <p class="text-small text-moss-500">Reset to "all".</p>
        </div>
      </>
    )}
  </article>
</BaseLayout>

<!-- Native client-side DOM filter script (rung 4 progressive enhancement) -->
<script>
  const chips = document.querySelectorAll('.filter-chip');
  const cards = document.querySelectorAll('.gallery-card') as NodeListOf<HTMLElement>;
  const counter = document.getElementById('gallery-counter');
  const announcer = document.getElementById('filter-aria-announcer');
  const emptyState = document.getElementById('empty-state');

  let activeTag = 'all';

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const parentGroup = chip.closest('[data-filter-group]') as HTMLElement | null;
      if (!parentGroup) return;

      parentGroup.querySelectorAll('.filter-chip').forEach((c) => c.setAttribute('aria-pressed', 'false'));
      chip.setAttribute('aria-pressed', 'true');
      activeTag = chip.getAttribute('data-value') || 'all';

      let visibleCount = 0;
      cards.forEach((card) => {
        const cardTags = card.getAttribute('data-tags')?.split(',') || [];
        const matchesTag = activeTag === 'all' || cardTags.includes(activeTag);

        if (matchesTag) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      const resultText = `${visibleCount} collection${visibleCount === 1 ? '' : 's'}`;
      if (counter) counter.textContent = resultText;
      if (announcer) announcer.textContent = `Showing ${resultText}`;

      if (visibleCount === 0) {
        emptyState?.classList.remove('hidden');
      } else {
        emptyState?.classList.add('hidden');
      }
    });
  });
</script>
