---
// index.astro (Gallery index — one date-sorted library of every photograph)
import BaseLayout from '../../layouts/BaseLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import JsonLd from '../../components/JsonLd.astro';
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { libraryOrder, lightboxWidth } from '../../lib/gallery';
import { collectionPage, breadcrumbs } from '../../lib/schema';

const collection = await getCollection('gallery');
const sets = [...collection].sort((a, b) =>
  a.data.publishedDate < b.data.publishedDate ? 1 : a.data.publishedDate > b.data.publishedDate ? -1 : 0
);

// Every photo of every set, newest first, cover deduped (src/lib/gallery.ts).
// Each gets a 1600px viewer source — the originals are ~1.5 MB each.
const library = await Promise.all(
  libraryOrder(collection).map(async (photo) => ({
    ...photo,
    fullSrc: (await getImage({ src: photo.image, width: lightboxWidth(photo.image) })).src,
  }))
);

const description =
  'Concert and live-music photography by Paul Fernandez — Wanderland, BINI, HONNE, '
  + 'Daniel Caesar and other nights in Manila. Shot from the pit and the crowd.';

// The library is 95 loose frames; the sets are what a crawler can name and
// link to, so the ItemList indexes the sets rather than every photograph.
const seoData = [
  collectionPage({
    title: 'Gallery',
    description,
    url: '/gallery/',
    items: sets.map((set) => ({ name: set.data.title, url: `/gallery/${set.id}/` })),
  }),
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'Gallery', url: '/gallery/' },
  ]),
];
---

<BaseLayout title="Gallery" description={description} ogImage="/og/gallery.png">
  <JsonLd slot="head" data={seoData} />

  <section class="page-head">
    <div class="shell">
      <h1 class="display">Gallery</h1>
      <p class="lead mt-8">
        Concerts, festivals, places — shot from
        wherever I could get.
      </p>
      <div class="head-row mt-6">
        <p class="mono-micro">
          {library.length} photographs · {sets.length} sets
        </p>
      </div>
    </div>
  </section>

  {/* One grid. With JS off every thumbnail is a plain link to its set page;
      gallery.ts turns the click into the viewer. Square crop is CSS only. */}
  <div class="shell">
    <div class="library" id="library">
      {library.map((photo, index) => {
        const alt = photo.caption || photo.setTitle;
        return (
          <a
            href={`/gallery/${photo.setSlug}/`}
            class="photo-trigger"
            data-src={photo.fullSrc}
            data-alt={alt}
            data-caption={photo.caption}
            data-href={`/gallery/${photo.setSlug}/`}
            data-href-label={`${photo.setTitle} →`}
            aria-label={`View larger: ${alt}`}
          >
            <Image
              src={photo.image}
              alt={alt}
              width={720}
              widths={[160, 320, 480, 720]}
              sizes="(min-width: 48rem) 17vw, 34vw"
              class="library-img"
              decoding="async"
              loading={index < 12 ? 'eager' : 'lazy'}
            />
          </a>
        );
      })}
    </div>
  </div>

  {/* The sets still exist as their own pages — reachable from here and from
      the viewer, without grouping the library itself. */}
  <div class="shell pb-24 md:pb-32">
    {sets.length > 0 && (
      <section class="section-tight" aria-labelledby="sets-heading">
        <h2 id="sets-heading" class="kicker">Sets</h2>
        <ul class="rows mt-8">
          {sets.map((set) => (
            <li>
              <a href={`/gallery/${set.id}/`} class="row-link">
                <span class="min-w-0">
                  <span class="row-title block">{set.data.title}</span>
                  <span class="block mt-2 subtext max-w-[60ch]">
                    {set.data.description}
                  </span>
                </span>
                <span class="row-meta">{set.data.publishedDate.slice(0, 4)} ↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>

  <Lightbox />
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(8rem, 6rem + 8vw, 12rem) clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  /* Counter left, density control (35.4) right, one row. */
  .head-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* The library. `--cols` is the only thing gallery.ts changes. touch-action
   * hands two-finger gestures over the grid to the density pinch; page zoom
   * stays available everywhere else and the viewer has its own zoom. */
  .library {
    --cols: 3;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 2px;
    touch-action: pan-x pan-y;
  }
  @media (min-width: 48rem) {
    .library { --cols: 6; }
  }

  .photo-trigger {
    display: block;
    background: var(--color-paper-100);
    cursor: zoom-in;
  }
  .photo-trigger:focus-visible {
    outline: 2px solid var(--color-red-700);
    outline-offset: 2px;
    border-radius: 0;
    position: relative;
    z-index: 1;
  }

  .library-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }
</style>
