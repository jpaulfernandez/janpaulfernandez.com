---
// index.astro (Gallery index — one flat wall of photographs)
import BaseLayout from '../../layouts/BaseLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { lightboxWidth, masonryLayout } from '../../lib/gallery';

const sets = (await getCollection('gallery')).sort(
  (a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime()
);

type Shot = {
  /** Stable per-photo key — `${set.id}:${src}` — seeds the width hash. */
  key: string;
  image: ImageMetadata;
  /** Right-sized source for the lightbox — the originals are ~1.5 MB each. */
  fullSrc: string;
  /** Empty unless the photo carries its own caption — the lightbox's set link
   *  already says where it came from, so the set title is not repeated here. */
  caption: string;
  setTitle: string;
  setId: string;
  /** Position in [0,1) used to spread each set evenly across the wall. */
  spread: number;
  /** Column bucket and width chosen by the build-time masonry packer. */
  column: number;
  widthFactor: number;
};

// Flatten every set into a single list of photographs. The cover is usually
// also the first photo, so dedupe on the resolved asset path.
const shots: Shot[] = [];
sets.forEach((set) => {
  const seen = new Set<string>();
  const own: Shot[] = [];

  const add = (image: ImageMetadata | undefined, caption: string) => {
    if (!image || seen.has(image.src)) return;
    seen.add(image.src);
    own.push({
      key: `${set.id}:${image.src}`,
      image,
      fullSrc: '',
      caption,
      setTitle: set.data.title,
      setId: set.id,
      spread: 0,
      column: 0,
      widthFactor: 1,
    });
  };

  add(set.data.cover, '');
  set.data.photos.forEach((p) => add(p.image, p.caption || ''));

  // Evenly distribute this set's photos across the full 0–1 range, so a
  // 50-shot set and a 12-shot set both run the length of the wall instead of
  // sitting as two solid blocks.
  own.forEach((shot, i) => {
    shot.spread = (i + 0.5) / own.length;
  });
  shots.push(...own);
});

// Stable interleave: sets stay in reverse-chronological order on ties, so the
// output is identical on every build.
shots.sort((a, b) => a.spread - b.spread);

// Build-time masonry: deterministic pseudo-random widths + shortest-column
// packing, so the wall reads as a scatter of sizes, not a 3-col grid. (88 of
// the 95 shots are the same 4:3 crop — equal-width columns can't break the
// grid.) The browser just flexes the three columns that come out of here.
const slots = masonryLayout(
  shots.map((s) => ({ id: s.key, width: s.image.width, height: s.image.height })),
  3
);
slots.forEach((slot, i) => {
  shots[i].column = slot.column;
  shots[i].widthFactor = slot.widthFactor;
});
const wallColumns = [0, 1, 2].map((c) => shots.filter((s) => s.column === c));

// Lightbox sources: 1600px on the long edge, which is plenty for a full-screen
// view and roughly a tenth of the original file.
await Promise.all(
  shots.map(async (shot) => {
    shot.fullSrc = (await getImage({ src: shot.image, width: lightboxWidth(shot.image) })).src;
  })
);

const description = 'Photography by Paul Fernandez — concerts, festivals, places.';
---

<BaseLayout title="Gallery" description={description}>
  <article>
    <header>
      <h1 class="display m-0">Gallery</h1>
      <p class="mt-8 mb-0 text-ink-700 text-body leading-relaxed max-w-prose">
        Photography — <span class="flare">concerts, festivals, places</span>.
      </p>
      <p class="mt-2 mb-0 text-ink-500 text-small tabular-nums">
        {shots.length} photographs · {sets.length} sets
      </p>
    </header>

    {shots.length > 0 && (
      <>
        {/* Mobile: the original 2-column flow — at 375px the tidy grid reads
            as intentional, and the packed wall is too fine below 640px. */}
        <div class="wall wall-mobile sm:hidden mt-16 md:mt-20">
          {shots.map((shot, idx) => (
            <a
              href={shot.fullSrc}
              class="photo-trigger wall-item"
              data-src={shot.fullSrc}
              data-alt={shot.caption || shot.setTitle}
              data-caption={shot.caption}
              data-href={`/gallery/${shot.setId}`}
              data-href-label={`${shot.setTitle} →`}
              aria-label={`View larger: ${shot.caption || shot.setTitle}`}
            >
              <Image
                src={shot.image}
                alt={shot.caption || shot.setTitle}
                class="wall-img"
                width={560}
                loading={idx < 6 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </a>
          ))}
        </div>

        {/* Desktop: the build-time masonry — width varies per shot, columns
            are packed to similar height, so the wall reads as a scatter. */}
        <div class="wall wall-masonry hidden sm:flex mt-16 md:mt-20">
          {wallColumns.map((column) => (
            <div class="wall-col">
              {column.map((shot, idx) => (
                <a
                  href={shot.fullSrc}
                  class="photo-trigger wall-item"
                  style={`width: ${shot.widthFactor * 100}%`}
                  data-src={shot.fullSrc}
                  data-alt={shot.caption || shot.setTitle}
                  data-caption={shot.caption}
                  data-href={`/gallery/${shot.setId}`}
                  data-href-label={`${shot.setTitle} →`}
                  aria-label={`View larger: ${shot.caption || shot.setTitle}`}
                >
                  <Image
                    src={shot.image}
                    alt={shot.caption || shot.setTitle}
                    class="wall-img"
                    width={560}
                    loading={idx < 6 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </a>
              ))}
            </div>
          ))}
        </div>
      </>
    )}

    {/* The sets still exist as their own pages — reachable from here and from
        the lightbox, without grouping the wall itself. */}
    {sets.length > 0 && (
      <section class="mt-16 md:mt-20" aria-labelledby="sets-heading">
        <h2 id="sets-heading" class="kicker">Sets</h2>
        <ul class="rows mt-6">
          {sets.map((set) => (
            <li>
              <a href={`/gallery/${set.id}`} class="row-link">
                <span>{set.data.title}</span>
                <span class="row-meta">{set.data.publishedDate.slice(0, 4)} ↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>

  <Lightbox />
</BaseLayout>

<style>
  /* Mobile wall (hidden ≥640px): the original CSS-columns flow. 2-column at
   * 375px reads as an intentional grid, and the packed masonry is too fine
   * below 640px to matter. */
  .wall-mobile {
    columns: 2;
    column-gap: 0.75rem;
  }

  /* Desktop wall (shown ≥640px): the three buckets produced by the build-time
   * packer in masonryLayout(). Display must come from `hidden sm:flex` — an
   * unlayered rule here would beat the Tailwind utility and leak the wall
   * onto mobile. */
  .wall-masonry {
    gap: 0.75rem;
    align-items: flex-start;
  }
  .wall-col {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* An <a> now, not a <button>: the href is the full-size image, so the wall
     still works with JS off. These reset the anchor back to a bare frame. */
  .wall-item {
    display: block;
    text-decoration: none;
    color: inherit;
    width: 100%;
    margin: 0 0 0.75rem;
    padding: 0;
    border: 0;
    background: var(--color-ink-200);
    cursor: zoom-in;
    overflow: hidden;
    break-inside: avoid;
    /* Chromium still splits an unbroken block across columns without this. */
    -webkit-column-break-inside: avoid;
  }
  /* In the flex layout the column gap owns the spacing; both rules for a
     uniform margin-zero there. Width per shot is set inline by the packer. */
  .wall-masonry .wall-item { margin: 0; }
  .wall-item:focus-visible {
    outline: 2px solid var(--color-wine-500);
    outline-offset: 2px;
  }

  .wall-img {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 0.2s ease-out;
  }
  /* Phase 14: the hover zoom is gone — a gentle dim alone marks the hover. */
  .wall-item:hover .wall-img { opacity: 0.85; }
</style>
