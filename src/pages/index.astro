---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { person, webSite, profilePage, breadcrumbs } from '../lib/schema';
import { getPublishedThoughts } from '../lib/thoughts';
import { getProjects } from '../lib/projects';

// Services double as the home "work" rows — same source as /work-with-me.
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

// Fetch Keystatic Home singleton
const homeEntry = await getEntry('home', 'home');
if (!homeEntry) {
  throw new Error('Home page singleton is missing. Run the seed scripts first.');
}
const { heroGreeting, heroIntro } = homeEntry.data;

// Hero: the greeting's last word carries the wine flare, so the accent tracks
// whatever Paul writes in Keystatic instead of being hardcoded here.
const greetingWords = heroGreeting.trim().split(' ');
const greetingHead = greetingWords.slice(0, -1).join(' ');
const greetingFlare = greetingWords[greetingWords.length - 1];

// Latest Now entry -> the ruled band under the hero.
const nowEntries = await getCollection('now');
const latestNow = [...nowEntries].sort((a, b) => b.data.date.localeCompare(a.data.date))[0];
const nowDate = latestNow
  ? new Date(`${latestNow.data.date}T12:00:00`).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  : undefined;

// Latest thoughts for the Writing index (5 rows; the kicker carries the total).
const allThoughts = await getPublishedThoughts();
const latestThoughts = allThoughts.slice(0, 5);

// Latest projects for the Projects index (3 rows; the kicker carries the total).
const allProjects = await getProjects();
const latestProjects = allProjects.slice(0, 3);

const seoData = [
  webSite(),
  profilePage(),
  person(),
  breadcrumbs([{ name: 'Home', url: '/' }]),
];
---

<BaseLayout
  title="Paul Fernandez"
  description="Technologist from the Philippines who ships under pressure — banking, election-night newsrooms, national-scale education — now helping teams adopt AI and ship the right thing."
  isHome
>
  <JsonLd data={seoData} slot="head" />

  <article>
    {/* Identity: statement → bio. */}
    <header class="fade-rise">
      <h1 class="m-0">
        {greetingHead && <>{greetingHead}{' '}</>}<span class="flare">{greetingFlare}</span>
      </h1>
      {heroIntro && (
        <p class="mt-8 mb-0 text-ink-700 text-body leading-relaxed max-w-[62ch]">{heroIntro}</p>
      )}
    </header>

    {/* NOW — the live signal, a ruled band under the hero. */}
    {latestNow && (
      <a href="/now" class="now-block mt-12">
        <span class="now-block-label">
          <span class="live-dot" aria-hidden="true"></span>
          right now
        </span>
        <span class="now-block-title">{latestNow.data.title || latestNow.id}</span>
        <span class="now-block-meta">
          <span>{nowDate}</span>
          <span class="now-block-arrow" aria-hidden="true">→</span>
        </span>
      </a>
    )}

    {/* Work — numbered rows. Hover draws the title rule, never a fill. */}
    {services.length > 0 && (
      <section class="mt-24" aria-labelledby="work-heading">
        <h2 id="work-heading" class="kicker">
          work
          <span class="kicker-meta">{services.length} {services.length === 1 ? 'service' : 'services'}</span>
        </h2>
        <ol class="num-rows mt-8">
          {services.map((service, i) => (
            <li>
              <a href="/work-with-me" class="num-row">
                <span class="num-row-index">{String(i + 1).padStart(2, '0')}</span>
                <span class="num-row-title">{service.data.title}</span>
                <span class="num-row-desc">{service.data.description}</span>
              </a>
            </li>
          ))}
        </ol>
        <a href="/work-with-me" class="btn mt-8">work with me →</a>
      </section>
    )}

    {/* Writing index */}
    {latestThoughts.length > 0 && (
      <section class="mt-24" aria-labelledby="writing-heading" style="--accent: var(--color-slate-500)">
        <h2 id="writing-heading" class="kicker">
          writing
          <span class="kicker-meta">{allThoughts.length} {allThoughts.length === 1 ? 'thought' : 'thoughts'}</span>
        </h2>
        <ul class="rows mt-8">
          {latestThoughts.map((post) => (
            <li>
              <a href={`/thoughts/${post.id}`} class="row-link">
                <span class="font-bold">{post.data.title}</span>
                <time class="row-meta" datetime={post.data.publishedDate}>
                  {post.data.publishedDate.slice(0, 4)}
                </time>
              </a>
            </li>
          ))}
        </ul>
        <a href="/thoughts" class="more-link">all thoughts →</a>
      </section>
    )}

    {/* Projects index */}
    {latestProjects.length > 0 && (
      <section class="mt-24" aria-labelledby="projects-heading" style="--accent: var(--color-olive-500)">
        <h2 id="projects-heading" class="kicker">
          projects
          <span class="kicker-meta">{allProjects.length} {allProjects.length === 1 ? 'project' : 'projects'}</span>
        </h2>
        <ul class="rows mt-8">
          {latestProjects.map((project) => (
            <li>
              {project.data.link ? (
                <a href={project.data.link} target="_blank" rel="noopener noreferrer" class="row-link">
                  <span>
                    <span class="font-bold">{project.data.title}</span>
                    <span class="block mt-1 text-ink-500 text-small">{project.data.description}</span>
                  </span>
                  <span class="row-meta" aria-hidden="true">↗</span>
                </a>
              ) : (
                <div class="row-link">
                  <span>
                    <span class="font-bold">{project.data.title}</span>
                    <span class="block mt-1 text-ink-500 text-small">{project.data.description}</span>
                  </span>
                </div>
              )}
            </li>
          ))}
        </ul>
        <a href="/projects" class="more-link">all projects →</a>
      </section>
    )}
  </article>
</BaseLayout>
