---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { person, webSite, breadcrumbs } from '../lib/schema';
import { getPublishedThoughts } from '../lib/thoughts';
import { getProjects } from '../lib/projects';
import { formatDate } from '../lib/dates';

const homeEntry = await getEntry('home', 'home');
if (!homeEntry) {
  throw new Error('Home page singleton is missing. Run the seed scripts first.');
}
const { heroGreeting, heroIntro } = homeEntry.data;

function cleanSnippet(raw?: string, max = 160) {
  if (!raw) return '';
  const text = raw
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/[*_`>#]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  if (text.length <= max) return text;
  const sub = text.slice(0, max);
  const lastPeriod = Math.max(sub.lastIndexOf('.'), sub.lastIndexOf('!'), sub.lastIndexOf('?'));
  if (lastPeriod > 60) {
    return sub.slice(0, lastPeriod + 1);
  }
  const lastSpace = sub.lastIndexOf(' ');
  return `${sub.slice(0, lastSpace > 0 ? lastSpace : max).trimEnd()}…`;
}

// The bio is a Keystatic plain-text field, but it carries a couple of markdown
// links. Split each paragraph into plain strings and { label, href } links so
// the statement can render them as real anchors without a markdown pipeline.
function withInlineLinks(text: string) {
  const parts: Array<string | { label: string; href: string }> = [];
  const re = /\[([^\]]+)\]\(([^)]+)\)/g;
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = re.exec(text))) {
    if (m.index > last) parts.push(text.slice(last, m.index));
    parts.push({ label: m[1], href: m[2] });
    last = m.index + m[0].length;
  }
  if (last < text.length) parts.push(text.slice(last));
  return parts;
}

const latestNowEntries = [...(await getCollection('now'))]
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3)
  .map((entry, index) => ({
    ...entry,
    snippet: index === 0 ? cleanSnippet(entry.body) : undefined,
  }));

const latestThoughts = (await getPublishedThoughts()).slice(0, 4);
const latestProjects = (await getProjects()).slice(0, 3);

// Phase 32.6 minimum repair: "What I do" reads the three Work with me modes
// (the old `services` collection is gone). Home's real rewrite is Phase 34.
const modes = (await getEntry('workWithMe', 'workWithMe'))?.data.modes ?? [];

// A contact sheet for the gallery teaser. Frames are interleaved across sets
// so the row never shows the same concert twice in a row.
const gallerySets = (await getCollection('gallery')).sort(
  (a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime()
);
const stripShots = gallerySets
  .flatMap((set, setIndex) =>
    set.data.photos.slice(1, 4).map((photo, i) => ({
      image: photo.image as unknown as ImageMetadata,
      caption: photo.caption || set.data.title,
      setTitle: set.data.title,
      // Interleave: order by frame position first, set second.
      order: i * 10 + setIndex,
    }))
  )
  .sort((a, b) => a.order - b.order);

const photoCount = gallerySets.reduce((n, set) => n + set.data.photos.length, 0);

// No ProfilePage here — this page is a hub (now-feed, recent writing,
// program teaser), not a profile. That node lives on /about/, which is the
// case Google's docs actually name. Emitting it from both pages made two
// documents claim to be the ProfilePage for the same URL.
const seoData = [
  webSite(),
  person(),
  breadcrumbs([{ name: 'Home', url: '/' }]),
];
---

<BaseLayout
  title="Paul Fernandez"
  description="Technologist from the Philippines. Shipped banking systems, ran election results at Rappler, and now build for higher ed. I help teams figure out what to build."
  isHome
>
  <JsonLd data={seoData} slot="head" />

  {/* ---------------------------------------------------------------------
      HERO.
     --------------------------------------------------------------------- */}
  <section class="hero">
    <div class="shell">
      <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16 lg:items-start">
        <div>
          <p class="mono-micro flex items-center gap-3">
            <span class="h-px w-8 bg-blue-200"></span>
            Technologist · Philippines
          </p>

          <h1 class="display mt-8 max-w-[16ch]">
            {heroGreeting}
          </h1>

          <p class="lead mt-8 max-w-[46ch]">
            I help teams figure out what to build. Most of that work turns out to be
            getting everyone to agree on what the words mean.
          </p>

          {/* Hero actions: the program is the featured offer */}
          <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3">
            <a href="/work-with-me/ai-resilient-organisation/" class="btn btn-primary">See the program →</a>
            <a href="/thoughts/" class="link-arrow">Read the writing</a>
            <a href="/work-with-me/" class="link-arrow">Work with me</a>
          </div>
        </div>

        <div class="mt-6 lg:mt-0">
          <div class="flex items-end justify-between gap-6 border-b border-[var(--line)] pb-4 mb-8">
            <h2 id="hero-now-heading" class="kicker m-0">Now</h2>
            <a href="/now/" class="link-arrow shrink-0">Full timeline</a>
          </div>

          <div class="rail rail-compact">
            {latestNowEntries.map((entry, index) => (
              <article class="rail-item">
                <time class="rail-date" datetime={entry.data.date}>
                  {formatDate(entry.data.date)}
                </time>
                <h3 class="m-0">
                  <a href="/now/" class="text-ink-900 no-underline hover:text-red-700 transition-colors">
                    {entry.data.title || entry.id}
                  </a>
                </h3>
                {index === 0 && entry.snippet && (
                  <p class="mt-3 mb-0 subtext max-w-[44ch]">
                    {entry.snippet}
                  </p>
                )}
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------------
      PROGRAM. Minimum repair in 32.6 (the old stack is retired, and no
      prices are published). Home's real rewrite is Phase 34.2.
     --------------------------------------------------------------------- */}
  <section class="section section-ruled" aria-labelledby="program-heading">
    <div class="shell">
      <div class="flex items-end justify-between gap-6">
        <h2 id="program-heading" class="kicker flex-1">The program</h2>
        <a href="/work-with-me/ai-resilient-organisation/" class="link-arrow shrink-0">All five tiers</a>
      </div>

      <p class="statement-sm mt-10 max-w-[22ch]">
        Getting lost in all the AI noise?
      </p>
      <p class="mt-4 mb-0 subtext max-w-[52ch]">
        AI-Resilient Organisation is a five-tier program for Philippine organisations whose people are already using AI tools: from an anonymous readiness survey to a hands-on agent sprint.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a href="/work-with-me/ai-resilient-organisation/" class="btn btn-primary">Explore the program →</a>
        <a href="/work-with-me/#enquire" class="link-arrow">Talk to me</a>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------------
      MANIFESTO. The bio, set as a statement.

      Phase 21 cut the word-by-word scroll brightening that ran here — it was
      Linear's "Designed in California" section almost line for line, and a
      reader who stopped scrolling was left with a half-lit sentence. Phase 28
      brought back a plainer whole-block version; Phase 31 removed motion
      entirely, so the statement is static.
     --------------------------------------------------------------------- */}
  {heroIntro && (
    <section class="section section-ruled" aria-labelledby="intro-heading">
      <div class="shell">
        <h2 id="intro-heading" class="kicker">Who I am</h2>
        <div class="statement mt-10 space-y-6">
          {heroIntro.split('\n\n').map((paragraph) => (
            <p class="m-0">
              {withInlineLinks(paragraph).map((seg) =>
                // Anchor kept on one line: Astro preserves whitespace from JSX
                // children, so a wrapped <a> would pad the link text with spaces.
                // prettier-ignore
                typeof seg === 'string' ? seg : <a href={seg.href} class="link" {...(seg.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{seg.label}</a>
              )}
            </p>
          ))}
        </div>
        <a href="/about/" class="link-arrow mt-10">The longer version</a>
      </div>
    </section>
  )}

  {/* ---------------------------------------------------------------------
      WRITING
     --------------------------------------------------------------------- */}
  {latestThoughts.length > 0 && (
    <section class="section-tight" aria-labelledby="writing-heading">
      <div class="shell">
        <div class="flex items-end justify-between gap-6">
          <h2 id="writing-heading" class="kicker flex-1">Thoughts</h2>
          <a href="/thoughts/" class="link-arrow shrink-0">All writing</a>
        </div>

        <p class="lead mt-6 max-w-[54ch]">
          I'm no writer, but I'm definitely a thinker — sometimes an overthinker.
          This is where I keep my fascinations and work out what I actually think.
        </p>

        <ul class="rows mt-10">
          {latestThoughts.map((post) => (
            <li>
              <a href={`/thoughts/${post.id}/`} class="row-link">
                <span class="min-w-0">
                  <span class="row-title block">{post.data.title}</span>
                  <span class="block mt-2 subtext max-w-[60ch]">
                    {post.data.excerpt}
                  </span>
                </span>
                <time class="row-meta" datetime={post.data.publishedDate}>
                  {post.data.publishedDate.slice(0, 4)}
                </time>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* ---------------------------------------------------------------------
      WHAT I DO.

      Phase 21: this was three numbered glass cards in a 3-up grid, which is
      the shape of a pricing table no matter what the cards say. It is now the
      same ruled list the writing and the projects use — three things I do,
      in one column, in the site's own index pattern.
     --------------------------------------------------------------------- */}
  {modes.length > 0 && (
    <section class="section section-ruled" aria-labelledby="services-heading">
      <div class="shell">
        <div class="flex items-end justify-between gap-6">
          <h2 id="services-heading" class="kicker flex-1">What I do</h2>
          <a href="/work-with-me/" class="link-arrow shrink-0">How we'd work together</a>
        </div>

        <p class="statement-sm mt-10 max-w-[24ch]">
          Interested in working together?
        </p>

        <ul class="rows mt-8">
          {modes.map((mode) => (
            <li>
              <div class="py-6 md:py-8">
                <h3 class="m-0">{mode.name}</h3>
                <p class="mt-3 mb-0 subtext max-w-[60ch]">
                  {mode.line}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* ---------------------------------------------------------------------
      PROJECTS. Hidden entirely when the shelf is empty — an empty section
      with a "nothing here yet" is worse than no section.
     --------------------------------------------------------------------- */}
  {latestProjects.length > 0 && (
    <section class="section-tight" aria-labelledby="projects-heading">
      <div class="shell">
        <div class="flex items-end justify-between gap-6">
          <h2 id="projects-heading" class="kicker flex-1">Projects</h2>
          <a href="/projects/" class="link-arrow shrink-0">All projects</a>
        </div>

        <ul class="rows mt-8">
          {latestProjects.map((project) => {
            const body = (
              <span class="min-w-0">
                <span class="row-title block">{project.data.title}</span>
                <span class="block mt-2 subtext max-w-[60ch]">
                  {project.data.description}
                </span>
              </span>
            );
            return (
              <li>
                {project.data.link ? (
                  <a
                    href={project.data.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="row-link"
                  >
                    {body}
                    <span class="row-meta" aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <div class="row-link">{body}</div>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  {/* ---------------------------------------------------------------------
      GALLERY.

      Phase 21: this was a full-bleed infinite marquee — which is the logo-wall
      pattern, borrowed and pointed at concert photographs. It is now a static
      contact sheet inside the page's own column: six frames, in colour, that
      hold still long enough to be looked at.
     --------------------------------------------------------------------- */}
  {stripShots.length > 0 && (
    <section class="section-tight" aria-labelledby="gallery-heading">
      <div class="shell">
        <div class="flex items-end justify-between gap-6">
          <h2 id="gallery-heading" class="kicker flex-1">I also shoot</h2>
          <a href="/gallery/" class="link-arrow shrink-0">
            All {photoCount} photographs
          </a>
        </div>
        <p class="statement-sm mt-10 max-w-[28ch]">
          From time to time, I want to use the right side of my brain.
        </p>

        <a
          href="/gallery/"
          class="mt-12 grid grid-cols-2 gap-2 no-underline sm:grid-cols-3 lg:grid-cols-6"
          aria-label="Browse the gallery"
        >
          {stripShots.slice(0, 6).map((shot) => (
            <Image
              src={shot.image}
              alt={shot.caption}
              widths={[440]}
              sizes="(min-width: 64rem) 14rem, (min-width: 40rem) 30vw, 45vw"
              loading="lazy"
              class="photo-sheet__frame"
            />
          ))}
        </a>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* ---- Hero ------------------------------------------------------------ */
  /* Phase 21 dropped two things here.
   *
   * The 88svh min-height: a hero sized to the viewport is a landing page
   * holding the fold. Without it the page opens as a document — the name, the
   * sentence, and the start of the next section, all at once.
   *
   * .hero__glow: a pink radial bloom behind the headline. An ambient coloured
   * gradient is the most legible "AI-generated" tell on a page, and it was
   * doing nothing a reader would miss. */
  .hero {
    padding-block: clamp(3rem, 2rem + 6vw, 6rem) clamp(3rem, 2rem + 4vw, 5rem);
  }
  /* ---- Statements ------------------------------------------------------ */
  /* The bio statement. Bigger than prose, smaller than display — it has to hold 60+
   * words without turning into a wall, so it runs a touch smaller and a good
   * deal wider than the hero statement. */
  .statement {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.05rem + 1.1vw, 1.9rem);
    font-weight: 500;
    line-height: 1.32;
    letter-spacing: -0.02em;
    max-width: 46ch;
    margin: 0;
    text-wrap: pretty;
  }
  /* ---- Contact sheet ---------------------------------------------------
   * Square-cropped, square-cornered, and in colour at rest. The old strip
   * desaturated every frame and gave the colour back on hover, which is a
   * gallery holding its own content hostage to an interaction. */
  .photo-sheet__frame {
    aspect-ratio: 1;
    width: 100%;
    height: auto;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity 0.3s var(--ease-out-quint);
  }
  .photo-sheet__frame:hover { opacity: 1; }
</style>
