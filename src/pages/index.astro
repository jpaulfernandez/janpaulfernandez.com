---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { person, webSite, profilePage, breadcrumbs } from '../lib/schema';
import { getPublishedThoughts } from '../lib/thoughts';
import { getProjects } from '../lib/projects';

// Fetch Keystatic Home singleton
const homeEntry = await getEntry('home', 'home');
if (!homeEntry) {
  throw new Error('Home page singleton is missing. Run the seed scripts first.');
}
const { heroGreeting, heroIntro } = homeEntry.data;

// Display hero: the greeting's last word carries the wine flare, so the accent
// tracks whatever Paul writes in Keystatic instead of being hardcoded here.
const greetingWords = heroGreeting.trim().split(' ');
const greetingHead = greetingWords.slice(0, -1).join(' ');
const greetingFlare = greetingWords[greetingWords.length - 1];

// Latest Now entry -> one tight line under the intro.
const nowEntries = await getCollection('now');
const latestNow = nowEntries.sort((a, b) => b.data.date.localeCompare(a.data.date))[0];
const nowPlain = latestNow?.body
  ?.replace(/\[([^\]]+)\]\([^)]*\)/g, '$1') // markdown links -> text
  .replace(/[*_`>#]/g, '')
  .replace(/\s+/g, ' ')
  .trim();
const nowSnippet = nowPlain
  ? nowPlain.length > 92
    ? `${nowPlain.slice(0, 92).trimEnd()}…`
    : nowPlain
  : undefined;

// Latest thoughts for the Writing index (5 rows).
const latestThoughts = (await getPublishedThoughts()).slice(0, 5);

// Latest projects for the Projects index (3 rows).
const latestProjects = (await getProjects()).slice(0, 3);

const seoData = [
  webSite(),
  profilePage(),
  person(),
  breadcrumbs([{ name: 'Home', url: '/' }]),
];
---

<BaseLayout
  title="Paul Fernandez"
  description="Technologist from the Philippines who ships under pressure — banking, election-night newsrooms, national-scale education — now helping teams adopt AI and ship the right thing."
  isHome
>
  <JsonLd data={seoData} slot="head" />

  <article>
    {/* Identity: display statement → bio → optional now one-liner. */}
    <header>
      <h1 class="display m-0">
        {greetingHead && <>{greetingHead}{' '}</>}<span class="flare">{greetingFlare}</span>
      </h1>
      {heroIntro && (
        <p class="mt-8 mb-0 text-ink-700 text-body leading-relaxed max-w-prose">{heroIntro}</p>
      )}
      {nowSnippet && (
        <p class="mt-6 mb-0 text-ink-500 text-small">
          <span class="text-wine-500">now</span> — {nowSnippet}{' '}
          <a href="/now" class="text-ink-700 hover:text-wine-500 no-underline">→</a>
        </p>
      )}
    </header>

    {/* Writing index */}
    {latestThoughts.length > 0 && (
      <section class="mt-20 md:mt-24" aria-labelledby="writing-heading">
        <h2 id="writing-heading" class="kicker">writing</h2>
        <ul class="rows mt-6">
          {latestThoughts.map((post) => (
            <li>
              <a href={`/thoughts/${post.id}`} class="row-link">
                <span class="font-bold">{post.data.title}</span>
                <time class="row-meta" datetime={post.data.publishedDate}>
                  {post.data.publishedDate.slice(0, 4)}
                </time>
              </a>
            </li>
          ))}
        </ul>
        <a
          href="/thoughts"
          class="inline-block mt-6 text-small text-ink-500 hover:text-wine-500 no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500"
        >
          all thoughts →
        </a>
      </section>
    )}

    {/* Projects index */}
    {latestProjects.length > 0 && (
      <section class="mt-16 md:mt-20" aria-labelledby="projects-heading">
        <h2 id="projects-heading" class="kicker">projects</h2>
        <ul class="rows mt-6">
          {latestProjects.map((project) => (
            <li>
              {project.data.link ? (
                <a href={project.data.link} target="_blank" rel="noopener noreferrer" class="row-link">
                  <span>
                    <span class="font-bold">{project.data.title}</span>
                    <span class="block mt-1 text-ink-500 text-small">{project.data.description}</span>
                  </span>
                  <span class="row-meta" aria-hidden="true">↗</span>
                </a>
              ) : (
                <div class="row-link">
                  <span>
                    <span class="font-bold">{project.data.title}</span>
                    <span class="block mt-1 text-ink-500 text-small">{project.data.description}</span>
                  </span>
                </div>
              )}
            </li>
          ))}
        </ul>
        <a
          href="/projects"
          class="inline-block mt-6 text-small text-ink-500 hover:text-wine-500 no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500"
        >
          all projects →
        </a>
      </section>
    )}

    {/* Work — the one CTA on the page, so it gets the wine block treatment. */}
    <section class="mt-16 md:mt-20" aria-labelledby="work-heading">
      <h2 id="work-heading" class="kicker">work</h2>
      <p class="mt-6 mb-0 text-ink-900 text-h3 font-bold leading-snug max-w-prose">
        Consultation, workshops, and <span class="flare">fractional product ownership</span>.
      </p>
      <a
        href="/work-with-me"
        class="inline-block mt-6 px-6 py-3 bg-wine-500 text-paper-50 no-underline hover:bg-wine-400 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-ink-900 focus-visible:ring-offset-2"
      >
        work with me →
      </a>
    </section>
  </article>
</BaseLayout>
