---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { person, webSite, profilePage, breadcrumbs } from '../lib/schema';
import { getPublishedThoughts } from '../lib/thoughts';
import { getProjects } from '../lib/projects';

// Fetch Keystatic Home singleton
const homeEntry = await getEntry('home', 'home');
if (!homeEntry) {
  throw new Error('Home page singleton is missing. Run the seed scripts first.');
}
const { heroGreeting, heroIntro } = homeEntry.data;

// Latest Now entry -> one tight line under the intro.
const nowEntries = await getCollection('now');
const latestNow = nowEntries.sort((a, b) => b.data.date.localeCompare(a.data.date))[0];
const nowPlain = latestNow?.body
  ?.replace(/\[([^\]]+)\]\([^)]*\)/g, '$1') // markdown links -> text
  .replace(/[*_`>#]/g, '')
  .replace(/\s+/g, ' ')
  .trim();
const nowSnippet = nowPlain
  ? nowPlain.length > 92
    ? `${nowPlain.slice(0, 92).trimEnd()}…`
    : nowPlain
  : undefined;

// Latest thoughts for the Writing index (5 rows).
const latestThoughts = (await getPublishedThoughts()).slice(0, 5);

// Latest projects for the Projects index (3 rows).
const latestProjects = (await getProjects()).slice(0, 3);

const seoData = [
  webSite(),
  profilePage(),
  person(),
  breadcrumbs([{ name: 'Home', url: '/' }]),
];
---

<BaseLayout
  title="Paul Fernandez"
  description="Technologist from the Philippines who ships under pressure — banking, election-night newsrooms, national-scale education — now helping teams adopt AI and ship the right thing."
  isHome
>
  <JsonLd data={seoData} slot="head" />

  <article>
    {/* Identity: greeting → bio → optional now one-liner. */}
    <header>
      <h1 class="text-moss-900 m-0">{heroGreeting}</h1>
      {heroIntro && (
        <p class="mt-6 mb-0 text-moss-700 text-body leading-relaxed">{heroIntro}</p>
      )}
      {nowSnippet && (
        <p class="mt-4 mb-0 text-moss-500 text-small">
          now — {nowSnippet} <a href="/now" class="text-moss-700 hover:text-moss-900 underline underline-offset-4 decoration-moss-200 hover:decoration-moss-900">→</a>
        </p>
      )}
    </header>

    {/* Writing index */}
    {latestThoughts.length > 0 && (
      <section class="mt-16 md:mt-20" aria-labelledby="writing-heading">
        <h2 id="writing-heading" class="font-mono uppercase text-xs tracking-widest text-moss-500 m-0 mb-4">writing</h2>
        <ul class="list-none m-0 p-0 flex flex-col">
          {latestThoughts.map((post) => (
            <li class="py-2 flex items-baseline justify-between gap-4">
              <a
                href={`/thoughts/${post.id}`}
                class="text-moss-900 hover:text-citrus-500 no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-citrus-500 rounded-sm"
              >
                {post.data.title}
              </a>
              <time class="text-moss-500 text-small whitespace-nowrap tabular-nums" datetime={post.data.publishedDate}>
                {post.data.publishedDate.slice(0, 4)}
              </time>
            </li>
          ))}
        </ul>
        <a
          href="/thoughts"
          class="inline-block mt-3 text-small text-moss-500 hover:text-moss-900 no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-citrus-500 rounded-sm"
        >
          all thoughts →
        </a>
      </section>
    )}

    {/* Projects index */}
    {latestProjects.length > 0 && (
      <section class="mt-14 md:mt-16" aria-labelledby="projects-heading">
        <h2 id="projects-heading" class="font-mono uppercase text-xs tracking-widest text-moss-500 m-0 mb-4">projects</h2>
        <ul class="list-none m-0 p-0 flex flex-col">
          {latestProjects.map((project) => (
            <li class="py-2 flex flex-col sm:flex-row sm:items-baseline sm:gap-4">
              {project.data.link ? (
                <a
                  href={project.data.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-moss-900 hover:text-citrus-500 no-underline whitespace-nowrap focus:outline-none focus-visible:ring-2 focus-visible:ring-citrus-500 rounded-sm"
                >
                  {project.data.title}&nbsp;↗
                </a>
              ) : (
                <span class="text-moss-900">{project.data.title}</span>
              )}
              <span class="text-moss-700 text-body">{project.data.description}</span>
            </li>
          ))}
        </ul>
        <a
          href="/projects"
          class="inline-block mt-3 text-small text-moss-500 hover:text-moss-900 no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-citrus-500 rounded-sm"
        >
          all projects →
        </a>
      </section>
    )}

    {/* Work */}
    <section class="mt-14 md:mt-16" aria-labelledby="work-heading">
      <h2 id="work-heading" class="font-mono uppercase text-xs tracking-widest text-moss-500 m-0 mb-4">work</h2>
      <p class="m-0 text-moss-700 text-body leading-relaxed">
        Consultation, workshops, and fractional product ownership.
      </p>
      <a
        href="/work-with-me"
        class="inline-block mt-3 text-small text-moss-500 hover:text-moss-900 no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-citrus-500 rounded-sm"
      >
        work with me →
      </a>
    </section>
  </article>
</BaseLayout>
