---
// index.astro — rebuild-plan §5.1, task 34.2. Home is a router: what Paul
// does for people, then the ways in, the proof, and the way out to a call.
// Zero client JS (README rule 7): no <script>, no data-* motion attributes.
//
// Section rhythm (a rule marks a turn in the argument, CLAUDE.md):
//
// | # | Section            | Class                   | Why                                          |
// |---|--------------------|-------------------------|----------------------------------------------|
// | 1 | Hero               | .hero (no rule)         | opens the page                               |
// | 2 | Three ways to work | .section-tight          | continues the hero's argument: what I do     |
// | 3 | Program band       | .section.section-ruled  | new argument: the packaged offer; the page's |
// |   |                    |                         | only .panel-tint                             |
// | 4 | Recent projects    | .section.section-ruled  | new argument: proof                          |
// | 5 | Latest thoughts    | .section-tight          | continues the proof: the thinking behind it  |
// | 6 | Now, briefly       | .section-tight          | continues it: what is live this month        |
// | 7 | Closing CTA        | .section.section-ruled  | the turn to action                           |
//
// Red fills: the header's "Book a scoping call" is the one above the fold, so
// the hero's primary action is a hairline .btn (rebuild-plan §3.1 over §5.1;
// Paul to confirm). The closing CTA's .btn-primary is the only one in <main>.
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import PostListItem from '../components/PostListItem.astro';
import ProgramSteps from '../components/ProgramSteps.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { person, webSite, breadcrumbs } from '../lib/schema';
import { getPublishedThoughts } from '../lib/thoughts';
import { getProjects, recentProjects } from '../lib/projects';
import { formatDate } from '../lib/dates';

const homeEntry = await getEntry('home', 'home');
const workWithMe = await getEntry('workWithMe', 'workWithMe');
const programPage = await getEntry('programPage', 'program');
if (!homeEntry || !workWithMe || !programPage) {
  throw new Error('home, workWithMe or programPage singleton is missing.');
}
const { heroStatement, heroWho } = homeEntry.data;
const { modes } = workWithMe.data;
const program = programPage.data;

const PROGRAM_URL = '/work-with-me/ai-resilient-organisation/';
const EMAIL = 'jpaul.fernandez18@gmail.com';

const projects = recentProjects(await getProjects(), 3);

const thoughts = (await getPublishedThoughts()).slice(0, 3).map((post) => {
  const words = post.body ? post.body.split(/\s+/).filter(Boolean).length : 0;
  return { post, readingTime: Math.max(1, Math.ceil(words / 200)) };
});

const nowEntries = [...(await getCollection('now'))]
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3);

// No ProfilePage here — this page is a hub, not a profile. That node lives on
// /about/ (Phase 30 A1); emitting it from both pages made two documents claim
// to be the ProfilePage for the same person.
const seoData = [
  webSite(),
  person(),
  breadcrumbs([{ name: 'Home', url: '/' }]),
];
---

<BaseLayout
  title="Paul Fernandez"
  description="Paul Fernandez helps Philippine organisations decide what to build with AI, then builds it with them or for them. Consulting, building and advising from Manila."
  isHome
>
  <JsonLd data={seoData} slot="head" />

  {/* 1 — Hero. Opens the page; no rule. */}
  <section class="hero">
    <div class="shell">
      <div class="hero-text">
        <h1 class="display hero-statement">{heroStatement}</h1>
        <p class="subtext mt-8 mb-0 max-w-[52ch]">{heroWho}</p>
        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a href="/work-with-me/" class="btn btn-ghost">Work with me</a>
          <a href={PROGRAM_URL} class="link">See the program</a>
        </div>
      </div>
    </div>
  </section>

  {/* 2 — Three ways to work. Continues the hero; Work with me owns the copy. */}
  {modes.length > 0 && (
    <section class="section-tight" aria-labelledby="ways-heading">
      <div class="shell">
        <h2 id="ways-heading" class="kicker">Three ways to work</h2>
        <ul class="rows mt-6">
          {modes.map((mode) => (
            <li>
              <a href={`/work-with-me/#${mode.anchor}`} class="row-link">
                <span class="min-w-0">
                  <span class="row-title block font-medium">{mode.name}</span>
                  <span class="subtext block mt-2 max-w-[60ch]">{mode.line}</span>
                </span>
                <span class="row-meta" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* 3 — Program band. A new argument; the page's only tinted block. */}
  <section class="section section-ruled" aria-labelledby="program-heading">
    <div class="shell">
      <div class="panel-tint program-band">
        <p class="kicker">Program</p>
        <h2 id="program-heading" class="statement-sm mt-8 max-w-[24ch]">{program.headline}</h2>
        <p class="subtext mt-6 mb-0 max-w-[60ch]">{program.sub}</p>
        <div class="mt-10">
          <ProgramSteps steps={program.steps} />
        </div>
        <p class="mt-10 mb-0">
          <a href={PROGRAM_URL} class="link">See the program</a>
        </p>
      </div>
    </div>
  </section>

  {/* 4 — Recent projects. A new argument: proof. Featured first, then newest. */}
  {projects.length > 0 && (
    <section class="section section-ruled" aria-labelledby="projects-heading">
      <div class="shell">
        <div class="flex items-end justify-between gap-6">
          <h2 id="projects-heading" class="kicker flex-1">Projects</h2>
          <a href="/projects/" class="link-arrow shrink-0">All projects</a>
        </div>
        <ul class="rows mt-6">
          {projects.map((project) => <ProjectRow project={project} />)}
        </ul>
      </div>
    </section>
  )}

  {/* 5 — Latest thoughts. Continues the proof. */}
  {thoughts.length > 0 && (
    <section class="section-tight" aria-labelledby="thoughts-heading">
      <div class="shell">
        <div class="flex items-end justify-between gap-6">
          <h2 id="thoughts-heading" class="kicker flex-1">Thoughts</h2>
          <a href="/thoughts/" class="link-arrow shrink-0">All thoughts</a>
        </div>
        <ul class="rows mt-2">
          {thoughts.map(({ post, readingTime }) => (
            <li>
              <PostListItem
                title={post.data.title}
                type={post.data.type}
                topics={post.data.topics || []}
                date={post.data.publishedDate}
                excerpt={post.data.excerpt}
                url={`/thoughts/${post.id}/`}
                readingTime={readingTime}
                stage={post.data.stage}
                cover={post.data.cover}
              />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* 6 — Now, briefly. Continues it: what is live this month. No snippet, no
      dot — the dot belongs to the Now page. */}
  {nowEntries.length > 0 && (
    <section class="section-tight" aria-labelledby="now-heading">
      <div class="shell now-brief">
        <div class="flex items-end justify-between gap-6 md:flex-col md:items-start md:justify-start md:gap-4">
          <h2 id="now-heading" class="kicker now-kicker">Now</h2>
          <a href="/now/" class="link-arrow shrink-0">Full timeline</a>
        </div>
        <ul class="rows now-list">
          {nowEntries.map((entry) => (
            <li class="now-row">
              <time class="mono-micro" datetime={entry.data.date}>{formatDate(entry.data.date)}</time>
              <a href="/now/" class="now-title">{entry.data.title || entry.id}</a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* 7 — Closing CTA. The turn to action; the only red fill in <main>. */}
  <section class="section section-ruled" aria-labelledby="cta-heading">
    <div class="shell">
      <h2 id="cta-heading" class="statement-sm max-w-[22ch]">
        Not sure which of these you need? That's what the first call is for.
      </h2>
      <p class="subtext mt-6 mb-0">
        Or email me: <a href={`mailto:${EMAIL}`} class="link">{EMAIL}</a>
      </p>
      <div class="mt-10">
        <a href="/work-with-me/#enquire" class="btn btn-primary">Book a scoping call</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* No viewport-height hero: the page opens as a document, with the start of
   * the next section in view. */
  .hero {
    padding-block: clamp(3rem, 2rem + 6vw, 6rem) var(--space-xl);
  }
  /* A sentence, not a slogan: one step below the display ladder's top so
   * seventeen words stay four or five lines on a laptop. */
  .hero-statement {
    font-size: var(--text-h1);
    line-height: 1.05;
    max-width: 20ch;
  }

  .program-band { padding: var(--space-l); }

  /* Now, briefly: label left, list right from md up. */
  .now-brief { display: grid; gap: 1.5rem 3rem; }
  .now-kicker::after { display: none; }
  .now-row {
    display: grid;
    gap: 0.25rem 1.5rem;
    padding-block: var(--space-s);
  }
  .now-row:first-child { border-top: 1px solid var(--line); }
  .now-title {
    color: var(--color-ink-900);
    font-weight: 500;
    text-decoration: none;
  }
  .now-title:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  @media (min-width: 48rem) {
    .now-brief { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); }
    .now-row { grid-template-columns: 8rem minmax(0, 1fr); align-items: baseline; }
  }
</style>
