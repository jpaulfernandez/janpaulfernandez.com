---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { person, webSite, profilePage, breadcrumbs } from '../lib/schema';
import { getPublishedThoughts } from '../lib/thoughts';
import { getProjects } from '../lib/projects';
import { formatDate } from '../lib/dates';
import { availability } from '../lib/workshops';

const homeEntry = await getEntry('home', 'home');
if (!homeEntry) {
  throw new Error('Home page singleton is missing. Run the seed scripts first.');
}
const { heroGreeting, heroIntro } = homeEntry.data;

function cleanSnippet(raw?: string, max = 160) {
  if (!raw) return '';
  const text = raw
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/[*_`>#]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  if (text.length <= max) return text;
  const sub = text.slice(0, max);
  const lastPeriod = Math.max(sub.lastIndexOf('.'), sub.lastIndexOf('!'), sub.lastIndexOf('?'));
  if (lastPeriod > 60) {
    return sub.slice(0, lastPeriod + 1);
  }
  const lastSpace = sub.lastIndexOf(' ');
  return `${sub.slice(0, lastSpace > 0 ? lastSpace : max).trimEnd()}…`;
}

// The bio is a Keystatic plain-text field, but it carries a couple of markdown
// links. Split each paragraph into plain strings and { label, href } links so
// the statement can render them as real anchors without a markdown pipeline.
function withInlineLinks(text: string) {
  const parts: Array<string | { label: string; href: string }> = [];
  const re = /\[([^\]]+)\]\(([^)]+)\)/g;
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = re.exec(text))) {
    if (m.index > last) parts.push(text.slice(last, m.index));
    parts.push({ label: m[1], href: m[2] });
    last = m.index + m[0].length;
  }
  if (last < text.length) parts.push(text.slice(last));
  return parts;
}

const latestNowEntries = [...(await getCollection('now'))]
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3)
  .map((entry, index) => ({
    ...entry,
    snippet: index === 0 ? cleanSnippet(entry.body) : undefined,
  }));

const latestThoughts = (await getPublishedThoughts()).slice(0, 4);
const latestProjects = (await getProjects()).slice(0, 3);

const services = (await getCollection('services')).sort(
  (a, b) => a.data.order - b.data.order
);

// A contact sheet for the gallery teaser. Frames are interleaved across sets
// so the row never shows the same concert twice in a row.
const gallerySets = (await getCollection('gallery')).sort(
  (a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime()
);
const stripShots = gallerySets
  .flatMap((set, setIndex) =>
    set.data.photos.slice(1, 4).map((photo, i) => ({
      image: photo.image as unknown as ImageMetadata,
      caption: photo.caption || set.data.title,
      setTitle: set.data.title,
      // Interleave: order by frame position first, set second.
      order: i * 10 + setIndex,
    }))
  )
  .sort((a, b) => a.order - b.order);

const photoCount = gallerySets.reduce((n, set) => n + set.data.photos.length, 0);

const seoData = [
  webSite(),
  profilePage(),
  person(),
  breadcrumbs([{ name: 'Home', url: '/' }]),
];
---

<BaseLayout
  title="Paul Fernandez"
  description="Technologist from the Philippines. Shipped banking systems, ran election results at Rappler, and now build for higher ed. I help teams figure out what to build."
  isHome
>
  <JsonLd data={seoData} slot="head" />

  {/* ---------------------------------------------------------------------
      HERO. The only [data-hero] on the site: its children animate on load
      rather than on scroll, because they are already in view.
     --------------------------------------------------------------------- */}
  <section class="hero" data-hero>
    <div class="shell">
      <div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16 lg:items-start">
        <div>
          <p class="mono-micro flex items-center gap-3" data-reveal="fade">
            <span class="h-px w-8 bg-[var(--line-strong)]"></span>
            Technologist · Philippines
          </p>

          <h1 class="display mt-8 max-w-[16ch]" data-reveal="up" data-reveal-delay="0.05">
            {heroGreeting}
          </h1>

          <p class="lead mt-8 max-w-[46ch]" data-reveal="up" data-reveal-delay="0.12">
            I help teams figure out what to build. Most of that work turns out to be
            getting everyone to agree on what the words mean.
          </p>

          {/* Hero actions: Featured workshop CTA distinction */}
          <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3" data-reveal="up" data-reveal-delay="0.18">
            <a href="/workshops/" class="btn btn-primary">See the AI Workshop →</a>
            <a href="/thoughts/" class="link-arrow">Read the writing</a>
            <a href="/work-with-me/" class="link-arrow">Work with me</a>
          </div>
        </div>

        <div class="mt-6 lg:mt-0" data-reveal="fade" data-reveal-delay="0.1">
          <div class="flex items-end justify-between gap-6 border-b border-[var(--line)] pb-4 mb-8">
            <h2 id="hero-now-heading" class="kicker m-0">Now</h2>
            <a href="/now/" class="link-arrow shrink-0">Full timeline</a>
          </div>

          <div class="rail rail-compact" data-reveal-stagger>
            {latestNowEntries.map((entry, index) => (
              <article class="rail-item" data-reveal="up">
                <time class="rail-date" datetime={entry.data.date}>
                  {formatDate(entry.data.date)}
                </time>
                <h3 class="m-0">
                  <a href="/now/" class="hover:text-wine-400 transition-colors">
                    {entry.data.title || entry.id}
                  </a>
                </h3>
                {index === 0 && entry.snippet && (
                  <p class="mt-3 mb-0 text-small text-paper-400 leading-relaxed max-w-[44ch]">
                    {entry.snippet}
                  </p>
                )}
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------------
      WORKSHOPS. Featured offering highlighted directly under the hero.
      Two-audience hairline split: for you & business owners, or your org.
     --------------------------------------------------------------------- */}
  <section class="section-tight border-t border-[var(--line)]" aria-labelledby="workshops-heading">
    <div class="shell">
      <div class="flex items-end justify-between gap-6">
        <h2 id="workshops-heading" class="kicker flex-1">Featured workshop</h2>
        <a href="/workshops/" class="link-arrow shrink-0">All sessions &amp; pricing</a>
      </div>

      <div class="mt-10 grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
        <div>
          <p class="statement-sm max-w-[22ch]" data-reveal="up">
            Getting lost in all the AI noise?
          </p>
          <p class="mt-4 mb-0 text-small text-paper-400 leading-relaxed max-w-[48ch]" data-reveal="up">
            A workshop that puts you to work on your own real tasks with AI — one-on-one, in a small group, or with your whole team.
          </p>
        </div>
        <div class="border-t border-[var(--line)] pt-6 lg:border-t-0 lg:pt-0" data-reveal="up">
          <p class="mono-micro text-paper-400">Open schedule</p>
          <p class="mt-2 text-small text-paper-100 font-medium">{availability.window}</p>
          <p class="mt-1 mb-0 text-small text-paper-400 leading-relaxed max-w-[44ch]">
            {availability.note}
          </p>
        </div>
      </div>

      {/* Scannable dual-track cards with hairline border */}
      <div class="mt-12 grid gap-8 md:grid-cols-2" data-reveal-stagger>
        <div class="card pt-6 flex flex-col justify-between" data-reveal="up">
          <div>
            <div class="flex items-center justify-between gap-4 mb-4">
              <span class="mono-micro">01 · For you &amp; business owners</span>
              <span class="mono text-small text-paper-400">From ₱2,500</span>
            </div>
            <h3 class="text-h3 m-0">Personal</h3>
            <p class="mt-3 text-small text-paper-400 leading-relaxed">
              1-on-1 or a small group you bring — an interactive workshop on the work you actually do.
            </p>
            <ul class="mt-6 space-y-2 border-t border-[var(--line)] pt-4 text-small text-paper-300 list-none p-0">
              <li class="flex items-center gap-2">
                <span class="text-paper-600">↳</span> Understand how AI works, and how to spot fakes online
              </li>
              <li class="flex items-center gap-2">
                <span class="text-paper-600">↳</span> Explore where AI realistically fits in your business
              </li>
              <li class="flex items-center gap-2">
                <span class="text-paper-600">↳</span> Vibe coding &amp; web basics — build your own idea, shipped live
              </li>
            </ul>
          </div>
        </div>

        <div class="card pt-6 flex flex-col justify-between" data-reveal="up">
          <div>
            <div class="flex items-center justify-between gap-4 mb-4">
              <span class="mono-micro">02 · For your organisation</span>
              <span class="mono text-small text-paper-400">Message to quote</span>
            </div>
            <h3 class="text-h3 m-0">Enterprise / Org</h3>
            <p class="mt-3 text-small text-paper-400 leading-relaxed">
              Your people are already using AI tools. Where's the line, and how do you keep the company safe from misuse?
            </p>
            <ul class="mt-6 space-y-2 border-t border-[var(--line)] pt-4 text-small text-paper-300 list-none p-0">
              <li class="flex items-center gap-2">
                <span class="text-paper-600">↳</span> Leadership AI training + the policy-making exercise
              </li>
              <li class="flex items-center gap-2">
                <span class="text-paper-600">↳</span> AI fluency for the whole team, to one standard
              </li>
              <li class="flex items-center gap-2">
                <span class="text-paper-600">↳</span> Something specific to a department, or a speaker slot
              </li>
            </ul>
          </div>
        </div>
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4" data-reveal="up">
        <a href="/workshops/" class="btn btn-primary">Explore the AI workshop →</a>
        <a href="/workshops/#enquire" class="link-arrow">Talk to me</a>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------------
      MANIFESTO. The bio, set as a statement.

      Phase 21 cut the word-by-word scroll brightening that ran here — it was
      Linear's "Designed in California" section almost line for line, and a
      reader who stopped scrolling was left with a half-lit sentence. Phase 28
      brought back a plainer version at Paul's request: [data-brighten] scrubs
      the whole block, not word by word, and from a legible grey rather than
      near-invisible, so stopping anywhere still leaves it readable.
     --------------------------------------------------------------------- */}
  {heroIntro && (
    <section class="section-tight border-t border-[var(--line)]" aria-labelledby="intro-heading">
      <div class="shell">
        <h2 id="intro-heading" class="kicker">Who I am</h2>
        <div class="statement mt-10 space-y-6" data-brighten>
          {heroIntro.split('\n\n').map((paragraph) => (
            <p class="m-0">
              {withInlineLinks(paragraph).map((seg) =>
                // Anchor kept on one line: Astro preserves whitespace from JSX
                // children, so a wrapped <a> would pad the link text with spaces.
                // prettier-ignore
                typeof seg === 'string' ? seg : <a href={seg.href} class="link" {...(seg.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{seg.label}</a>
              )}
            </p>
          ))}
        </div>
        <a href="/about/" class="link-arrow mt-10">The longer version</a>
      </div>
    </section>
  )}

  {/* ---------------------------------------------------------------------
      WRITING
     --------------------------------------------------------------------- */}
  {latestThoughts.length > 0 && (
    <section class="section-tight border-t border-[var(--line)]" aria-labelledby="writing-heading">
      <div class="shell">
        <div class="flex items-end justify-between gap-6">
          <h2 id="writing-heading" class="kicker flex-1">Thoughts</h2>
          <a href="/thoughts/" class="link-arrow shrink-0">All writing</a>
        </div>

        <p class="statement-sm mt-10 max-w-[36ch]" data-reveal="up">
          I'm no writer, but I'm definitely a thinker — sometimes an overthinker.
          This is where I keep my fascinations and work out what I actually think.
        </p>

        <ul class="rows mt-8" data-reveal-stagger>
          {latestThoughts.map((post) => (
            <li data-reveal="up">
              <a href={`/thoughts/${post.id}/`} class="row-link">
                <span class="min-w-0">
                  <span class="row-title block">{post.data.title}</span>
                  <span class="block mt-2 text-small text-paper-400 max-w-[60ch]">
                    {post.data.excerpt}
                  </span>
                </span>
                <time class="row-meta" datetime={post.data.publishedDate}>
                  {post.data.publishedDate.slice(0, 4)}
                </time>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* ---------------------------------------------------------------------
      WHAT I DO.

      Phase 21: this was three numbered glass cards in a 3-up grid, which is
      the shape of a pricing table no matter what the cards say. It is now the
      same ruled list the writing and the projects use — three things I do,
      in one column, in the site's own index pattern.
     --------------------------------------------------------------------- */}
  {services.length > 0 && (
    <section class="section-tight border-t border-[var(--line)]" aria-labelledby="services-heading">
      <div class="shell">
        <div class="flex items-end justify-between gap-6">
          <h2 id="services-heading" class="kicker flex-1">What I do</h2>
          <a href="/work-with-me/" class="link-arrow shrink-0">How we'd work together</a>
        </div>

        <p class="statement-sm mt-10 max-w-[24ch]" data-reveal="up">
          Interested in working together?
        </p>

        <ul class="rows mt-8" data-reveal-stagger>
          {services.map((service) => (
            <li data-reveal="up">
              <div class="py-6 md:py-8">
                <h3 class="m-0">{service.data.title}</h3>
                <p class="mt-3 mb-0 text-small text-paper-400 leading-relaxed max-w-[60ch]">
                  {service.data.description}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* ---------------------------------------------------------------------
      PROJECTS. Hidden entirely when the shelf is empty — an empty section
      with a "nothing here yet" is worse than no section.
     --------------------------------------------------------------------- */}
  {latestProjects.length > 0 && (
    <section class="section-tight border-t border-[var(--line)]" aria-labelledby="projects-heading">
      <div class="shell">
        <div class="flex items-end justify-between gap-6">
          <h2 id="projects-heading" class="kicker flex-1">Projects</h2>
          <a href="/projects/" class="link-arrow shrink-0">All projects</a>
        </div>

        <ul class="rows mt-8" data-reveal-stagger>
          {latestProjects.map((project) => {
            const body = (
              <span class="min-w-0">
                <span class="row-title block">{project.data.title}</span>
                <span class="block mt-2 text-small text-paper-400 max-w-[60ch]">
                  {project.data.description}
                </span>
              </span>
            );
            return (
              <li data-reveal="up">
                {project.data.link ? (
                  <a
                    href={project.data.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="row-link"
                  >
                    {body}
                    <span class="row-meta" aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <div class="row-link">{body}</div>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  {/* ---------------------------------------------------------------------
      GALLERY.

      Phase 21: this was a full-bleed infinite marquee — which is the logo-wall
      pattern, borrowed and pointed at concert photographs. It is now a static
      contact sheet inside the page's own column: six frames, in colour, that
      hold still long enough to be looked at.
     --------------------------------------------------------------------- */}
  {stripShots.length > 0 && (
    <section class="section-tight border-t border-[var(--line)]" aria-labelledby="gallery-heading">
      <div class="shell">
        <div class="flex items-end justify-between gap-6">
          <h2 id="gallery-heading" class="kicker flex-1">I also shoot</h2>
          <a href="/gallery/" class="link-arrow shrink-0">
            All {photoCount} photographs
          </a>
        </div>
        <p class="statement-sm mt-10 max-w-[28ch]" data-reveal="up">
          From time to time, I want to use the right side of my brain.
        </p>

        <a
          href="/gallery/"
          class="mt-12 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6"
          aria-label="Browse the gallery"
          data-reveal-stagger
        >
          {stripShots.slice(0, 6).map((shot) => (
            <Image
              src={shot.image}
              alt={shot.caption}
              widths={[440]}
              sizes="(min-width: 64rem) 14rem, (min-width: 40rem) 30vw, 45vw"
              loading="lazy"
              class="photo-sheet__frame"
              data-reveal="fade"
            />
          ))}
        </a>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* ---- Hero ------------------------------------------------------------ */
  /* Phase 21 dropped two things here.
   *
   * The 88svh min-height: a hero sized to the viewport is a landing page
   * holding the fold. Without it the page opens as a document — the name, the
   * sentence, and the start of the next section, all at once.
   *
   * .hero__glow: a pink radial bloom behind the headline. An ambient coloured
   * gradient is the most legible "AI-generated" tell on a page, and it was
   * doing nothing a reader would miss. */
  .hero {
    padding-block: clamp(3rem, 2rem + 6vw, 6rem) clamp(3rem, 2rem + 4vw, 5rem);
  }
  /* ---- Statements ------------------------------------------------------ */
  /* The scroll-brightened paragraph ([data-brighten], resting grey set in
   * global.css). Bigger than prose, smaller than display — it has to hold 60+
   * words without turning into a wall, so it runs a touch smaller and a good
   * deal wider than the hero statement. */
  .statement {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.05rem + 1.1vw, 1.9rem);
    font-weight: 500;
    line-height: 1.32;
    letter-spacing: -0.025em;
    max-width: 46ch;
    margin: 0;
    text-wrap: pretty;
  }
  /* ---- Contact sheet ---------------------------------------------------
   * Square-cropped, square-cornered, and in colour at rest. The old strip
   * desaturated every frame and gave the colour back on hover, which is a
   * gallery holding its own content hostage to an interaction. */
  .photo-sheet__frame {
    aspect-ratio: 1;
    width: 100%;
    height: auto;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity 0.3s var(--ease-out-quint);
  }
  .photo-sheet__frame:hover { opacity: 1; }
</style>
