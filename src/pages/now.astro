---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { profilePage, breadcrumbs } from '../lib/schema';
import { parseDateSafe, formatDateLong } from '../lib/dates';

const nowEntries = await getCollection('now');

// Sort reverse-chronologically (newest first)
const sortedNow = [...nowEntries].sort((a, b) => b.data.date.localeCompare(a.data.date));

const latestDate = sortedNow[0]?.data.date;
const formattedLastUpdated = latestDate ? formatDateLong(latestDate) : '—';

const processedNow = await Promise.all(
  sortedNow.map(async (entry) => {
    const { Content } = await render(entry);
    const dateObj = parseDateSafe(entry.data.date);
    // Gutter label is day-level; the year is carried by the section marker.
    const dayLabel = dateObj.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    return { ...entry, Content, dayLabel, year: String(dateObj.getFullYear()) };
  })
);

// Group into year sections. Entries are already newest-first, so a single pass
// keeps the years in order without a second sort.
type Entry = (typeof processedNow)[number];
const years: { year: string; items: Entry[] }[] = [];
for (const entry of processedNow) {
  const last = years.at(-1);
  if (last && last.year === entry.year) last.items.push(entry);
  else years.push({ year: entry.year, items: [entry] });
}

// ProfilePage dateModified reflects the latest Now entry date for freshness signals
const seoData = [
  profilePage(latestDate ? new Date(latestDate).toISOString() : undefined),
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'Now', url: '/now/' },
  ]),
];
---

<BaseLayout
  title="Now"
  description="What Paul Fernandez is focused on, building, and learning right now."
  ogImage="/og/now.png"
>
  <JsonLd data={seoData} slot="head" />

  <section class="page-head" data-hero>
    <div class="shell">
      <h1 class="display" data-reveal="up" data-reveal-delay="0.05">
        Now
      </h1>
      <p class="lead mt-8" data-reveal="up" data-reveal-delay="0.1">
        A public log of what I'm focused on — current projects, learning, and
        where my head is at.
      </p>
      <p class="mono-micro mt-6" data-reveal="fade" data-reveal-delay="0.16">
        Last updated {formattedLastUpdated}
      </p>
    </div>
  </section>

  <div class="shell pb-24 md:pb-32">
    {processedNow.length > 0 ? (
      <section class="tl" aria-label="Now timeline">
        {years.map(({ year, items }) => (
          <>
            <h2 class="tl-year">{year}</h2>

            {items.map(({ data, Content, id, dayLabel, year: entryYear }) => {
              const displayTitle = data.title || data.slug || id;
              const isCurrent = data.date === latestDate;
              return (
                <article class:list={['tl-item', isCurrent && 'is-current']} data-reveal="up">
                  <time class="tl-date" datetime={data.date}>
                    <span class="tl-date-day">{dayLabel}</span>
                    <span class="tl-date-year">{entryYear}</span>
                  </time>

                  <div class="tl-content">
                    {isCurrent && <p class="tl-badge">Right now</p>}

                    <h3 class="tl-title">{displayTitle}</h3>

                    <div class="prose tl-prose">
                      <Content />
                    </div>

                    {data.link && (
                      <a
                        href={data.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="link-arrow mt-4"
                      >
                        Reference
                      </a>
                    )}
                  </div>
                </article>
              );
            })}
          </>
        ))}

        <p class="tl-end">End of timeline — go build something cool.</p>
      </section>
    ) : (
      <div class="panel p-10">
        <p class="text-paper-400 m-0">
          Nothing here yet — but my
          <a href="/work-with-me/#contact" class="link">inbox is open</a>.
        </p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(8rem, 6rem + 8vw, 12rem) clamp(3rem, 2rem + 4vw, 5rem);
  }

  /* Timeline — /now only. One continuous hairline; year markers are the
   * chapter breaks, entries hang off it as nodes. Mobile stacks the date
   * above the entry; ≥768px moves it into a left gutter. */
  .tl { position: relative; }
  .tl::before {
    content: '';
    position: absolute;
    left: 0.1875rem;
    top: 0.5rem;
    bottom: 0.6875rem;
    width: 1px;
    background: linear-gradient(180deg, var(--line-strong), var(--line) 70%, transparent);
  }

  /* Year: a milestone on the rail with a rule running to the right edge —
   * the same structural move as .kicker, several sizes up. Phase 21 took the
   * wine out of the node and flattened the rule's gradient. */
  .tl-year {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 2.5rem;
    padding-left: 2rem;
    font-family: var(--font-mono);
    font-size: var(--text-h3);
    font-weight: 700;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--color-paper-50);
  }
  .tl-year:not(:first-child) { margin-top: 2rem; }
  .tl-year::before {
    content: '';
    position: absolute;
    left: -0.125rem;
    top: 50%;
    margin-top: -0.375rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background-color: var(--color-paper-50);
  }
  .tl-year::after {
    content: '';
    flex: 1;
    height: 1px;
    background-color: var(--line);
  }

  .tl-item {
    position: relative;
    padding-left: 2rem;
    padding-bottom: 3.5rem;
  }
  .tl-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background-color: var(--color-ink-950);
    box-shadow: inset 0 0 0 1px var(--color-paper-600);
  }
  /* The live entry is the only filled node. Phase 21 removed its wine halo:
   * a glowing dot is a status light, and this is a list of dates. */
  .tl-item.is-current::before {
    background-color: var(--color-paper-50);
    box-shadow: none;
  }

  .tl-date {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--color-paper-400);
    font-variant-numeric: tabular-nums;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    margin-bottom: 0.75rem;
  }
  /* The year already labels the section; the gutter only repeats it on
   * mobile, where the section marker can scroll far out of view. */
  .tl-date-year::before { content: ' '; }

  .tl-badge {
    display: inline-block;
    margin: 0 0 0.75rem;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-paper-100);
    border: 1px solid var(--line-strong);
  }

  .tl-title {
    margin: 0;
    font-size: var(--text-h3);
    line-height: 1.15;
    color: var(--color-paper-50);
  }

  .tl-prose {
    margin-top: 1rem;
    color: var(--color-paper-400);
    max-width: 62ch;
  }

  /* Terminal node — closes the rail so it doesn't just trail off. */
  .tl-end {
    position: relative;
    margin: 0;
    padding-left: 2rem;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--color-paper-600);
  }
  .tl-end::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background-color: var(--color-paper-600);
  }

  @media (min-width: 768px) {
    .tl::before { left: 8.6875rem; }
    .tl-year { padding-left: 10.5rem; }
    .tl-year::before { left: 8.375rem; }
    .tl-item { padding-left: 10.5rem; }
    .tl-item::before { left: 8.5rem; }
    .tl-end { padding-left: 10.5rem; }
    .tl-end::before { left: 8.5rem; }

    .tl-date {
      position: absolute;
      left: 0;
      top: 0.3125rem;
      width: 7.5rem;
      text-align: right;
      margin-bottom: 0;
    }
    /* In the gutter the section marker is always in view, so the repeated
     * year drops away. */
    .tl-date-year { display: none; }
  }
</style>
