---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { profilePage, breadcrumbs } from '../lib/schema';

const nowEntries = await getCollection('now');

// Sort reverse-chronologically (newest first)
const sortedNow = [...nowEntries].sort((a, b) => b.data.date.localeCompare(a.data.date));

function parseDateSafe(dateStr: string | Date) {
  const str = typeof dateStr === 'string' ? dateStr : dateStr.toISOString().slice(0, 10);
  return new Date(`${str}T12:00:00`);
}

const latestDate = sortedNow[0]?.data.date;
const formattedLastUpdated = latestDate
  ? parseDateSafe(latestDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : '—';

const processedNow = await Promise.all(
  sortedNow.map(async (entry) => {
    const { Content } = await render(entry);
    const dateObj = parseDateSafe(entry.data.date);
    const monthYear = dateObj.toLocaleDateString('en-US', {
      month: 'short',
      year: 'numeric',
    });
    return { ...entry, Content, monthYear };
  })
);

// ProfilePage dateModified reflects the latest Now entry date for freshness signals
const seoData = [
  profilePage(latestDate ? new Date(latestDate).toISOString() : undefined),
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'Now', url: '/now' },
  ]),
];
---

<BaseLayout
  title="Now"
  description="What Paul Fernandez is focused on, building, and learning right now."
>
  <JsonLd data={seoData} slot="head" />

  <article>
    <header>
      <h1 class="text-moss-900 m-0">Now</h1>
      <p class="mt-4 mb-0 text-moss-700 text-body leading-relaxed">
        A public log of what I'm focused on — current projects, learning, and where my head is at.
      </p>
      <p class="mt-2 mb-0 text-moss-500 text-small tabular-nums">
        last updated: {formattedLastUpdated}
      </p>
    </header>

    {processedNow.length > 0 ? (
      <section class="mt-12 md:mt-16" aria-label="Now timeline">
        <div class="flex flex-col">
          {processedNow.map(({ data, Content, id, monthYear }) => {
            const displayTitle = data.title || data.slug || id;
            return (
              <article class="py-6 border-t border-moss-200 first:border-t-0">
                <div class="flex flex-col md:flex-row md:items-baseline md:gap-6">
                  <span class="md:w-28 shrink-0 text-moss-500 text-small tabular-nums">
                    {monthYear}
                  </span>
                  <div class="flex-grow min-w-0">
                    <h2 class="font-bold text-moss-900 m-0">{displayTitle}</h2>
                    <div class="prose mt-3 text-ink max-w-[64ch]">
                      <Content />
                    </div>
                    {data.link && (
                      <a
                        href={data.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-block mt-2 text-small text-moss-500 hover:text-moss-900 no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-citrus-500 rounded-sm"
                      >
                        reference ↗
                      </a>
                    )}
                  </div>
                </div>
              </article>
            );
          })}
        </div>

        <div class="mt-12 border-t border-moss-200 pt-6 text-moss-500 text-small italic">
          end of timeline — go build something cool.
        </div>
      </section>
    ) : (
      <div class="mt-12 border-t border-moss-200 pt-6">
        <p class="text-moss-700 m-0">
          Nothing here yet — but my <a href="/work-with-me#contact" class="text-moss-900 hover:text-citrus-500 no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-citrus-500 rounded-sm">inbox is open</a>.
        </p>
      </div>
    )}
  </article>
</BaseLayout>
