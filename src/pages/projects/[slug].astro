---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import { breadcrumbs, person, webPage } from '../../lib/schema';
import { getProjects } from '../../lib/projects';

import cullShot from '../../assets/projects/oddhalls/cull.png';
import designShot from '../../assets/projects/oddhalls/design.png';
import developHeroShot from '../../assets/projects/oddhalls/develop-hero.png';
import developShot from '../../assets/projects/oddhalls/develop.png';
import phoneShot from '../../assets/projects/oddhalls/photobook-phone.png';
import reelShot from '../../assets/projects/oddhalls/reel.png';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const p = project.data;

const description =
  'An objective write-up and feature breakdown of Oddhalls: a local-first photo editor, RAW developer, and zine designer for macOS Apple Silicon.';

const seoData = [
  webPage({
    url: `/projects/${project.id}/`,
    name: `${p.title} — Local-first photo editor and photobook designer`,
    description,
  }),
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'Projects', url: '/projects/' },
    { name: p.title, url: `/projects/${project.id}/` },
  ]),
  person(),
];

const metaFacts = [
  { label: 'Platform', val: 'macOS Apple Silicon', sub: 'macOS 13.4+ · Win & Linux in beta' },
  { label: 'Architecture', val: 'Local-first', sub: 'Folders in place · no catalog DB' },
  { label: 'Color & RAW', val: '32-bit float GPU', sub: '870+ cameras · Display P3 & sRGB' },
  { label: 'Inference', val: '100% on-device', sub: 'SAM 2, BiRefNet, Depth Anything' },
];

const stages = [
  {
    num: '01',
    name: 'Cull',
    tagline: 'Flag, rate, and group the shoot. Decide what stays.',
    image: cullShot,
    alt: 'The Oddhalls Cull stage: multi-column photo grid with keep/reject flags, ratings, lenses, and the Decide session counter.',
    caption: 'Cull stage: multi-column grid with keep (P) and reject (X) flags, burst stacks, and seven diagnostic lenses.',
    items: [
      {
        title: 'Lightroom-style key culling',
        detail: 'Instant keyboard shortcuts (1–5 stars, P to keep, X to reject, U for undecided) with configurable auto-advance. Review one photo large (Space), compare two side-by-side with linked zoom and pan (C), or survey multiple picks at once (N).',
      },
      {
        title: 'Burst & scene clustering',
        detail: 'Rapid camera bursts and temporal scene shifts group automatically. The app evaluates micro-contrast and local sharpness to suggest the sharpest, unclipped frame as the default keeper.',
      },
      {
        title: 'Decide sessions (1v1 duels)',
        detail: 'A focused, distraction-free session for culling an entire shoot. In bursts, duels present two frames side-by-side: pick the winner with arrow keys. A scene coverage strip ensures you don’t over-cull early scenes.',
      },
      {
        title: 'Seven diagnostic lenses',
        detail: 'Objective technical filters (Soft, Blown, Dark, Faces, Eye focus, Light, Busy) rank and badge files by local sharpness, highlight clipping, and exposure without ever changing user flags.',
      },
      {
        title: 'On-device face matching & IPTC',
        detail: 'Local SFace neural embeddings identify recurring individuals across folders without cloud transmission. Full IPTC support for captions, copyright, creator metadata, and contest submission sheets.',
      },
    ],
  },
  {
    num: '02',
    name: 'Develop',
    tagline: 'Non-destructive 32-bit floating point RAW pipeline with local AI masks.',
    image: developShot,
    alt: 'The Oddhalls Develop stage: portrait photo with tonal curves, color wheels, film looks shelf, and filmstrip.',
    caption: 'Develop stage: non-destructive tonal controls, color grading wheels with harmony locks, and 12 built-in film looks.',
    items: [
      {
        title: '32-bit floating point GPU pipeline',
        detail: 'Hardware-accelerated processing engine supporting JPEG, HEIC (macOS ImageIO 10-bit), and over 870 camera RAW formats through the rawler library. Wide-gamut colour management honors Display P3 and sRGB end-to-end.',
      },
      {
        title: 'Tonal and color controls',
        detail: 'Exposure, white balance (Kelvin and tint for RAW), tone curves with presets (Soft S, Matte, Faded), HSL colour mix, texture, clarity, and dehaze.',
      },
      {
        title: 'Three-way color grading wheels',
        detail: 'Shadows, Midtones, Highlights, and Global wheels with dedicated luminance sliders and color harmony locks (complementary, triadic, analogous) that move wheels in unison.',
      },
      {
        title: '12 built-in film looks & 3D LUTs',
        detail: 'Curated film simulations named after birds (warm negative, cool negative, slide, pushed monochrome, cine print) with variable intensity sliders, alongside custom .cube 3D LUT import.',
      },
      {
        title: 'Local on-device AI masks',
        detail: 'Zero-upload semantic masking powered by SAM 2, BiRefNet, and Depth Anything. Isolate subject, sky, background, people, and depth layers with one click, supplemented by linear, radial, and brush gradients.',
      },
      {
        title: 'Neural denoise & object removal',
        detail: 'GPU-accelerated NAFNet and SCUNet denoise high-ISO files, while MI-GAN inpainting removes sensor spots and distractions directly on Apple Silicon.',
      },
    ],
  },
  {
    num: '03',
    name: 'Design',
    tagline: 'Zine-style photobooks, 300 DPI print spreads, social carousels, and before/after reels.',
    image: designShot,
    alt: 'The Oddhalls Design stage: photobook spreads laid out on canvas with snap guides and filmstrip.',
    caption: 'Design stage: freeform and layout-driven canvas for photobook spreads, print zines, and social carousels.',
    items: [
      {
        title: 'Photobook & zine canvas',
        detail: 'Multi-page canvas supporting phone portrait (4:5), story (9:16), square, and A4 formats. Intelligent snapping guides, proportional margins, and curated typographic hierarchy.',
      },
      {
        title: 'Facing-page spreads & 300 DPI print PDF',
        detail: 'Spreads view mirrors physical books. Export high-resolution PDFs with 300 DPI photo rendering, configurable 3mm bleed, and printer trim marks for physical zine runs.',
      },
      {
        title: 'Multi-network social generator',
        detail: 'Design once and adapt for Instagram carousels, TikTok slideshows, Bluesky, Threads, and Pinterest. Displays safe-area overlays and profile grid crop previews; exports numbered image sequences and caption files.',
      },
      {
        title: 'Before-to-after video reels',
        detail: 'Computes standalone MP4 videos (9:16 vertical, 16:9 desktop, 1:1 square) illustrating the edit’s progression from RAW capture through develop steps to the finished grade, complete with hold times, audio beat-syncing, and brand cards.',
      },
    ],
  },
  {
    num: '04',
    name: 'Publish',
    tagline: 'Self-hosted to personal Cloudflare R2 with mobile-first reader and clean downloads.',
    image: phoneShot,
    alt: 'A published Oddhalls photobook open on a smartphone screen.',
    caption: 'Mobile viewer: lightweight, touch-optimized web reader with zero central tracking.',
    items: [
      {
        title: 'Self-hosted Cloudflare R2 deployment',
        detail: 'Books publish directly to the photographer’s personal Cloudflare R2 bucket. No central Oddhalls server, no user tracking, and completely free on standard tier allowances.',
      },
      {
        title: 'Mobile-first reader experience',
        detail: 'Recipients open a lightweight web app on their phone or tablet, swiping through pages like a physical art book with responsive layout scaling.',
      },
      {
        title: 'Client proofing & full-res downloads',
        detail: 'Generate unlisted review links with watermarked proof sheets and numeric pick submissions. Allow readers or clients to download full-resolution originals without cloud degradation.',
      },
    ],
  },
];
---

<BaseLayout
  title={`${p.title} — Local-first photo editor & photobook designer`}
  description={description}
  ogImage={`/og/projects-${project.id}.png`}
>
  <JsonLd data={seoData} slot="head" />

  <section class="page-head">
    <div class="shell">
      <a href="/projects/" class="eyebrow-back">
        <span aria-hidden="true">←</span> Back to projects
      </a>

      <div class="flex flex-wrap items-center gap-3 mt-8">
        <span class="tag">Beta v0.1.0</span>
        <span class="mono-micro">macOS Apple Silicon</span>
        <span class="mono-micro text-ink-400">·</span>
        <span class="mono-micro text-ink-400">Free to use</span>
      </div>

      <h1 class="display mt-4 max-w-[16ch]">
        {p.title}
      </h1>

      <p class="lead mt-6 max-w-[54ch]">
        A local-first photo editor and photobook designer built for the whole job
        after a shoot — from culling raw memory cards to published zines and reels.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a
          href="https://oddhalls.janpaulfernandez.com"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          Visit oddhalls.janpaulfernandez.com ↗
        </a>
        <a href="#features" class="btn btn-ghost">
          Explore feature breakdown ↓
        </a>
      </div>
    </div>
  </section>

  <div class="shell pb-24 md:pb-32">
    {/* Spec / facts hairline grid */}
    <dl class="meta">
      {metaFacts.map((fact) => (
        <div class="meta__cell">
          <dt class="meta__label">{fact.label}</dt>
          <dd class="meta__val">{fact.val}</dd>
          <dd class="meta__sub">{fact.sub}</dd>
        </div>
      ))}
    </dl>

    {/* HERO SCREENSHOT */}
    <figure class="shot-figure mt-14">
      <div class="shot-frame">
        <Image
          src={developHeroShot}
          alt="The Oddhalls Develop stage on a Lisbon rooftop photo, showing Light, Color, and Curves sliders."
          class="w-full h-auto block"
          loading="eager"
        />
      </div>
      <figcaption class="shot-caption">
        <span class="shot-caption-label">Develop Stage (Hero)</span>
        <span class="shot-caption-text">
          32-bit floating point GPU pipeline on a Lisbon rooftop capture, featuring real-time tonal adjustments, tone curves, and looks shelf.
        </span>
      </figcaption>
    </figure>

    {/* ---------------------------------------------------------------------
        SECTION 1: OBJECTIVE OVERVIEW & ARCHITECTURE
       --------------------------------------------------------------------- */}
    <section class="section section-ruled" aria-labelledby="overview-heading">
      <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16 items-start">
        <div>
          <h2 id="overview-heading" class="kicker">
            01 · Background &amp; Architecture
          </h2>
          <p class="statement-sm mt-8">
            The post-shoot bottleneck.
          </p>
          <p class="mono-micro mt-4 text-ink-400">
            Why Oddhalls was built
          </p>
        </div>

        <div class="space-y-6 subtext">
          <p>
            Photography has an unaddressed workflow problem after the shutter clicks.
            A single afternoon shoot generates hundreds of raw files. Processing them typically
            requires juggling four disjointed tools: a specialized culling app (like Photo Mechanic)
            to sort through frames quickly, a heavyweight catalog-based raw developer (like Lightroom
            or Capture One) with recurring monthly subscription fees, page design tools (InDesign,
            Figma, Canva) to format social carousels and print zines, and video editing suites to
            manually record before-and-after reels for social media.
          </p>
          <p>
            Every transition between applications introduces friction, duplicate file exports,
            and catalog synchronization risks. Furthermore, conventional raw software increasingly
            pushes photographers toward cloud-dependent ecosystems where file libraries are tied to
            remote databases and subscription lock-in.
          </p>
          <p>
            <strong>Oddhalls</strong> was engineered to solve this end-to-end pipeline in a single
            desktop application. Built with a local-first architecture on Tauri and Rust, it operates
            directly on existing photo folders without copying files, without a central catalog database,
            and without requiring a user account.
          </p>
          <p>
            Edits and ratings are written non-destructively to small sidecar files beside original photos,
            leaving master RAWs entirely untouched. Local GPU acceleration handles raw decoding
            and real-time colour science, while modern neural vision models run directly on-device
            to power semantic masking, depth maps, and denoising with zero cloud telemetry.
          </p>
        </div>
      </div>
    </section>

    {/* ---------------------------------------------------------------------
        SECTION 2: FEATURE BREAKDOWN ACROSS FOUR STAGES
       --------------------------------------------------------------------- */}
    <section id="features" class="section section-ruled" aria-labelledby="breakdown-heading">
      <div>
        <h2 id="breakdown-heading" class="kicker">
          02 · Feature Breakdown
        </h2>
        <div class="mt-8 flex flex-col md:flex-row md:items-end justify-between gap-6">
          <div>
            <p class="statement-sm max-w-[26ch]">
              Four sequential stages.
            </p>
            <p class="lead mt-4 max-w-[50ch]">
              Designed in the exact order photographers work: from memory card ingestion
              to published zines and reels.
            </p>
          </div>
          <a
            href="https://oddhalls.janpaulfernandez.com"
            target="_blank"
            rel="noopener noreferrer"
            class="link-arrow shrink-0"
          >
            Open Oddhalls in beta
          </a>
        </div>
      </div>

      <div class="mt-16 space-y-24">
        {stages.map((stage) => (
          <article class="stage-block" aria-labelledby={`stage-${stage.num}`}>
            <div class="border-b border-[var(--line)] pb-6 mb-8 flex flex-wrap items-baseline justify-between gap-4">
              <div class="flex items-baseline gap-4">
                <span class="stage-num font-mono text-ink-400">{stage.num}</span>
                <h3 id={`stage-${stage.num}`} class="stage-title text-ink-900 m-0">
                  {stage.name}
                </h3>
              </div>
              <p class="stage-tagline text-small text-ink-600 m-0">
                {stage.tagline}
              </p>
            </div>

            {/* Stage screenshot */}
            <figure class="shot-figure mb-10">
              <div class="shot-frame">
                <Image
                  src={stage.image}
                  alt={stage.alt}
                  class="w-full h-auto block"
                  loading="lazy"
                />
              </div>
              <figcaption class="shot-caption">
                <span class="shot-caption-label">{stage.name} Stage</span>
                <span class="shot-caption-text">{stage.caption}</span>
              </figcaption>
            </figure>

            {/* If Stage 03 (Design), also display the Reel editor screenshot */}
            {stage.num === '03' && (
              <figure class="shot-figure mb-10">
                <div class="shot-frame">
                  <Image
                    src={reelShot}
                    alt="The Oddhalls Reel editor: picked photos, before/after chapter storyboards, and template controls."
                    class="w-full h-auto block"
                    loading="lazy"
                  />
                </div>
                <figcaption class="shot-caption">
                  <span class="shot-caption-label">Reel Editor</span>
                  <span class="shot-caption-text">
                    Automated Before-to-After MP4 generation for Instagram Reels, TikTok, and YouTube Shorts.
                  </span>
                </figcaption>
              </figure>
            )}

            {/* Feature item list */}
            <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
              {stage.items.map((item) => (
                <div class="feature-card">
                  <h4 class="feature-card-title text-ink-900">{item.title}</h4>
                  <p class="feature-card-desc text-ink-600">{item.detail}</p>
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    {/* ---------------------------------------------------------------------
        SECTION 3: TECHNICAL ARCHITECTURE & LOCAL MODELS
       --------------------------------------------------------------------- */}
    <section class="section section-ruled" aria-labelledby="specs-heading">
      <h2 id="specs-heading" class="kicker">
        03 · Technical Architecture
      </h2>

      <div class="mt-10 grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16 items-start">
        <div>
          <p class="statement-sm">
            Built for privacy and native performance.
          </p>
          <p class="mt-4 subtext">
            Every computationally intensive task runs locally on Apple Silicon.
            No remote GPUs, no server subscriptions, and no tracking.
          </p>
        </div>

        <div class="panel p-6 sm:p-8 space-y-6">
          <div class="spec-row">
            <span class="spec-label">Shell &amp; Backend</span>
            <span class="spec-val">Tauri v2 + Rust</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">Rendering Pipeline</span>
            <span class="spec-val">WebGL / WebGPU custom shader pipeline (32-bit float)</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">RAW Image Engine</span>
            <span class="spec-val">rawler crate (870+ camera models supported natively)</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">Local Neural Models</span>
            <span class="spec-val">SAM 2 (Meta), BiRefNet, Depth Anything v2, SFace, NAFNet, MI-GAN</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">Color Spaces</span>
            <span class="spec-val">Display P3 and sRGB color-managed end-to-end</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">Metadata Standards</span>
            <span class="spec-val">IPTC Core/Extension &amp; XMP sidecars (.photobook/)</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">Publish Target</span>
            <span class="spec-val">Self-hosted Cloudflare R2 bucket (S3 compatible)</span>
          </div>
          <div class="spec-row">
            <span class="spec-label">Licensing &amp; Cost</span>
            <span class="spec-val">Free to use in beta · Open-source local models</span>
          </div>
        </div>
      </div>
    </section>

    {/* ---------------------------------------------------------------------
        CALL TO ACTION
       --------------------------------------------------------------------- */}
    <section class="section section-ruled" aria-labelledby="cta-heading">
      <div class="panel p-8 sm:p-14 text-center max-w-3xl mx-auto">
        <p class="mono-micro text-ink-400">Available in Beta</p>
        <h2 id="cta-heading" class="statement-sm mt-4 text-ink-900">
          Try Oddhalls on macOS
        </h2>
        <p class="mt-4 subtext max-w-[48ch] mx-auto">
          Oddhalls is currently in public beta for Apple Silicon Macs. Download the app,
          view documentation, or explore the sample photobook online.
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a
            href="https://oddhalls.janpaulfernandez.com"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            Visit oddhalls.janpaulfernandez.com ↗
          </a>
          <a
            href="https://oddhalls.janpaulfernandez.com/press"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost"
          >
            Press Kit &amp; Screenshots ↗
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(8rem, 6rem + 8vw, 12rem) clamp(3rem, 2rem + 4vw, 5rem);
  }

  .eyebrow-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    color: var(--color-ink-400);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    text-decoration: none;
    transition: color 0.2s var(--ease-out-quint);
  }
  .eyebrow-back:hover {
    color: var(--color-red-700);
  }

  /* --- Meta facts strip ------------------------------------------------- */
  .meta {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin: 0;
  }
  @media (min-width: 48rem) {
    .meta {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .meta__cell {
    padding: 1.5rem 1.5rem 1.5rem 0;
  }
  .meta__cell + .meta__cell {
    border-top: 1px solid var(--line);
  }
  @media (min-width: 48rem) {
    .meta__cell {
      border-top: 0;
      padding: 1.75rem 1.5rem 1.75rem 0;
    }
    .meta__cell + .meta__cell {
      border-top: 0;
      border-left: 1px solid var(--line);
      padding-left: 1.5rem;
    }
  }
  .meta__label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-ink-400);
  }
  .meta__val {
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-ink-900);
  }
  .meta__sub {
    margin: 0.35rem 0 0;
    font-size: var(--text-micro);
    color: var(--color-ink-400);
    line-height: 1.4;
  }

  /* --- Screenshot frame ------------------------------------------------- */
  .shot-figure {
    margin: 0;
  }
  .shot-frame {
    position: relative;
    border: 1px solid var(--line);
    background-color: var(--color-paper-100);
    overflow: hidden;
  }
  .shot-caption {
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  @media (min-width: 48rem) {
    .shot-caption {
      flex-direction: row;
      align-items: baseline;
      gap: 1rem;
    }
  }
  .shot-caption-label {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-ink-400);
    white-space: nowrap;
  }
  .shot-caption-text {
    font-size: var(--text-small);
    color: var(--color-ink-600);
    line-height: 1.5;
  }

  /* --- Stage block styling ---------------------------------------------- */
  .stage-num {
    font-size: var(--text-lead);
    color: var(--color-ink-400);
    letter-spacing: -0.02em;
  }
  .stage-title {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  /* --- Feature cards ---------------------------------------------------- */
  .feature-card {
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
  }
  .feature-card-title {
    font-family: var(--font-display);
    font-size: var(--text-body);
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 0 0 0.5rem 0;
  }
  .feature-card-desc {
    font-size: var(--text-small);
    line-height: 1.6;
    margin: 0;
  }

  /* --- Spec row list ---------------------------------------------------- */
  .spec-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem;
    border-top: 1px solid var(--line);
    padding-top: 0.875rem;
  }
  .spec-row:first-child {
    border-top: 0;
    padding-top: 0;
  }
  @media (min-width: 40rem) {
    .spec-row {
      grid-template-columns: 12rem 1fr;
      gap: 1rem;
      align-items: baseline;
    }
  }
  .spec-label {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-ink-400);
  }
  .spec-val {
    font-size: var(--text-small);
    color: var(--color-ink-900);
    line-height: 1.5;
  }
</style>
