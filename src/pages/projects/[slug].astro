---
// Interim stub (33.2): renders the MDX body. Replaced by the generic template in 33.3.
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import KeyTakeaway from '../../components/blocks/KeyTakeaway.astro';
import Callout from '../../components/blocks/Callout.astro';
import PullQuote from '../../components/blocks/PullQuote.astro';
import Embed from '../../components/blocks/Embed.astro';
import { breadcrumbs, person, webPage } from '../../lib/schema';
import { getProjects, hasPage } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = (await getProjects()).filter(hasPage);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const p = project.data;
const { Content } = await render(project);
const components = { KeyTakeaway, Callout, PullQuote, Embed };
const description = p.metaDescription ?? p.summary;

const seoData = [
  webPage({ url: `/projects/${project.id}/`, name: p.title, description }),
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'Projects', url: '/projects/' },
    { name: p.title, url: `/projects/${project.id}/` },
  ]),
  person(),
];
---

<BaseLayout title={p.title} description={description} ogImage={`/og/projects-${project.id}.png`}>
  <JsonLd data={seoData} slot="head" />

  <section class="shell pt-40 pb-24">
    <a href="/projects/" class="mono">← Back to projects</a>
    <h1 class="display mt-8">{p.title}</h1>
    <p class="lead mt-6 max-w-[54ch]">{p.summary}</p>
    <div class="prose mt-12">
      <Content components={components} />
    </div>
  </section>
</BaseLayout>
