---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import { breadcrumbs } from '../../lib/schema';
import { getProjects, groupProjectsByYear } from '../../lib/projects';

const projects = await getProjects();
const groups = groupProjectsByYear(projects);

const seoData = [
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'Projects', url: '/projects/' },
  ]),
];
---

<BaseLayout
  title="Projects"
  description="Projects by Paul Fernandez — things he's built, shipped, and tinkered with, indexed by year."
  ogImage="/og/projects.png"
>
  <JsonLd data={seoData} slot="head" />

  <section class="page-head" data-hero>
    <div class="shell">
      <h1 class="display" data-reveal="up" data-reveal-delay="0.05">Projects</h1>
      <p class="lead mt-8" data-reveal="up" data-reveal-delay="0.1">
        Things I've built, shipped, and tinkered with —
        indexed by year.
      </p>
    </div>
  </section>

  <div class="shell pb-24 md:pb-32">
    {groups.length > 0 ? (
      <div aria-label="Projects by year">
        {groups.map((group) => (
          <section class="mt-16 first:mt-0">
            <h2 class="kicker tabular-nums">{group.year}</h2>
            <ul class="rows mt-8" data-reveal-stagger>
              {group.items.map((project) => {
                const body = (
                  <span class="min-w-0">
                    <span class="row-title block">{project.data.title}</span>
                    <span class="block mt-2 text-small text-paper-400 max-w-[62ch]">
                      {project.data.description}
                    </span>
                  </span>
                );
                return (
                  <li data-reveal="up">
                    {project.data.link ? (
                      <a
                        href={project.data.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="row-link"
                      >
                        {body}
                        <span class="row-meta" aria-hidden="true">↗</span>
                      </a>
                    ) : (
                      <div class="row-link">{body}</div>
                    )}
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </div>
    ) : (
      <div class="panel p-10 md:p-16 text-center" data-reveal="up">
        <p class="statement-sm m-0">Nothing on the shelf… yet.</p>
        <a href="/work-with-me/#contact" class="btn btn-ghost mt-8">
          Ask me what I'm building
        </a>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(8rem, 6rem + 8vw, 12rem) clamp(3rem, 2rem + 4vw, 5rem);
  }
  .statement-sm {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-paper-50);
  }
</style>
