---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import { breadcrumbs } from '../../lib/schema';
import { getProjects, groupProjectsByYear } from '../../lib/projects';

const projects = await getProjects();
const groups = groupProjectsByYear(projects);

const seoData = [
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'Projects', url: '/projects' },
  ]),
];
---

<BaseLayout
  title="Projects"
  description="Projects by Paul Fernandez — things he's built, shipped, and tinkered with, indexed by year."
>
  <JsonLd data={seoData} slot="head" />

  <article>
    <header>
      <h1 class="display m-0">Projects</h1>
      <p class="mt-8 mb-0 text-ink-700 text-body leading-relaxed max-w-prose">
        Things I've built, shipped, and tinkered with — <span class="flare">indexed by year</span>.
      </p>
    </header>

    {groups.length > 0 ? (
      <section class="mt-16 md:mt-20" aria-label="Projects by year">
        {groups.map((group) => (
          <section class="mt-12 first:mt-0">
            <h2 class="kicker tabular-nums">{group.year}</h2>
            <ul class="rows mt-6">
              {group.items.map((project) => (
                <li>
                  {project.data.link ? (
                    <a href={project.data.link} target="_blank" rel="noopener noreferrer" class="row-link">
                      <span>
                        <span class="font-bold text-h3 leading-tight block text-balance">{project.data.title}</span>
                        <span class="block mt-2 text-ink-700 text-body max-w-prose">{project.data.description}</span>
                      </span>
                      <span class="row-meta" aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    <div class="row-link">
                      <span>
                        <span class="font-bold text-h3 leading-tight block text-balance">{project.data.title}</span>
                        <span class="block mt-2 text-ink-700 text-body max-w-prose">{project.data.description}</span>
                      </span>
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </section>
    ) : (
      <div class="mt-12 border-t border-ink-200 pt-6">
        <p class="text-ink-700 m-0">
          Nothing on the shelf… yet. <a href="/work-with-me#contact" class="text-ink-900 hover:text-wine-500 no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500 rounded-sm">ask me what I'm building →</a>
        </p>
      </div>
    )}
  </article>
</BaseLayout>
