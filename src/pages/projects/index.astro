---
// Projects index (33.4): a year-grouped ruled list (the OpenAI index pattern,
// rebuild-plan §12) with a kind filter. Every row is in the HTML; the filter
// only hides rows, and its bar exists only under `.js`.
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import { breadcrumbs, person, webPage } from '../../lib/schema';
import {
  getProjects,
  groupProjectsByYear,
  KIND_LABEL,
  PROJECT_KINDS,
  projectsByKind,
} from '../../lib/projects';

const all = await getProjects();
const groups = groupProjectsByYear(all);
// A chip only for a kind that has entries: "Talks" appears with the first talk.
const kinds = PROJECT_KINDS.filter((k) => projectsByKind(all, k).length > 0);

const description =
  "Projects by Paul Fernandez — things I've built, shipped, and tinkered with, indexed by year.";

const seoData = [
  webPage({ url: '/projects/', name: 'Projects', description }),
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'Projects', url: '/projects/' },
  ]),
  person(),
];
---

<BaseLayout title="Projects" description={description} ogImage="/og/projects.png">
  <JsonLd data={seoData} slot="head" />

  <div class="shell">
    {/* Head — opens the page; no rule. */}
    <section class="section">
      <h1 class="display">Projects</h1>
      <p class="subtext mt-8 mb-0 max-w-[52ch]">
        What I've built and worked on, newest first. Where there's a write-up,
        the row links to it.
      </p>
    </section>

    <section class="section section-ruled" aria-label="Projects by year">
      <div class="filter-bar" role="group" aria-label="Filter projects" data-filter-group="kind">
        <button type="button" class="chip" aria-pressed="true" data-value="all">All</button>
        {kinds.map((k) => (
          <button type="button" class="chip" aria-pressed="false" data-value={k}>
            {KIND_LABEL[k]}
          </button>
        ))}
      </div>
      <p id="projects-status" class="sr-only" aria-live="polite"></p>

      <div class="year-list">
        {groups.map((group) => (
          <section class="year-group" data-year-group aria-labelledby={`year-${group.year}`}>
            <div class="year-grid">
              <h2 id={`year-${group.year}`} class="year mono">{group.year}</h2>
              <ul class="rows">
                {group.items.map((project) => <ProjectRow project={project} />)}
              </ul>
            </div>
          </section>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* No JS, no filter: every row stays visible and the bar never shows. */
  .filter-bar { display: none; }
  :global(.js) .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--space-l);
  }

  /* One hairline above each row, none below, so hiding rows or whole years
   * never doubles a rule; the list closes with a single rule. The <li> and the
   * year <section> carry no `display`, so the `hidden` utility always wins. */
  .year-list { border-bottom: 1px solid var(--line); }
  .year-grid :global(.rows > li) {
    border-bottom: 0;
    border-top: 1px solid var(--line);
  }
  .year {
    margin: var(--space-l) 0 var(--space-xs);
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.14em;
  }
  .year-group:first-child .year { margin-top: 0; }

  @media (min-width: 64rem) {
    .year-grid {
      display: grid;
      grid-template-columns: 8rem minmax(0, 1fr);
    }
    /* The rule runs under the year too, and the year sits on the first
     * row's title line. */
    .year,
    .year-group:first-child .year {
      margin: 0;
      padding-top: calc(var(--space-m) + 0.75rem);
      border-top: 1px solid var(--line);
    }
  }
</style>

<script>
  // Kind filter (rung 4). Hides with the `hidden` class, not the attribute:
  // an author `display` on a row would beat the UA `[hidden]` rule.
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter-group="kind"] button');
  const rows = document.querySelectorAll<HTMLElement>('li[data-kind]');
  const years = document.querySelectorAll<HTMLElement>('[data-year-group]');
  const status = document.getElementById('projects-status');

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const value = chip.dataset.value;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));

      let shown = 0;
      rows.forEach((row) => {
        const match = value === 'all' || row.dataset.kind === value;
        row.classList.toggle('hidden', !match);
        if (match) shown++;
      });
      years.forEach((year) => {
        year.classList.toggle('hidden', !year.querySelector('li[data-kind]:not(.hidden)'));
      });

      if (status) status.textContent = `Showing ${shown} project${shown === 1 ? '' : 's'}`;
    });
  });
</script>
