---
// sitemap.astro — Visual HTML sitemap for human visitors and crawlers.
// Dynamically queries all content collections at build time, so any new
// page, article, project, or gallery entry is automatically listed.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { breadcrumbs, person, webPage } from '../lib/schema';
import { getPublishedThoughts } from '../lib/thoughts';
import { getProjects, hasPage } from '../lib/projects';
import { formatDate } from '../lib/dates';

const thoughts = await getPublishedThoughts();
const tiers = (await getCollection('program')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getProjects()).filter(hasPage);
const gallerySets = (await getCollection('gallery')).sort(
  (a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime()
);

// Extract and count all unique topics across published thoughts
const topicCounts = new Map<string, number>();
for (const post of thoughts) {
  for (const topic of post.data.topics || []) {
    topicCounts.set(topic, (topicCounts.get(topic) ?? 0) + 1);
  }
}
const topics = Array.from(topicCounts.entries()).sort(([a], [b]) => a.localeCompare(b));

const TOPIC_NAMES: Record<string, string> = {
  ai: 'AI',
  culture: 'Culture',
  engineering: 'Engineering',
  media: 'Media',
  philosophy: 'Philosophy',
  product: 'Product',
  psychology: 'Psychology',
  technology: 'Technology',
  workflows: 'Workflows',
};

const mainPages = [
  { href: '/', title: 'Home', description: 'Overview, current focus, and featured writing.' },
  { href: '/about/', title: 'About', description: 'Background, track record in banking and elections, and principles.' },
  { href: '/thoughts/', title: 'Thoughts', description: 'Essays and notes on technology, economics, and psychology.' },
  { href: '/projects/', title: 'Projects', description: 'Things built, shipped, and open-sourced, indexed by year.' },
  { href: '/gallery/', title: 'Gallery', description: 'Photography collections — concerts, festivals, and travels.' },
  { href: '/now/', title: 'Now', description: 'Current projects, active reading, and immediate focus.' },
  { href: '/work-with-me/', title: 'Work with me', description: 'Three ways to work together, and the enquiry form.' },
  { href: '/work-with-me/ai-resilient-organisation/', title: 'AI-Resilient Organisation', description: 'A vendor-neutral AI program for Philippine organisations, in five tiers.' },
  { href: '/colophon/', title: 'Colophon', description: 'The stack, design constraints, and technical specifications.' },
];

const feedLinks = [
  { href: '/sitemap-index.xml', title: 'XML Sitemap Index', note: 'Standard sitemaps.org format for search engines' },
  { href: '/rss.xml', title: 'RSS Feed', note: 'Full-text syndication feed for RSS readers' },
  { href: '/llms.txt', title: 'llms.txt', note: 'Curated plain-text site summary for AI crawlers' },
  { href: '/llms-full.txt', title: 'llms-full.txt', note: 'Complete corpus for language models' },
];

const description =
  'A full index of every page, essay, project, and photo gallery published on janpaulfernandez.com.';

const seoData = [
  webPage({
    url: '/sitemap/',
    name: 'Sitemap — Paul Fernandez',
    description,
  }),
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'Sitemap', url: '/sitemap/' },
  ]),
  person(),
];
---

<BaseLayout
  title="Sitemap"
  description={description}
  ogImage="/og/sitemap.png"
>
  <JsonLd data={seoData} slot="head" />

  <section class="page-head">
    <div class="shell">
      <h1 class="display">Sitemap</h1>
      <p class="lead mt-8">
        A directory of every page, essay, and project on this site.
        Updated automatically on every build.
      </p>

      <div class="mt-8 flex flex-wrap gap-4 text-ink-400 mono-micro">
        <a href="/sitemap-index.xml" class="text-ink-600 no-underline hover:text-ink-900 transition-colors">
          XML Sitemap →
        </a>
        <span>·</span>
        <a href="/rss.xml" class="text-ink-600 no-underline hover:text-ink-900 transition-colors">
          RSS Feed →
        </a>
        <span>·</span>
        <a href="/llms.txt" class="text-ink-600 no-underline hover:text-ink-900 transition-colors">
          llms.txt →
        </a>
      </div>
    </div>
  </section>

  <div class="shell pb-24 md:pb-32 space-y-16 md:space-y-24">
    {/* 1. Pages */}
    <section aria-labelledby="heading-main">
      <div class="border-b border-[var(--line)] pb-4 mb-8">
        <h2 id="heading-main" class="kicker m-0">Pages</h2>
      </div>

      <ul class="list-none m-0 p-0 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {mainPages.map((page) => (
          <li class="border border-[var(--line)] p-5 transition-colors">
            <h3 class="m-0 text-h3 leading-tight">
              <a href={page.href} class="text-ink-900 no-underline hover:text-red-700 transition-colors">
                {page.title}
              </a>
            </h3>
            <p class="mt-2 mb-0 subtext">
              {page.description}
            </p>
            <p class="mt-3 mb-0 mono-micro text-ink-400">
              {page.href}
            </p>
          </li>
        ))}
      </ul>
    </section>

    {/* 2. Program tiers */}
    <section aria-labelledby="heading-program">
      <div class="flex items-baseline justify-between border-b border-[var(--line)] pb-4 mb-8">
        <h2 id="heading-program" class="kicker m-0">Program</h2>
        <span class="mono-micro text-ink-400">{tiers.length} tiers</span>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        {tiers.map((tier) => (
          <div class="border border-[var(--line)] p-6 transition-colors">
            <p class="m-0 mono-micro text-ink-400 uppercase tracking-wider">
              {tier.data.label}
            </p>
            <h3 class="mt-2 mb-0 text-h3 leading-tight">
              <a href={`/work-with-me/ai-resilient-organisation/${tier.id}/`} class="text-ink-900 no-underline hover:text-red-700 transition-colors">
                {tier.data.title}
              </a>
            </h3>
            <p class="mt-3 mb-0 subtext">
              {tier.data.tagline}
            </p>
          </div>
        ))}
      </div>
    </section>

    {/* 3. Projects (only entries with a page) */}
    <section aria-labelledby="heading-projects">
      <div class="flex items-baseline justify-between border-b border-[var(--line)] pb-4 mb-8">
        <h2 id="heading-projects" class="kicker m-0">Projects</h2>
        <span class="mono-micro text-ink-400">{projects.length} {projects.length === 1 ? 'case study' : 'case studies'}</span>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        {projects.map((project) => (
          <div class="border border-[var(--line)] p-6 transition-colors">
            <p class="m-0 mono-micro text-ink-400">
              {project.data.year}
            </p>
            <h3 class="mt-2 mb-0 text-h3 leading-tight">
              <a href={`/projects/${project.id}/`} class="text-ink-900 no-underline hover:text-red-700 transition-colors">
                {project.data.title}
              </a>
            </h3>
            <p class="mt-3 mb-0 subtext">
              {project.data.summary}
            </p>
          </div>
        ))}
      </div>
    </section>

    {/* 4. Thoughts */}
    <section aria-labelledby="heading-thoughts">
      <div class="flex items-baseline justify-between border-b border-[var(--line)] pb-4 mb-8">
        <h2 id="heading-thoughts" class="kicker m-0">Thoughts</h2>
        <span class="mono-micro text-ink-400">{thoughts.length} {thoughts.length === 1 ? 'thought' : 'thoughts'}</span>
      </div>

      <div class="divide-y divide-[var(--line)]">
        {thoughts.map((post) => (
          <article class="py-5 first:pt-0 last:pb-0 flex flex-col md:flex-row md:items-baseline md:justify-between gap-2 md:gap-8">
            <div class="min-w-0">
              <h3 class="m-0 text-body font-medium leading-snug">
                <a href={`/thoughts/${post.id}/`} class="text-ink-900 no-underline hover:text-red-700 transition-colors">
                  {post.data.title}
                </a>
              </h3>
              {post.data.excerpt && (
                <p class="mt-1 mb-0 subtext line-clamp-2 max-w-[65ch]">
                  {post.data.excerpt}
                </p>
              )}
            </div>

            <div class="shrink-0 flex items-center gap-3 mono-micro text-ink-400">
              {post.data.topics && post.data.topics.length > 0 && (
                <span class="hidden sm:inline">
                  {post.data.topics.map((t) => TOPIC_NAMES[t] ?? t).join(', ')}
                </span>
              )}
              <time datetime={post.data.publishedDate}>
                {formatDate(post.data.publishedDate)}
              </time>
            </div>
          </article>
        ))}
      </div>
    </section>

    {/* 5. Topics */}
    <section aria-labelledby="heading-topics">
      <div class="flex items-baseline justify-between border-b border-[var(--line)] pb-4 mb-8">
        <h2 id="heading-topics" class="kicker m-0">Topics</h2>
        <span class="mono-micro text-ink-400">{topics.length} archives</span>
      </div>

      <ul class="list-none m-0 p-0 flex flex-wrap gap-3">
        {topics.map(([topic, count]) => (
          <li>
            <a
              href={`/topics/${topic}/`}
              class="inline-flex items-center gap-2 border border-[var(--line)] px-4 py-2 text-ink-900 no-underline hover:text-red-700 transition-colors"
            >
              <span class="font-medium">{TOPIC_NAMES[topic] ?? topic}</span>
              <span class="mono-micro text-ink-400">({count})</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {/* 6. Photo sets */}
    <section aria-labelledby="heading-gallery">
      <div class="flex items-baseline justify-between border-b border-[var(--line)] pb-4 mb-8">
        <h2 id="heading-gallery" class="kicker m-0">Photo sets</h2>
        <span class="mono-micro text-ink-400">{gallerySets.length} sets</span>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        {gallerySets.map((set) => (
          <div class="border border-[var(--line)] p-6 transition-colors">
            <p class="m-0 mono-micro text-ink-400">
              {set.data.photos.length} photos · {formatDate(set.data.publishedDate)}
            </p>
            <h3 class="mt-2 mb-0 text-h3 leading-tight">
              <a href={`/gallery/${set.id}/`} class="text-ink-900 no-underline hover:text-red-700 transition-colors">
                {set.data.title}
              </a>
            </h3>
            {set.data.description && (
              <p class="mt-3 mb-0 subtext">
                {set.data.description}
              </p>
            )}
          </div>
        ))}
      </div>
    </section>

    {/* 7. Feeds & Raw Endpoints */}
    <section aria-labelledby="heading-feeds">
      <div class="border-b border-[var(--line)] pb-4 mb-8">
        <h2 id="heading-feeds" class="kicker m-0">Feeds & Machine-Readable Data</h2>
      </div>

      <ul class="list-none m-0 p-0 grid gap-4 sm:grid-cols-2">
        {feedLinks.map((feed) => (
          <li class="border border-[var(--line)] p-4 flex items-center justify-between gap-4">
            <div>
              <a href={feed.href} class="font-medium text-ink-900 no-underline hover:text-red-700 transition-colors">
                {feed.title}
              </a>
              <p class="mt-1 mb-0 subtext">
                {feed.note}
              </p>
            </div>
            <span class="mono-micro text-ink-400 shrink-0">
              {feed.href}
            </span>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
