---
// thanks.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Message sent" description="Got it. Your message is in my inbox.">
  <meta slot="head" name="robots" content="noindex" />

  <section class="page-thanks" data-hero>
    <div class="shell text-center">
      <h1 class="display" data-reveal="up" data-reveal-delay="0.05">
        Got it.
      </h1>
      <p class="lead mt-8 mx-auto max-w-[50ch]" data-reveal="up" data-reveal-delay="0.1">
        Your message is in my inbox. I read everything and usually reply within two days. If it's been longer than that, I'm probably mid-workshop — send it again, I won't mind.
      </p>
      <div class="mt-10" data-reveal="up" data-reveal-delay="0.16">
        <a href="/" class="btn btn-ghost">← Back home</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-thanks {
    display: flex;
    align-items: center;
    min-height: 70svh;
    padding-block: clamp(8rem, 6rem + 8vw, 12rem) 6rem;
  }
</style>
