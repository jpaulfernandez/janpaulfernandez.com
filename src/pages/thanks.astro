---
// thanks.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Message sent" description="Thank you for contacting me.">
  <meta slot="head" name="robots" content="noindex" />

  <article class="text-center">
    <h1 class="display m-0"><span class="flare">thanks.</span></h1>
    <p class="mt-4 mb-0 text-ink-700 text-body leading-relaxed">
      Your message has been sent. I'll get back to you as soon as I can.
    </p>
    <p class="mt-6 mb-0">
      <a href="/" class="text-ink-900 hover:text-wine-500 no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500 rounded-sm">← home</a>
    </p>
  </article>
</BaseLayout>
