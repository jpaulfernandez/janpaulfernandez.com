---
// thanks.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Message sent" description="Thank you for contacting me.">
  <meta slot="head" name="robots" content="noindex" />

  <article class="text-center">
    <h1 class="text-moss-900 m-0">thanks.</h1>
    <p class="mt-4 mb-0 text-moss-700 text-body leading-relaxed">
      Your message has been sent. I'll get back to you as soon as I can.
    </p>
    <p class="mt-6 mb-0">
      <a href="/" class="text-moss-900 hover:text-citrus-500 no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-citrus-500 rounded-sm">← home</a>
    </p>
  </article>
</BaseLayout>
