---
// index.astro (Thoughts index)
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostListItem from '../../components/PostListItem.astro';
import { getPublishedThoughts } from '../../lib/thoughts';

const allPosts = await getPublishedThoughts();

// Derive unique topics from actual posts
const allTopics = Array.from(
  new Set(allPosts.flatMap((post) => post.data.topics || []))
).sort();

const description =
  'Essays and notes from Paul Fernandez — on technology, economy, and psychology.';
---

<BaseLayout title="Thoughts" description={description}>
  <article style="--accent: var(--color-slate-500)">
    <header>
      <h1 class="m-0">Thoughts</h1>
      <p class="mt-8 mb-0 text-ink-700 text-body leading-relaxed max-w-prose">
        Essays and half-formed notes. About things that <span class="flare">bother me</span>.
      </p>
    </header>

    {allPosts.length > 0 ? (
      <>
        {/* Filter toolbar */}
        <div class="mt-12 md:mt-16 flex flex-col gap-4" role="group" aria-label="Filter thoughts">
          <div class="flex flex-wrap items-center gap-3">
            <div class="inline-flex border border-ink-200" data-filter-group="type">
              <button class="filter-chip cursor-pointer px-3 py-1 text-small text-ink-700 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500" aria-pressed="true" data-value="all">all</button>
              <button class="filter-chip cursor-pointer px-3 py-1 text-small text-ink-700 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500" aria-pressed="false" data-value="essay">essays</button>
              <button class="filter-chip cursor-pointer px-3 py-1 text-small text-ink-700 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500" aria-pressed="false" data-value="note">notes</button>
            </div>

            <span id="posts-counter" class="ml-auto text-small text-ink-500 tabular-nums">
              {allPosts.length} {allPosts.length === 1 ? 'thought' : 'thoughts'}
            </span>
            <div id="filter-aria-announcer" aria-live="polite" class="sr-only">
              Showing {allPosts.length} thoughts
            </div>
          </div>

          {allTopics.length > 0 && (
            <div class="flex flex-wrap gap-2" data-filter-group="topic">
              <button class="filter-chip cursor-pointer px-3 py-1 text-small text-ink-700 underline underline-offset-4 decoration-ink-200 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500" aria-pressed="true" data-value="all">all topics</button>
              {allTopics.map((topic) => (
                <button class="filter-chip cursor-pointer px-3 py-1 text-small text-ink-700 underline underline-offset-4 decoration-ink-200 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500" aria-pressed="false" data-value={topic}>
                  #{topic}
                </button>
              ))}
            </div>
          )}
        </div>

        <div id="posts-list" class="mt-8 divide-y divide-ink-200 border-t border-ink-200">
          {allPosts.map((post) => {
            const wordCount = post.body ? post.body.split(/\s+/).filter(Boolean).length : 0;
            const readingTime = Math.max(1, Math.ceil(wordCount / 200));

            return (
              <div
                class="post-row"
                data-type={post.data.type}
                data-topics={post.data.topics?.join(',')}
              >
                <PostListItem
                  title={post.data.title}
                  type={post.data.type}
                  topics={post.data.topics || []}
                  date={post.data.publishedDate}
                  excerpt={post.data.excerpt}
                  url={`/thoughts/${post.id}`}
                  readingTime={readingTime}
                  stage={post.data.stage}
                  cover={post.data.cover}
                />
              </div>
            );
          })}
        </div>

        <div id="empty-state" class="hidden text-center py-12 border border-ink-200 mt-8">
          <p class="text-ink-700 mb-2">No thoughts match this combo.</p>
          <p class="text-small text-ink-500">Reset filters to "all".</p>
        </div>
      </>
    ) : (
      <div class="mt-12 border-t border-ink-200 pt-6">
        <p class="text-ink-700 m-0">No thoughts published yet.</p>
      </div>
    )}
  </article>
</BaseLayout>

<style>
  /* Active filter state: drawn, not filled. The type segmented control marks
   * the pressed chip with a 2px inset rule; topic chips take the accent on
   * their existing underline. */
  [data-filter-group='type'] .filter-chip[aria-pressed='true'] {
    color: var(--color-slate-500);
    box-shadow: inset 0 -2px 0 0 var(--color-slate-500);
  }
  [data-filter-group='topic'] .filter-chip[aria-pressed='true'] {
    color: var(--color-slate-500);
    text-decoration-color: var(--color-slate-500);
  }
</style>

<!-- Native client-side DOM filter script (rung 4 progressive enhancement) -->
<script>
  const chips = document.querySelectorAll('.filter-chip');
  const rows = document.querySelectorAll('.post-row') as NodeListOf<HTMLElement>;
  const counter = document.getElementById('posts-counter');
  const announcer = document.getElementById('filter-aria-announcer');
  const emptyState = document.getElementById('empty-state');

  const activeFilters = {
    type: 'all',
    topic: 'all',
  };

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const parentGroup = chip.closest('[data-filter-group]') as HTMLElement | null;
      if (!parentGroup) return;

      const groupName = parentGroup.dataset.filterGroup;
      if (groupName !== 'type' && groupName !== 'topic') return;

      parentGroup.querySelectorAll('.filter-chip').forEach((c) => c.setAttribute('aria-pressed', 'false'));
      chip.setAttribute('aria-pressed', 'true');
      activeFilters[groupName] = chip.getAttribute('data-value') || 'all';

      let visibleCount = 0;
      rows.forEach((row) => {
        const rowType = row.getAttribute('data-type');
        const rowTopics = row.getAttribute('data-topics')?.split(',') || [];

        const matchesType = activeFilters.type === 'all' || rowType === activeFilters.type;
        const matchesTopic = activeFilters.topic === 'all' || rowTopics.includes(activeFilters.topic);

        if (matchesType && matchesTopic) {
          row.classList.remove('hidden');
          visibleCount++;
        } else {
          row.classList.add('hidden');
        }
      });

      const resultText = `${visibleCount} thought${visibleCount === 1 ? '' : 's'}`;
      if (counter) counter.textContent = resultText;
      if (announcer) announcer.textContent = `Showing ${resultText}`;

      if (visibleCount === 0) {
        emptyState?.classList.remove('hidden');
      } else {
        emptyState?.classList.add('hidden');
      }
    });
  });
</script>
