---
// index.astro (Thoughts index)
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostListItem from '../../components/PostListItem.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getPublishedThoughts } from '../../lib/thoughts';
import { blog, breadcrumbs } from '../../lib/schema';

const allPosts = await getPublishedThoughts();

// Derive unique topics from actual posts
const allTopics = Array.from(
  new Set(allPosts.flatMap((post) => post.data.topics || []))
).sort();

const description =
  'Essays and notes from Paul Fernandez — on technology, economy, and psychology.';

const seoData = [
  blog({
    title: 'Thoughts',
    description,
    url: '/thoughts/',
    posts: allPosts.map((post) => ({
      title: post.data.title,
      excerpt: post.data.excerpt,
      url: `/thoughts/${post.id}/`,
      publishedDate: post.data.publishedDate,
      updatedDate: post.data.updatedDate,
    })),
  }),
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'Thoughts', url: '/thoughts/' },
  ]),
];
---

<BaseLayout title="Thoughts" description={description} ogImage="/og/thoughts.png">
  <JsonLd slot="head" data={seoData} />

  <section class="page-head" data-hero>
    <div class="shell">
      <h1 class="display" data-reveal="up" data-reveal-delay="0.05">Thoughts</h1>
      <p class="lead mt-8" data-reveal="up" data-reveal-delay="0.1">
        Essays and half-formed notes. About things that
        bother me.
      </p>
    </div>
  </section>

  <div class="shell pb-24 md:pb-32">
    {allPosts.length > 0 ? (
      <>
        {/* Filters. Vanilla DOM toggling, no island — see the script below. */}
        <div class="filter-bar" role="group" aria-label="Filter thoughts">
          <div class="flex flex-wrap items-center gap-4">
            <div class="segmented" data-filter-group="type">
              <button class="filter-chip seg" aria-pressed="true" data-value="all">All</button>
              <button class="filter-chip seg" aria-pressed="false" data-value="essay">Essays</button>
              <button class="filter-chip seg" aria-pressed="false" data-value="note">Notes</button>
            </div>

            <span id="posts-counter" class="mono-micro ml-auto">
              {allPosts.length} {allPosts.length === 1 ? 'thought' : 'thoughts'}
            </span>
            <div id="filter-aria-announcer" aria-live="polite" class="sr-only">
              Showing {allPosts.length} thoughts
            </div>
          </div>

          {allTopics.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-2" data-filter-group="topic">
              <button class="filter-chip tag" aria-pressed="true" data-value="all">
                All topics
              </button>
              {allTopics.map((topic) => (
                <button class="filter-chip tag" aria-pressed="false" data-value={topic}>
                  {topic}
                </button>
              ))}
            </div>
          )}
        </div>

        <div id="posts-list" class="rows mt-4" data-reveal-stagger>
          {allPosts.map((post) => {
            const wordCount = post.body ? post.body.split(/\s+/).filter(Boolean).length : 0;
            const readingTime = Math.max(1, Math.ceil(wordCount / 200));

            return (
              <div
                class="post-row"
                data-reveal="up"
                data-type={post.data.type}
                data-topics={post.data.topics?.join(',')}
              >
                <PostListItem
                  title={post.data.title}
                  type={post.data.type}
                  topics={post.data.topics || []}
                  date={post.data.publishedDate}
                  excerpt={post.data.excerpt}
                  url={`/thoughts/${post.id}/`}
                  readingTime={readingTime}
                  stage={post.data.stage}
                  cover={post.data.cover}
                />
              </div>
            );
          })}
        </div>

        <div id="empty-state" class="hidden panel text-center py-16 mt-8">
          <p class="text-paper-100 m-0">No thoughts match this combo.</p>
          <p class="mono-micro mt-3">Reset the filters to "all"</p>
        </div>
      </>
    ) : (
      <div class="panel p-10">
        <p class="text-paper-400 m-0">No thoughts published yet.</p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(8rem, 6rem + 8vw, 12rem) clamp(3rem, 2rem + 4vw, 5rem);
  }

  .filter-bar {
    padding-block: 1.5rem;
    border-block: 1px solid var(--line);
  }

  /* Type filter — one box split into segments, so the three options read as
   * a single control rather than three loose buttons. Phase 21 squared it off
   * and dropped the fill; it is a control, so it keeps its border. */
  .segmented {
    display: inline-flex;
    padding: 0.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }
  .seg {
    padding: 0.4375rem 1rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-paper-400);
    cursor: pointer;
    background: transparent;
    border: 0;
    transition: background-color 0.22s var(--ease-out-quint), color 0.22s var(--ease-out-quint);
  }
  .seg:hover { color: var(--color-paper-50); }
  .seg[aria-pressed='true'] {
    background-color: var(--color-paper-50);
    color: var(--color-ink-950);
  }

  /* Topic filter — reuses the global .tag chip; only the pressed state and
   * the cursor differ from the read-only version. */
  .filter-chip.tag { cursor: pointer; }
  /* Phase 21: matches the inverted .tag[data-active] in global.css — a filter
   * that is ON should be unmissable without spending the accent on it. */
  .filter-chip.tag[aria-pressed='true'] {
    color: var(--color-ink-950);
    background-color: var(--color-paper-100);
    border-color: var(--color-paper-100);
  }

  .rows > .post-row { border-bottom: 1px solid var(--line); }

  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>

<!-- Native client-side DOM filter script (rung 4 progressive enhancement) -->
<script>
  const chips = document.querySelectorAll('.filter-chip');
  const rows = document.querySelectorAll('.post-row') as NodeListOf<HTMLElement>;
  const counter = document.getElementById('posts-counter');
  const announcer = document.getElementById('filter-aria-announcer');
  const emptyState = document.getElementById('empty-state');

  const activeFilters = {
    type: 'all',
    topic: 'all',
  };

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const parentGroup = chip.closest('[data-filter-group]') as HTMLElement | null;
      if (!parentGroup) return;

      const groupName = parentGroup.dataset.filterGroup;
      if (groupName !== 'type' && groupName !== 'topic') return;

      parentGroup.querySelectorAll('.filter-chip').forEach((c) => c.setAttribute('aria-pressed', 'false'));
      chip.setAttribute('aria-pressed', 'true');
      activeFilters[groupName] = chip.getAttribute('data-value') || 'all';

      let visibleCount = 0;
      rows.forEach((row) => {
        const rowType = row.getAttribute('data-type');
        const rowTopics = row.getAttribute('data-topics')?.split(',') || [];

        const matchesType = activeFilters.type === 'all' || rowType === activeFilters.type;
        const matchesTopic = activeFilters.topic === 'all' || rowTopics.includes(activeFilters.topic);

        if (matchesType && matchesTopic) {
          row.classList.remove('hidden');
          visibleCount++;
        } else {
          row.classList.add('hidden');
        }
      });

      const resultText = `${visibleCount} thought${visibleCount === 1 ? '' : 's'}`;
      if (counter) counter.textContent = resultText;
      if (announcer) announcer.textContent = `Showing ${resultText}`;

      if (visibleCount === 0) {
        emptyState?.classList.remove('hidden');
      } else {
        emptyState?.classList.add('hidden');
      }
    });
  });
</script>
