---
// [topic].astro (Topic archive pages)
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostListItem from '../../components/PostListItem.astro';
import { getPublishedThoughts } from '../../lib/thoughts';

export async function getStaticPaths() {
  const allPosts = await getPublishedThoughts();
  const topics = Array.from(
    new Set(allPosts.flatMap((post) => post.data.topics || []))
  );

  return topics.map((topic) => ({
    params: { topic },
    props: { posts: allPosts.filter((post) => post.data.topics?.includes(topic)), topic },
  }));
}

const { posts, topic } = Astro.props;
const description = `Posts tagged #${topic} by Paul Fernandez.`;
---

<BaseLayout title={`#${topic}`} description={description}>
  <article>
    <header>
      <p class="m-0 text-small text-ink-500">
        <a href="/thoughts" class="text-ink-500 hover:text-ink-900 no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-wine-500 rounded-sm">← all thoughts</a>
      </p>
      <h1 class="display m-0 mt-3"><span class="flare">#</span>{topic}</h1>
      <p class="mt-3 mb-0 text-ink-700 text-small tabular-nums">
        {posts.length} {posts.length === 1 ? 'post' : 'posts'}
      </p>
    </header>

    <div class="mt-12 divide-y divide-ink-200 border-t border-ink-200">
      {posts.map((post) => {
        const wordCount = post.body ? post.body.split(/\s+/).filter(Boolean).length : 0;
        const readingTime = Math.max(1, Math.ceil(wordCount / 200));

        return (
          <PostListItem
            title={post.data.title}
            type={post.data.type}
            topics={post.data.topics || []}
            date={post.data.publishedDate}
            excerpt={post.data.excerpt}
            url={`/thoughts/${post.id}`}
            readingTime={readingTime}
            stage={post.data.stage}
            cover={post.data.cover}
          />
        );
      })}
    </div>
  </article>
</BaseLayout>
