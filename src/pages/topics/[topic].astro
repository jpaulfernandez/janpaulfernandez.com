---
// [topic].astro (Topic archive pages)
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostListItem from '../../components/PostListItem.astro';
import JsonLd from '../../components/JsonLd.astro';
import { getPublishedThoughts } from '../../lib/thoughts';
import { collectionPage, breadcrumbs } from '../../lib/schema';

export async function getStaticPaths() {
  const allPosts = await getPublishedThoughts();
  const topics = Array.from(
    new Set(allPosts.flatMap((post) => post.data.topics || []))
  );

  return topics.map((topic) => ({
    params: { topic },
    props: { posts: allPosts.filter((post) => post.data.topics?.includes(topic)), topic },
  }));
}

// A line per topic, in Paul's voice. These are the page's meta description and
// its visible intro — without them every archive shipped the same templated
// "Posts tagged #x" sentence, which reads as duplicate content across nine
// near-identical pages. Add a line here when a new topic appears; the fallback
// below keeps an unlisted topic from breaking the build.
const TOPIC_INTROS: Record<string, string> = {
  ai: 'What AI actually changes — the unit economics of tokens, agentic workflows, and what human work is for once the machines can do it.',
  culture: 'On predigested culture, snack-sized media, and what gets lost when a story is optimised for the scroll.',
  engineering: 'The practical craft of shipping — tools, models, and the decisions that only show up once you build the thing.',
  media: 'Media diets, recommendation engines, and the shape attention takes when something else is choosing for you.',
  philosophy: 'The bigger questions underneath the tooling — meaning, boredom, and why we do anything at all.',
  product: 'How things actually get built — briefs, scope, red-teaming your own ideas, and knowing what is worth shipping.',
  psychology: 'Why we behave the way we do — attention, satisfaction, and the psychology sitting under the product.',
  technology: 'Technology as it lands on real people — the systems, the incentives, and the second-order effects.',
  workflows: 'How the work gets done — AI-assisted workflows, research agents, and the process behind the output.',
};

const { posts, topic } = Astro.props;

const intro = TOPIC_INTROS[topic] ?? `Essays and notes tagged #${topic}.`;
const description = `${intro} ${posts.length} ${posts.length === 1 ? 'post' : 'posts'} by Paul Fernandez.`;

const seoData = [
  collectionPage({
    title: `#${topic}`,
    description,
    url: `/topics/${topic}/`,
    items: posts.map((post) => ({
      name: post.data.title,
      url: `/thoughts/${post.id}/`,
    })),
  }),
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'Thoughts', url: '/thoughts/' },
    { name: `#${topic}`, url: `/topics/${topic}/` },
  ]),
];
---

<BaseLayout title={`#${topic}`} description={description}>
  <JsonLd slot="head" data={seoData} />

  <section class="page-head" data-hero>
    <div class="shell">
      <a href="/thoughts/" class="mono-micro hover:text-paper-50" data-reveal="fade">
        ← All thoughts
      </a>
      <h1 class="display mt-6" data-reveal="up" data-reveal-delay="0.05">
        #{topic}
      </h1>
      <p class="lead mt-8" data-reveal="up" data-reveal-delay="0.1">{intro}</p>
      <p class="mono-micro mt-6" data-reveal="fade" data-reveal-delay="0.16">
        {posts.length} {posts.length === 1 ? 'post' : 'posts'}
      </p>
    </div>
  </section>

  <div class="shell pb-24 md:pb-32">
    <ul class="rows" data-reveal-stagger>
      {posts.map((post) => {
        const wordCount = post.body ? post.body.split(/\s+/).filter(Boolean).length : 0;
        const readingTime = Math.max(1, Math.ceil(wordCount / 200));

        return (
          <li data-reveal="up">
            <PostListItem
              title={post.data.title}
              type={post.data.type}
              topics={post.data.topics || []}
              date={post.data.publishedDate}
              excerpt={post.data.excerpt}
              url={`/thoughts/${post.id}/`}
              readingTime={readingTime}
              stage={post.data.stage}
              cover={post.data.cover}
            />
          </li>
        );
      })}
    </ul>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(8rem, 6rem + 8vw, 12rem) clamp(3rem, 2rem + 4vw, 5rem);
  }
</style>
