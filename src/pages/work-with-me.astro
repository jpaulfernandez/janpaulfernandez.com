---
// work-with-me.astro — rebuild-plan §5.5, task 32.4. Four sections: head,
// three ways in, the program (the page's one .panel-tint), enquire + FAQ.
// Zero client JS (README rule 7): the rows link to #enquire and the select is
// not preset (README departure 3).
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import ProgramSteps from '../components/ProgramSteps.astro';
import TierTable from '../components/TierTable.astro';
import { service, faqPage, webPage, breadcrumbs, person } from '../lib/schema';

const entry = await getEntry('workWithMe', 'workWithMe');
const programPage = await getEntry('programPage', 'program');
if (!entry || !programPage) {
  throw new Error('workWithMe or programPage singleton is missing.');
}
const { Content: Intro } = await render(entry);
const { modes, faq } = entry.data;
const program = programPage.data;
const tiers = (await getCollection('program')).sort((a, b) => a.data.order - b.data.order);

const PROGRAM_URL = '/work-with-me/ai-resilient-organisation/';
const AREA = 'Philippines';

const description =
  'Work with Paul Fernandez on AI and service design in the Philippines: build it together, have it built for you, or get advice. Enquire for a quote.';

const steps = [
  'A 20-minute scoping call.',
  'A one-page proposal within two working days.',
  'If it fits, we start.',
];

const interestOptions = [
  'Not sure yet',
  ...modes.map((m) => m.name),
  ...tiers.map((t) => t.data.title),
  'Something else',
];

const seoData = [
  webPage({ url: '/work-with-me/', name: 'Work with me', description }),
  ...modes.map((m) =>
    service({
      title: m.name,
      description: m.line,
      url: `/work-with-me/#${m.anchor}`,
      areaServed: AREA,
    })
  ),
  service({
    title: 'AI-Resilient Organisation',
    description: program.sub,
    url: PROGRAM_URL,
    areaServed: AREA,
  }),
  faqPage(faq),
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'Work with me', url: '/work-with-me/' },
  ]),
  // One person() so the provider @id resolves in this document.
  person(),
];
---

<BaseLayout title="Work with me" description={description} ogImage="/og/work-with-me.png">
  <JsonLd data={seoData} slot="head" />

  <div class="shell">
    {/* Head — opens the page; no rule. */}
    <section class="section">
      <h1 class="display">Work with me</h1>
      <div class="prose intro mt-10">
        <Intro />
      </div>
    </section>

    {/* Three ways in — ruled rows, not cards. */}
    <section class="section section-ruled" aria-labelledby="ways-heading">
      <h2 id="ways-heading" class="kicker">Three ways in</h2>
      <ul class="rows mt-8">
        {modes.map((mode) => (
          <li id={mode.anchor} class="mode">
            <div>
              <h3 class="m-0">{mode.name}</h3>
              <p class="subtext mt-4 mb-0 max-w-[40ch]">{mode.line}</p>
            </div>
            <div>
              <dl class="facts">
                <div>
                  <dt class="mono-micro">Who it's for</dt>
                  <dd>{mode.whoFor}</dd>
                </div>
                <div>
                  <dt class="mono-micro">How it runs</dt>
                  <dd>{mode.runsAs}</dd>
                </div>
                <div>
                  <dt class="mono-micro">Price</dt>
                  <dd>{mode.priceSignal}</dd>
                </div>
              </dl>
              <a href="#enquire" class="link-arrow mt-6">
                Enquire about this<span class="sr-only">: {mode.name}</span>
              </a>
            </div>
          </li>
        ))}
      </ul>
      <p class="subtext mt-8 mb-0">I also do 1-on-1 sessions — ask.</p>
    </section>

    {/* The program — the page's only tinted block. */}
    <section class="section section-ruled" aria-labelledby="program-heading">
      <h2 id="program-heading" class="kicker">The program</h2>
      <div class="panel-tint program mt-8">
        <h3 class="program-name m-0">AI-Resilient Organisation</h3>
        <p class="subtext mt-4 mb-0 max-w-[60ch]">{program.headline} {program.sub}</p>

        <div class="mt-10">
          <ProgramSteps steps={program.steps} />
        </div>

        <div class="mt-12">
          <TierTable
            id="wwm-tiers"
            tiers={tiers}
            caption="The five tiers of the AI-Resilient Organisation program"
          />
        </div>

        <a href={PROGRAM_URL} class="link-arrow mt-8">See the program</a>
      </div>
    </section>

    {/* Enquire — the header's "Book a scoping call" lands here. */}
    <section id="enquire" class="section section-ruled" aria-labelledby="enquire-heading">
      <h2 id="enquire-heading" class="kicker">Enquire</h2>

      <div class="enquire mt-10">
        <div>
          <p class="statement-sm max-w-[16ch]">Tell me what you're working on.</p>
          <p class="subtext mt-6 mb-0">
            Or email me:
            <a href="mailto:jpaul.fernandez18@gmail.com" class="link">jpaul.fernandez18@gmail.com</a>
          </p>

          <h3 class="kicker mt-12">What happens next</h3>
          <ol class="next mt-4">
            {steps.map((s, i) => (
              <li>
                <span class="mono-micro" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span>{s}</span>
              </li>
            ))}
          </ol>
        </div>

        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="panel form"
        >
          <input type="hidden" name="access_key" value="3adf4959-3a04-4fc5-a990-e1159605181f" />
          <input type="hidden" name="redirect" value="https://www.janpaulfernandez.com/thanks/" />
          <input type="hidden" name="subject" value="New Contact Form Submission from janpaulfernandez.com" />
          <input type="hidden" name="from_name" value="Jan Paul Fernandez Website" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

          <div>
            <label for="name" class="field-label">Name</label>
            <input type="text" id="name" name="name" autocomplete="name" required class="field" />
          </div>

          <div>
            <label for="email" class="field-label">Email</label>
            <input type="email" id="email" name="email" autocomplete="email" required class="field" />
          </div>

          <div>
            <label for="organisation" class="field-label">Organisation (optional)</label>
            <input type="text" id="organisation" name="organisation" autocomplete="organization" class="field" />
          </div>

          <div>
            <label for="interested_in" class="field-label">Interested in</label>
            <select id="interested_in" name="interested_in" class="field">
              {interestOptions.map((o) => <option value={o}>{o}</option>)}
            </select>
          </div>

          <div>
            <label for="message" class="field-label">Message</label>
            <textarea id="message" name="message" required rows="5" class="field"></textarea>
          </div>

          <button type="submit" class="btn btn-primary self-start">Send it</button>
        </form>
      </div>

      <h3 class="kicker mt-24" id="faq-heading">Questions</h3>
      <div class="faq-list mt-4">
        {faq.map((item) => (
          <details class="faq">
            <summary>
              <span>{item.q}</span>
              <span class="faq-mark" aria-hidden="true">+</span>
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .intro { color: var(--color-ink-600); }

  /* Mode rows: name and line left, the facts right; one hairline between. */
  .mode {
    display: grid;
    gap: 1.5rem 3rem;
    padding-block: var(--space-l);
  }
  .facts { display: grid; gap: 1rem; }
  .facts dd { margin: 0.25rem 0 0; color: var(--color-ink-600); max-width: 52ch; }

  .program-name {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--text-h2);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .enquire { display: grid; gap: 3rem 4rem; }
  .form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: var(--space-m);
  }

  .next { list-style: none; padding: 0; }
  .next li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    align-items: baseline;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .faq-list { max-width: 48rem; }

  @media (min-width: 64rem) {
    .mode { grid-template-columns: 1fr 1.2fr; }
    .enquire { grid-template-columns: 0.9fr 1.1fr; align-items: start; }
  }
</style>
