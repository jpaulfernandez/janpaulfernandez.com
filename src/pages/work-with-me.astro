---
// work-with-me.astro
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { service, faqPage, breadcrumbs } from '../lib/schema';

const workWithMeEntry = await getEntry('workWithMe', 'workWithMe');
if (!workWithMeEntry) {
  throw new Error('Work with me page singleton is missing. Run seed scripts first.');
}
const { Content: IntroContent } = await render(workWithMeEntry);

const services = await getCollection('services');
const sortedServices = services.sort((a, b) => a.data.order - b.data.order);

const faqItems = sortedServices.flatMap((s) => s.data.faq || []);

const serviceSchemas = sortedServices.map((s) =>
  service({ title: s.data.title, description: s.data.description })
);
const faqSchema = faqItems.length > 0 ? faqPage(faqItems) : null;
const breadcrumbsSchema = breadcrumbs([
  { name: 'Home', url: '/' },
  { name: 'Work with me', url: '/work-with-me' },
]);

const seoData = [
  ...serviceSchemas,
  ...(faqSchema ? [faqSchema] : []),
  breadcrumbsSchema,
];

const description =
  'Work with Paul Fernandez: digital transformation consulting, talks and workshops, fractional product ownership.';

const steps = [
  {
    title: '1. discovery call',
    body: '30 minutes, free. Map the problem, weigh options, and define success.',
  },
  {
    title: '2. proposal',
    body: 'A clear scope — deliverables, milestones, cadence, and a fixed cost. No vague retainers.',
  },
  {
    title: '3. hands-on',
    body: 'Advisory sessions, workshops, or embedded product ownership, with transparent checkpoints.',
  },
];
---

<BaseLayout title="Work with me" description={description}>
  <JsonLd data={seoData} slot="head" />

  <article>
    <header>
      <h1 class="text-moss-900 m-0">Work</h1>
      <div class="prose mt-6 text-moss-700 max-w-[64ch]">
        <IntroContent />
      </div>
    </header>

    {/* Services */}
    {sortedServices.length > 0 && (
      <section class="mt-16 md:mt-20 border-t border-moss-200 pt-6" aria-labelledby="services-heading">
        <h2 id="services-heading" class="font-mono uppercase text-xs tracking-widest text-moss-500 m-0 mb-4">
          services
        </h2>
        <ul class="list-none m-0 p-0 flex flex-col">
          {sortedServices.map((s) => (
            <li class="py-3 border-t border-moss-200 first:border-t-0">
              <h3 class="font-bold text-moss-900 m-0">{s.data.title}</h3>
              <p class="text-moss-700 m-0 mt-1 text-body">{s.data.description}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* How it works */}
    <section class="mt-16 md:mt-20 border-t border-moss-200 pt-6" aria-labelledby="process-heading">
      <h2 id="process-heading" class="font-mono uppercase text-xs tracking-widest text-moss-500 m-0 mb-4">
        how it works
      </h2>
      <ol class="m-0 p-0 flex flex-col gap-3 list-none">
        {steps.map((step) => (
          <li>
            <span class="font-bold text-moss-900">{step.title}</span>
            <span class="text-moss-700"> — {step.body}</span>
          </li>
        ))}
      </ol>
    </section>

    {/* FAQ */}
    {faqItems.length > 0 && (
      <section class="mt-16 md:mt-20 border-t border-moss-200 pt-6" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="font-mono uppercase text-xs tracking-widest text-moss-500 m-0 mb-4">
          faq
        </h2>
        <div class="flex flex-col">
          {faqItems.map((item) => (
            <details class="group py-3 border-t border-moss-200 first:border-t-0 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex justify-between items-baseline gap-4 font-bold text-body text-moss-900 cursor-pointer list-none focus:outline-none focus-visible:ring-2 focus-visible:ring-citrus-500 rounded-sm">
                <span class="leading-snug">{item.q}</span>
                <span class="transition-transform group-open:rotate-180 shrink-0 text-moss-500 text-small" aria-hidden="true">+</span>
              </summary>
              <p class="mt-2 mb-0 text-body text-moss-700 leading-relaxed">{item.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    {/* Contact */}
    <section id="contact" class="mt-16 md:mt-20 border-t border-moss-200 pt-6" aria-labelledby="contact-heading">
      <h2 id="contact-heading" class="font-mono uppercase text-xs tracking-widest text-moss-500 m-0 mb-4">
        get in touch
      </h2>
      <p class="text-body text-moss-700 mb-6">
        Form, or <a href="mailto:jpaul.fernandez18@gmail.com" class="text-moss-900 hover:text-citrus-500 no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-citrus-500 rounded-sm">jpaul.fernandez18@gmail.com</a>.
      </p>

      <form
        action="https://api.web3forms.com/submit"
        method="POST"
        class="flex flex-col gap-4"
      >
        <input type="hidden" name="access_key" value="3adf4959-3a04-4fc5-a990-e1159605181f" />
        <input type="hidden" name="redirect" value="https://janpaulfernandez.com/thanks" />
        <input type="hidden" name="subject" value="New Contact Form Submission from janpaulfernandez.com" />
        <input type="hidden" name="from_name" value="Jan Paul Fernandez Website" />
        <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

        <div>
          <label for="name" class="block text-small text-moss-700 mb-1">name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full bg-beige-50 border border-moss-200 px-3 py-3 text-body text-moss-900 focus:outline-none focus:border-moss-900 transition-colors"
          />
        </div>

        <div>
          <label for="email" class="block text-small text-moss-700 mb-1">email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full bg-beige-50 border border-moss-200 px-3 py-3 text-body text-moss-900 focus:outline-none focus:border-moss-900 transition-colors"
          />
        </div>

        <div>
          <label for="message" class="block text-small text-moss-700 mb-1">message</label>
          <textarea
            id="message"
            name="message"
            required
            rows="4"
            class="w-full bg-beige-50 border border-moss-200 px-3 py-3 text-body text-moss-900 focus:outline-none focus:border-moss-900 transition-colors"
          ></textarea>
        </div>

        <button
          type="submit"
          class="self-start bg-moss-900 hover:bg-citrus-500 text-beige-100 hover:text-moss-900 font-bold px-6 py-3 cursor-pointer transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-citrus-500"
        >
          send →
        </button>
      </form>
    </section>
  </article>
</BaseLayout>
