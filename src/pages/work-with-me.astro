---
// work-with-me.astro
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { service, faqPage, breadcrumbs } from '../lib/schema';

const workWithMeEntry = await getEntry('workWithMe', 'workWithMe');
if (!workWithMeEntry) {
  throw new Error('Work with me page singleton is missing. Run seed scripts first.');
}
const { Content: IntroContent } = await render(workWithMeEntry);

const services = await getCollection('services');
const sortedServices = services.sort((a, b) => a.data.order - b.data.order);

const faqItems = sortedServices.flatMap((s) => s.data.faq || []);

const serviceSchemas = sortedServices.map((s) =>
  service({ title: s.data.title, description: s.data.description })
);
const faqSchema = faqItems.length > 0 ? faqPage(faqItems) : null;
const breadcrumbsSchema = breadcrumbs([
  { name: 'Home', url: '/' },
  { name: 'Work with me', url: '/work-with-me/' },
]);

const seoData = [
  ...serviceSchemas,
  ...(faqSchema ? [faqSchema] : []),
  breadcrumbsSchema,
];

const description =
  'Work with Paul Fernandez: digital transformation consulting, talks and workshops, fractional product ownership.';

const steps = [
  {
    title: 'Discovery call',
    body: '30 minutes, free. Map the problem, weigh options, and define success.',
  },
  {
    title: 'Proposal',
    body: 'A clear scope — deliverables, milestones, cadence, and a fixed cost. No vague retainers.',
  },
  {
    title: 'Hands-on',
    body: 'Advisory sessions, workshops, or embedded product ownership, with transparent checkpoints.',
  },
];
---

<BaseLayout title="Work with me" description={description} ogImage="/og/work-with-me.png">
  <JsonLd data={seoData} slot="head" />

  <section class="page-head" data-hero>
    <div class="shell">
      <p class="kicker" data-reveal="fade">Services</p>
      <h1 class="display mt-8 max-w-[14ch]" data-reveal="up" data-reveal-delay="0.05">
        Work <span class="flare">with me</span>
      </h1>
      <div class="prose mt-8 max-w-[54ch]" data-reveal="up" data-reveal-delay="0.1">
        <IntroContent />
      </div>
      <div class="mt-10 flex flex-wrap gap-3" data-reveal="up" data-reveal-delay="0.16">
        <a href="#contact" class="btn btn-primary">Start a conversation</a>
      </div>
    </div>
  </section>

  <div class="shell pb-24 md:pb-32">
    {/* Services — number on the left, name at h2 scale, copy on the right. */}
    {sortedServices.length > 0 && (
      <section aria-labelledby="services-heading">
        <h2 id="services-heading" class="kicker">What I offer</h2>
        <ul class="rows mt-8" data-reveal-stagger>
          {sortedServices.map((s, i) => (
            <li data-reveal="up">
              <div class="grid md:grid-cols-[1fr_1.3fr] gap-x-12 gap-y-5 py-10">
                <div>
                  <span class="mono-micro block mb-4 text-wine-400">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <h3 class="m-0 text-h2 leading-[1.05]">{s.data.title}</h3>
                </div>
                <p class="m-0 text-paper-400 leading-relaxed self-center">
                  {s.data.description}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* How it works */}
    <section class="section" aria-labelledby="process-heading">
      <h2 id="process-heading" class="kicker">How it works</h2>
      <ol class="mt-12 grid gap-4 md:grid-cols-3 list-none m-0 p-0" data-reveal-stagger>
        {steps.map((step, i) => (
          <li class="card p-8" data-reveal="up">
            <span class="mono-micro">Step {String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-6">{step.title}</h3>
            <p class="mt-4 mb-0 text-small text-paper-400 leading-relaxed">{step.body}</p>
          </li>
        ))}
      </ol>
    </section>

    {/* FAQ */}
    {faqItems.length > 0 && (
      <section class="section-tight" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="kicker">Questions</h2>
        <div class="mt-8" data-reveal-stagger>
          {faqItems.map((item) => (
            <details class="faq" data-reveal="fade">
              <summary>
                <span>{item.q}</span>
                <span class="faq-mark" aria-hidden="true">+</span>
              </summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    {/* Contact */}
    <section id="contact" class="section-tight" aria-labelledby="contact-heading">
      <h2 id="contact-heading" class="kicker">Get in touch</h2>

      <div class="mt-10 grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div>
          <p class="statement-sm max-w-[16ch]" data-split="lines">
            Tell me what you're <span class="flare">trying to build</span>.
          </p>
          <p class="mt-8 mb-0 text-paper-400 text-small">
            Or skip the form —
            <a href="mailto:jpaul.fernandez18@gmail.com" class="link">
              jpaul.fernandez18@gmail.com
            </a>
          </p>
        </div>

        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="panel p-6 md:p-8 flex flex-col gap-5"
          data-reveal="up"
        >
          <input type="hidden" name="access_key" value="3adf4959-3a04-4fc5-a990-e1159605181f" />
          <input type="hidden" name="redirect" value="https://www.janpaulfernandez.com/thanks/" />
          <input type="hidden" name="subject" value="New Contact Form Submission from janpaulfernandez.com" />
          <input type="hidden" name="from_name" value="Jan Paul Fernandez Website" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

          <div>
            <label for="name" class="field-label">Name</label>
            <input type="text" id="name" name="name" autocomplete="name" required class="field" />
          </div>

          <div>
            <label for="email" class="field-label">Email</label>
            <input type="email" id="email" name="email" autocomplete="email" required class="field" />
          </div>

          <div>
            <label for="message" class="field-label">Message</label>
            <textarea id="message" name="message" required rows="5" class="field"></textarea>
          </div>

          <button type="submit" class="btn btn-primary self-start">Send it →</button>
        </form>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(8rem, 6rem + 8vw, 12rem) clamp(3rem, 2rem + 4vw, 5rem);
  }

  .statement-sm {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--color-paper-50);
    margin: 0;
  }

  /* ---- FAQ ------------------------------------------------------------- */
  .faq { border-bottom: 1px solid var(--line); }
  .faq summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.25rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: var(--text-body);
    font-weight: 500;
    color: var(--color-paper-100);
    transition: color 0.3s var(--ease-out-quint);
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary:hover { color: var(--color-paper-50); }
  .faq-mark {
    flex-shrink: 0;
    color: var(--color-paper-400);
    font-size: 1.125rem;
    line-height: 1;
    transition: transform 0.35s var(--ease-out-quint);
  }
  .faq[open] .faq-mark { transform: rotate(45deg); }
  .faq[open] summary { color: var(--color-paper-50); }
  .faq p {
    margin: 0 0 1.5rem;
    max-width: 68ch;
    color: var(--color-paper-400);
    line-height: 1.7;
  }

  /* ---- Form ------------------------------------------------------------ */
  .field-label {
    display: block;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-paper-400);
  }
  .field {
    width: 100%;
    padding: 0.875rem 1rem;
    background-color: var(--color-ink-700);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--color-paper-50);
    font-family: var(--font-body);
    font-size: var(--text-body);
    transition:
      border-color 0.3s var(--ease-out-quint),
      background-color 0.3s var(--ease-out-quint);
  }
  .field::placeholder { color: var(--color-paper-600); }
  .field:hover { border-color: var(--line-strong); }
  .field:focus {
    border-color: var(--color-wine-400);
    background-color: var(--color-ink-800);
  }
  textarea.field { resize: vertical; min-height: 8rem; }
</style>
