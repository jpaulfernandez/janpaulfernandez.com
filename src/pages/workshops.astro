---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { service, faqPage, breadcrumbs } from '../lib/schema';
import {
  availability,
  audienceRoutes,
  enquireLabel,
  enquiryValue,
  enterpriseOfferings,
  faqItems,
  findOffering,
  fit,
  marketStats,
  offerings,
  personalOfferings,
  process,
  trackIntro,
} from '../lib/workshops';
import portrait from '../assets/paul.webp';

const personal = personalOfferings();
const enterprise = enterpriseOfferings();
const fluency = findOffering('fluency');

const description =
  'Demystifying AI: A few hours on the work you actually have open, until it stops feeling like a magic trick and starts doing something useful. Seats and one-on-ones from ₱2,500; team sessions from ₱90,000.';

const seoData = [
  service({
    title: 'AI workshops and talks',
    description:
      'AI fluency and media literacy, vibe coding for non-engineers, AI for leadership with a policy exercise, and keynotes. Booked one-on-one, as open Zoom cohorts, or in-house for teams in the Philippines.',
  }),
  faqPage(faqItems),
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'Workshops', url: '/workshops/' },
  ]),
];
---

<BaseLayout title="Demystifying AI" description={description} ogImage="/og/workshops.png">
  <JsonLd data={seoData} slot="head" />

  {/* ---------------------------------------------------------------------
      HERO. Outcome-led headline, grounded tone, and clear primary CTA.
     --------------------------------------------------------------------- */}
  <section class="page-head" data-hero>
    <div class="shell">
      <p class="mono-micro flex items-center gap-3" data-reveal="fade">
        <span class="h-px w-8 bg-[var(--line-strong)]"></span>
        Demystifying AI · Manila &amp; remote · English · PHT
      </p>

      <h1 class="display hero-display mt-8" data-reveal="up" data-reveal-delay="0.05">
        You already use AI.<br class="hidden sm:inline" /> This is where you get good at it.
      </h1>

      <p class="lead mt-8 max-w-[54ch]" data-reveal="up" data-reveal-delay="0.12">
        No hype and no doomsaying — just a few hours on the work you already have open.
        By the end, the parts that felt like magic feel like something you can direct.
        Book a seat, a one-on-one, or bring me in to run it on your team's real tools and documents.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4" data-reveal="up" data-reveal-delay="0.18">
        <a href="#enquire" class="btn btn-primary">Talk to me</a>
        <a href="#personal" class="link-arrow">Seats and one-on-ones from ₱2,500</a>
      </div>
    </div>
  </section>

  <div class="shell pb-24 md:pb-32">
    {/* -------------------------------------------------------------------
        ROUTER. Three audiences, two doors. A one-line triage, not a section.
       ------------------------------------------------------------------- */}
    <section class="routes" aria-labelledby="routes-heading" data-reveal-stagger>
      <h2 id="routes-heading" class="sr-only">Who is asking</h2>
      {audienceRoutes.map((route) => (
        <a href={route.href} class="route" data-reveal="fade">
          <span class="route__label">{route.label}</span>
          <span class="route__line">{route.line}</span>
          <span class="route__mark" aria-hidden="true">→</span>
        </a>
      ))}
    </section>

    {/* -------------------------------------------------------------------
        THE THESIS. A diagram made of a hairline and two lists — the whole
        argument for why fluency and media literacy are one session.
       ------------------------------------------------------------------- */}
    <section class="section-tight" aria-labelledby="thesis-heading">
      <h2 id="thesis-heading" class="kicker">The two halves</h2>

      <div class="thesis mt-10" data-reveal="up">
        <div class="thesis__side">
          <p class="thesis__head">What AI makes <em>for</em> you</p>
          <ul class="thesis__list">
            <li>Drafts, summaries, first passes</li>
            <li>Code you did not write</li>
            <li>A prototype by lunchtime</li>
            <li>The dull half of your job</li>
          </ul>
          <p class="thesis__flow"><span aria-hidden="true">←</span> you aim it</p>
        </div>

        <div class="thesis__side thesis__side--right">
          <p class="thesis__head">What AI makes <em>at</em> you</p>
          <ul class="thesis__list">
            <li>A video of a speech never given</li>
            <li>A citation to a paper that does not exist</li>
            <li>A scam in a voice you recognise</li>
            <li>A feed tuned to move you</li>
          </ul>
          <p class="thesis__flow">it arrives anyway <span aria-hidden="true">→</span></p>
        </div>
      </div>

      <p class="thesis__note" data-reveal="up">
        Same technology. Two completely different skills. Most training only
        teaches the left-hand column — which is how you end up with a team
        that is fast at producing things and defenceless against being fooled
        by them.
      </p>
    </section>

    <section class="avail" aria-labelledby="avail-heading" data-reveal="up">
      <h2 id="avail-heading" class="mono-micro">Booking now</h2>
      <p class="avail__window">{availability.window}</p>
      <p class="avail__note">{availability.note}</p>
    </section>

    {/* -------------------------------------------------------------------
        THE FORK. Two columns split by a single vertical hairline. The
        structure is the picture; nothing here has a fill or a radius.
       ------------------------------------------------------------------- */}
    <section class="section-tight" aria-labelledby="offer-heading">
      <h2 id="offer-heading" class="kicker">What you can book</h2>

      <div class="fork mt-10">
        <div id="personal" class="fork__col" data-reveal="up">
          <p class="mono-micro">{trackIntro.personal.label}</p>
          <h3 class="fork__title">{trackIntro.personal.heading}</h3>
          <p class="fork__body">{trackIntro.personal.body}</p>

          {personal.map((o) => (
            <article class="offer">
              <h4 class="offer__title">{o.title}</h4>
              <p class="offer__tagline">{o.tagline}</p>
              <p class="offer__who">{o.who}</p>

              <ul class="ladder">
                {o.formats.map((f) => (
                  <li class="ladder__row">
                    <span class="ladder__label">{f.label}</span>
                    <span class="ladder__detail">{f.detail}</span>
                    <span class="ladder__price">
                      {f.price}
                      {f.priceNote && <span class="ladder__note">{f.priceNote}</span>}
                    </span>
                  </li>
                ))}
              </ul>

              {o.caveat && <p class="offer__caveat">{o.caveat}</p>}

              <a href="#enquire" class="link-arrow mt-5" data-enquire={enquiryValue(o)}>
                {enquireLabel}
              </a>
            </article>
          ))}

          <details class="more">
            <summary>
              <span>What the 2.5 hours actually look like</span>
              <span class="faq-mark" aria-hidden="true">+</span>
            </summary>
            <ol class="rundown">
              {fluency.rundown?.map((row) => (
                <li>
                  <span class="mono-micro text-paper-400">{row.time}</span>
                  <span>{row.item}</span>
                </li>
              ))}
            </ol>
          </details>
        </div>

        <div id="enterprise" class="fork__col fork__col--right" data-reveal="up">
          <p class="mono-micro">{trackIntro.enterprise.label}</p>
          <h3 class="fork__title">{trackIntro.enterprise.heading}</h3>
          <p class="fork__body">{trackIntro.enterprise.body}</p>

          {enterprise.map((o) => (
            <article class="offer">
              <h4 class="offer__title">{o.title}</h4>
              <p class="offer__tagline">{o.tagline}</p>
              <p class="offer__who">{o.who}</p>

              <ul class="ladder">
                {o.formats.map((f) => (
                  <li class="ladder__row">
                    <span class="ladder__label">{f.label}</span>
                    <span class="ladder__detail">{f.detail}</span>
                    <span class="ladder__price">
                      {f.price}
                      {f.priceNote && <span class="ladder__note">{f.priceNote}</span>}
                    </span>
                  </li>
                ))}
              </ul>

              {o.caveat && <p class="offer__caveat">{o.caveat}</p>}

              <a href="#enquire" class="link-arrow mt-5" data-enquire={enquiryValue(o)}>
                {enquireLabel}
              </a>
            </article>
          ))}

          <article class="offer">
            <h4 class="offer__title">Something else in mind?</h4>
            <p class="offer__tagline">
              A format that is not on this list, a school, a nonprofit, a
              conference with an odd shape.
            </p>
            <p class="offer__who">
              Tell me what you are trying to do. Schools, nonprofits and student
              events are quoted separately and cost less.
            </p>
            <a href="#enquire" class="link-arrow mt-5" data-enquire="Something else">
              {enquireLabel}
            </a>
          </article>
        </div>
      </div>

      <p class="fork__foot">
        Corporate figures are floors, not quotes. Headcount above 20, provincial
        or multi-site delivery, extra cohorts and custom material move them.
        Venue, meals, AV, tool seats and travel outside Metro Manila are not
        included.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4" data-reveal="up">
        <a href="#enquire" class="btn btn-primary">Talk to me</a>
        <a href="mailto:jpaul.fernandez18@gmail.com" class="link-arrow">Or email directly</a>
      </div>
    </section>

    {/* -------------------------------------------------------------------
        WHO THIS IS FOR. The right-hand column is the half that matters —
        it is the scope boundary, stated before you pay rather than after.
       ------------------------------------------------------------------- */}
    <section class="section-tight" aria-labelledby="fit-heading">
      <h2 id="fit-heading" class="kicker">Who this is for</h2>

      <div class="mt-10 grid gap-10 md:grid-cols-2 md:gap-16" data-reveal-stagger>
        <div data-reveal="up">
          <h3 class="text-h3 m-0">Book it if</h3>
          <ul class="fitlist">
            {fit.forYou.map((line) => <li>{line}</li>)}
          </ul>
        </div>
        <div data-reveal="up">
          <h3 class="text-h3 m-0">Do not book it if</h3>
          <ul class="fitlist">
            {fit.notForYou.map((line) => <li>{line}</li>)}
          </ul>
        </div>
      </div>
    </section>

    {/* -------------------------------------------------------------------
        OUTCOMES. Sourced from the same offering objects as the price
        ladder, rendered once, here.
       ------------------------------------------------------------------- */}
    <section class="section-tight" aria-labelledby="outcomes-heading">
      <h2 id="outcomes-heading" class="kicker">What you leave with</h2>

      <div class="mt-10 grid gap-12 md:grid-cols-2 md:gap-16" data-reveal-stagger>
        {(['personal', 'enterprise'] as const).map((track) => (
          <div data-reveal="up">
            <h3 class="text-h3 m-0">{trackIntro[track].heading}</h3>
            {offerings
              .filter((o) => o.track === track)
              .map((o) => (
                <div class="outcome">
                  <p class="outcome__for">{o.title}</p>
                  <ul class="outcome__list">
                    {o.outcomes.map((line) => <li>{line}</li>)}
                  </ul>
                </div>
              ))}
          </div>
        ))}
      </div>
    </section>

    {/* -------------------------------------------------------------------
        WHY ANY OF THIS. Three sourced figures at display scale. Every one
        carries a URL and a stated population.
       ------------------------------------------------------------------- */}
    <section class="section-tight" aria-labelledby="stats-heading">
      <h2 id="stats-heading" class="kicker">Why this keeps coming up</h2>
      <ul class="stats mt-10" data-reveal-stagger>
        {marketStats.map((stat) => (
          <li class="stat" data-reveal="up">
            <p class="stat__figure">{stat.figure}</p>
            <p class="stat__body">
              {stat.body}{' '}
              <a href={stat.sourceUrl} target="_blank" rel="noopener noreferrer" class="link">
                {stat.sourceLabel}
              </a>.
            </p>
          </li>
        ))}
      </ul>
    </section>

    <section class="section-tight" aria-labelledby="process-heading">
      <h2 id="process-heading" class="kicker">How it works</h2>
      <ol class="steps mt-10" data-reveal-stagger>
        {process.map((step, i) => (
          <li data-reveal="up">
            <span class="mono-micro">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="m-0 mt-2 text-h3">{step.title}</h3>
            <p class="mt-2 mb-0 text-small text-paper-400 leading-relaxed max-w-[52ch]">{step.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="section-tight" aria-labelledby="proof-heading">
      <h2 id="proof-heading" class="kicker">Who's in the room</h2>
      <div class="mt-10 grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:items-start">
        <figure class="portrait m-0" data-reveal="up">
          <Image
            src={portrait}
            alt="Paul Fernandez"
            widths={[480, 720]}
            sizes="(min-width: 1024px) 320px, 100vw"
          />
        </figure>
        <div data-reveal="up">
          <h3 class="text-h3 m-0">I ran tech operations at Rappler through two national elections.</h3>
          <p class="mt-4 text-paper-400 text-small leading-relaxed max-w-[50ch]">
            Eleven years shipping things that broke in public when they broke.
            PHVote had to publish results live while the country watched. Before
            that: IT manager at MMDC, systems analyst at PSBank.
          </p>
          <p class="mt-3 text-paper-400 text-small leading-relaxed max-w-[50ch]">
            I have nothing to sell you afterwards — no subscription, no platform,
            no certification. What I know is what happens to a plan once real
            people and real deadlines get hold of it, and that's what the
            session is about.
          </p>
          <p class="mt-4 mb-0">
            <a href="/about/" class="link">Read full background →</a>
          </p>
        </div>
      </div>

      <div class="card mt-12 pt-6" data-reveal="up">
        <p class="mono-micro mb-4 text-paper-400">Data &amp; security baseline</p>
        <ul class="m-0 p-0 list-none grid gap-3 md:grid-cols-2 md:gap-x-10 text-small text-paper-100">
          <li class="flex items-start gap-2.5">
            <span class="text-paper-400">·</span>
            <span><strong class="text-paper-50 font-medium">Your tenant, your accounts.</strong> Exercises run in your environment; no client credentials or sensitive data are shared.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-paper-400">·</span>
            <span><strong class="text-paper-50 font-medium">Sanitized data by default.</strong> No secrets, PII, or proprietary customer data in workshop exercises.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-paper-400">·</span>
            <span><strong class="text-paper-50 font-medium">Zero retention.</strong> Nothing retained post-session, with deletion confirmed. Recordings off unless requested in writing.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-paper-400">·</span>
            <span><strong class="text-paper-50 font-medium">Your outputs belong to you.</strong> All prototypes and notes created during the session are 100% yours.</span>
          </li>
        </ul>
      </div>
    </section>

    <section class="section-tight" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="kicker">Questions</h2>
      <div class="mt-8" data-reveal-stagger>
        {faqItems.map((item) => (
          <details class="faq" data-reveal="fade">
            <summary>
              <span>{item.q}</span>
              <span class="faq-mark" aria-hidden="true">+</span>
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section id="enquire" class="section-tight" aria-labelledby="enquire-heading">
      <h2 id="enquire-heading" class="kicker">Talk to me</h2>

      <div class="mt-10 grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div>
          <p class="statement-sm max-w-[16ch]" data-reveal="up">
            Tell me what you're stuck on.
          </p>
          <p class="mt-8 mb-0 text-paper-400 text-small max-w-[42ch]">
            I usually reply within two days. The first call is 30 minutes and
            costs nothing. If a session is the wrong answer, I will say so on
            that call rather than in a proposal.
          </p>
          <p class="mt-6 mb-0 text-paper-400 text-small">
            Or skip the form —
            <a href="mailto:jpaul.fernandez18@gmail.com" class="link">
              jpaul.fernandez18@gmail.com
            </a>
          </p>
        </div>

        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="panel p-6 md:p-8 flex flex-col gap-5"
          data-reveal="up"
        >
          <input type="hidden" name="access_key" value="3adf4959-3a04-4fc5-a990-e1159605181f" />
          <input type="hidden" name="redirect" value="https://www.janpaulfernandez.com/thanks/" />
          <input type="hidden" name="subject" value="Workshop inquiry from janpaulfernandez.com" />
          <input type="hidden" name="from_name" value="Jan Paul Fernandez Website" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

          <div>
            <label for="w-name" class="field-label">Name</label>
            <input type="text" id="w-name" name="name" autocomplete="name" required class="field" />
          </div>

          <div>
            <label for="w-email" class="field-label">Email</label>
            <input type="email" id="w-email" name="email" autocomplete="email" required class="field" />
          </div>

          <div>
            <label for="w-org" class="field-label">Organization <span class="field-opt">optional</span></label>
            <input type="text" id="w-org" name="organization" autocomplete="organization" class="field" />
          </div>

          <div>
            <label for="w-interest" class="field-label">What are you interested in?</label>
            <select id="w-interest" name="interested_in" class="field" data-enquire-target>
              <option value="Not sure yet">Not sure yet — help me pick</option>
              <optgroup label="For yourself">
                {personal.map((o) => (
                  <option value={enquiryValue(o)}>{o.title}</option>
                ))}
              </optgroup>
              <optgroup label="For your organisation">
                {enterprise.map((o) => (
                  <option value={enquiryValue(o)}>{o.title}</option>
                ))}
              </optgroup>
              <option value="Something else">Something else</option>
            </select>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="w-size" class="field-label">How many people <span class="field-opt">optional</span></label>
              <input type="text" id="w-size" name="headcount" inputmode="numeric" class="field" />
            </div>
            <div>
              <label for="w-when" class="field-label">When</label>
              <select id="w-when" name="timeline" class="field">
                <option value="Just exploring">Just exploring</option>
                <option value="Within a month">Within a month</option>
                <option value="One to three months">One to three months</option>
                <option value="Later this year">Later this year</option>
              </select>
            </div>
          </div>

          <div>
            <label for="w-message" class="field-label">What you want to walk out with</label>
            <textarea id="w-message" name="message" required rows="5" class="field"></textarea>
          </div>

          <button type="submit" class="btn btn-primary self-start">Send it →</button>
        </form>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const target = document.querySelector('[data-enquire-target]');
    if (!target) return;
    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('[data-enquire]');
      if (!trigger) return;
      const value = trigger.getAttribute('data-enquire');
      if ([...target.options].some((o) => o.value === value)) target.value = value;
    });
  })();
</script>

<style>
  .page-head {
    padding-block: clamp(8rem, 6rem + 8vw, 12rem) clamp(3rem, 2rem + 4vw, 5rem);
  }

  /* Outcome-led hero display: balanced across screens without overflowing. */
  .hero-display {
    font-size: clamp(2.75rem, 1.25rem + 4.5vw, 5.75rem);
    line-height: 0.98;
    max-width: 18ch;
  }

  /* --- Router ------------------------------------------------------------ */

  .routes {
    border-top: 1px solid var(--line);
    margin-top: 1rem;
  }
  .route {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem 1.5rem;
    border-bottom: 1px solid var(--line);
    padding-block: 1.5rem;
    text-decoration: none;
    color: inherit;
  }
  @media (min-width: 64rem) {
    .route {
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr) auto;
      align-items: baseline;
      gap: 3rem;
    }
  }
  .route__label {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-paper-50);
  }
  .route__line {
    font-size: var(--text-small);
    color: var(--color-paper-400);
    line-height: 1.6;
    max-width: 52ch;
  }
  .route__mark {
    font-family: var(--font-mono);
    color: var(--color-paper-600);
    transition: transform 0.2s ease, color 0.2s ease;
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
  }
  @media (min-width: 64rem) {
    .route__mark { grid-column: 3; }
  }
  .route:hover .route__mark,
  .route:focus-visible .route__mark {
    color: var(--color-paper-50);
    transform: translateX(4px);
  }

  /* --- The thesis diagram ------------------------------------------------
   * A picture built from a hairline and two lists, so it stays legible at
   * 360px, reads correctly to a screen reader, and needs no SVG. */

  .thesis {
    display: grid;
    border: 1px solid var(--line);
  }
  @media (min-width: 48rem) {
    .thesis { grid-template-columns: 1fr 1fr; }
  }
  .thesis__side {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
  }
  .thesis__side--right {
    border-top: 1px solid var(--line);
  }
  @media (min-width: 48rem) {
    .thesis__side { padding: 2.25rem; }
    .thesis__side--right {
      border-top: 0;
      border-left: 1px solid var(--line);
      text-align: right;
    }
  }
  .thesis__head {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-paper-400);
  }
  .thesis__head em {
    font-style: normal;
    color: var(--color-paper-50);
  }
  .thesis__list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    flex: 1;
  }
  .thesis__list li {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--color-paper-50);
    padding-block: 0.4rem;
  }
  .thesis__flow {
    margin: 1.75rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-paper-400);
  }
  .thesis__note {
    margin: 2rem 0 0;
    font-size: var(--text-small);
    color: var(--color-paper-400);
    line-height: 1.7;
    max-width: 62ch;
  }

  /* --- Availability ------------------------------------------------------ */

  .avail {
    border-block: 1px solid var(--line);
