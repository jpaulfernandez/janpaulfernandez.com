{/*
  Progressive enhancement, rung 6 of the YAGNI ladder. Clicking "Enquire" on a
  session preselects it in the form, so a lead arrives already qualified.
  With JS off the anchor still jumps to the form and the reader picks from the
  same <select> — nothing is gated behind this.
*/}
<script is:inline>
  (() => {
    const target = document.querySelector('[data-enquire-target]');
    if (!target) return;
    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('[data-enquire]');
      if (!trigger) return;
      const value = trigger.getAttribute('data-enquire');
      if ([...target.options].some((o) => o.value === value)) target.value = value;
    });
  })();
</script>

