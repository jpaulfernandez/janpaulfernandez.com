---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import { service, faqPage, breadcrumbs } from '../lib/schema';
import {
  availability,
  faqItems,
  featuredOpenSession,
  featuredTeamSession,
  openEnquireLabel,
  openProcess,
  openSessions,
  otherOpenSessions,
  otherTeamSessions,
  teamEnquireLabel,
  teamProcess,
  teamSessions,
} from '../lib/workshops';
import portrait from '../assets/paul.webp';

const fluency = featuredOpenSession();
const moreOpen = otherOpenSessions();
const halfDay = featuredTeamSession();
const moreTeam = otherTeamSessions();

const description =
  'Practical AI workshops for individuals and teams run on real workflows. Open cohorts from ₱1,500; team sessions from ₱45,000.';

const seoData = [
  service({
    title: 'AI workshops and talks',
    description:
      'AI fluency and media literacy, AI for leadership, prototyping for non-engineers, and facilitated AI policy sessions. Delivered as open Zoom cohorts or in-house for teams in the Philippines.',
  }),
  faqPage(faqItems),
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'Workshops', url: '/workshops/' },
  ]),
];
---

<BaseLayout title="AI workshops" description={description} ogImage="/og/workshops.png">
  <JsonLd data={seoData} slot="head" />

  <section class="page-head" data-hero>
    <div class="shell">
      <p class="mono-micro flex items-center gap-3" data-reveal="fade">
        <span class="h-px w-8 bg-[var(--line-strong)]"></span>
        Talks &amp; workshops · Manila &amp; remote · English · PHT
      </p>

      <h1 class="display mt-8 max-w-[18ch]" data-reveal="up" data-reveal-delay="0.05">
        Your team leaves with something they can run on Monday
      </h1>

      <p class="lead mt-8 max-w-[50ch]" data-reveal="up" data-reveal-delay="0.12">
        You bring a real bottleneck — a document, a shadow-AI mess, a
        question leadership keeps asking. We spend the hours on that.
        Individuals can ask for the next Zoom seat; teams get the room.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4" data-reveal="up" data-reveal-delay="0.18">
        <a href="#enquire" class="btn btn-primary">Start a conversation</a>
        <a href="#open-sessions" class="link-arrow">Open cohorts from ₱1,500</a>
      </div>
    </div>
  </section>

  <div class="shell pb-24 md:pb-32">
    <section class="avail" aria-labelledby="avail-heading" data-reveal="up">
      <h2 id="avail-heading" class="mono-micro">Booking now</h2>
      <p class="avail__window">{availability.window}</p>
      <p class="avail__note">{availability.note}</p>
    </section>

    <section id="open-sessions" class="section-tight" aria-labelledby="open-heading">
      <h2 id="open-heading" class="kicker">Open sessions · Individual seats</h2>
      <p class="mt-4 mb-0 text-paper-400 max-w-[58ch]">
        Public cohorts on Zoom with fixed prices and seat caps. Dates are not
        up yet — ask and I will email you when the first one is set.
      </p>

      <ul class="rows mt-8" data-reveal-stagger>
        <li data-reveal="up">
          <p class="mono-micro mb-0">Start here</p>
          <div class="offer">
            <div class="offer__head">
              <h3 class="m-0 text-h3 leading-[1.1]">{fluency.title}</h3>
              <p class="mt-2 mb-0 text-small text-paper-400">{fluency.tagline}</p>
            </div>

            <div class="offer__body">
              <p class="m-0 text-paper-100">
                <span class="offer__label">You walk out with</span>
                {fluency.walkout}
              </p>
              <p class="m-0 mt-4 text-small text-paper-400">
                <strong class="text-paper-200 font-normal">For:</strong> {fluency.who}
              </p>
            </div>

            <div class="offer__meta">
              <p class="m-0 offer__price">{fluency.price}</p>
              <p class="m-0 mt-1 text-small text-paper-400">{fluency.priceNote}</p>
              <p class="m-0 mt-3 mono text-paper-400 text-small">{fluency.format}</p>
              <a href="#enquire" class="link-arrow mt-4" data-enquire={`open:${fluency.title}`}>
                {openEnquireLabel}
              </a>
            </div>
          </div>
        </li>
      </ul>

      <details class="more" data-reveal="up">
        <summary>
          <span>Two more open sessions</span>
          <span class="faq-mark" aria-hidden="true">+</span>
        </summary>
        <ul class="rows">
          {moreOpen.map((s) => (
            <li>
              <div class="offer">
                <div class="offer__head">
                  <h3 class="m-0 text-h3 leading-[1.1]">{s.title}</h3>
                  <p class="mt-2 mb-0 text-small text-paper-400">{s.tagline}</p>
                </div>
                <div class="offer__body">
                  <p class="m-0 text-paper-100">
                    <span class="offer__label">You walk out with</span>
                    {s.walkout}
                  </p>
                  <p class="m-0 mt-4 text-small text-paper-400">
                    <strong class="text-paper-200 font-normal">For:</strong> {s.who}
                  </p>
                </div>
                <div class="offer__meta">
                  <p class="m-0 offer__price">{s.price}</p>
                  <p class="m-0 mt-1 text-small text-paper-400">{s.priceNote}</p>
                  <p class="m-0 mt-3 mono text-paper-400 text-small">{s.format}</p>
                  <a href="#enquire" class="link-arrow mt-4" data-enquire={`open:${s.title}`}>
                    {openEnquireLabel}
                  </a>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </details>
    </section>

    <section id="team-sessions" class="section-tight" aria-labelledby="inhouse-heading">
      <h2 id="inhouse-heading" class="kicker">For your team · In-house engagements</h2>
      <p class="mt-4 mb-0 text-paper-400 max-w-[58ch]">
        Most teams start here: half-day, from ₱90,000, you leave with a ranked
        list and one workflow the room actually ran. Other formats below.
      </p>

      <ul class="rows mt-8" data-reveal-stagger>
        <li data-reveal="up">
          <p class="mono-micro mb-0">Most teams start here</p>
          <div class="offer">
            <div class="offer__head">
              <h3 class="m-0 text-h3 leading-[1.1]">{halfDay.title}</h3>
              <p class="mt-2 mb-0 text-small text-paper-400">{halfDay.detail}</p>
            </div>
            <div class="offer__body">
              <p class="m-0 text-paper-100">
                <span class="offer__label">You walk out with</span>
                {halfDay.walkout}
              </p>
            </div>
            <div class="offer__meta">
              <p class="m-0 offer__price">{halfDay.price}</p>
              <a href="#enquire" class="link-arrow mt-4" data-enquire={`team:${halfDay.title}`}>
                {teamEnquireLabel}
              </a>
            </div>
          </div>
        </li>
      </ul>

      <details class="more" data-reveal="up">
        <summary>
          <span>Other team formats</span>
          <span class="faq-mark" aria-hidden="true">+</span>
        </summary>
        <ul class="rows">
          {moreTeam.map((s, i) => (
            <li>
              <div class="grid md:grid-cols-[auto_1fr_auto] gap-x-10 gap-y-4 py-6 md:items-baseline">
                <span class="mono-micro md:pt-1">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3 class="m-0 text-h3 leading-tight">{s.title}</h3>
                  <p class="mt-2 mb-0 text-small text-paper-400 leading-relaxed max-w-[54ch]">
                    {s.detail}
                  </p>
                  {s.walkout && (
                    <p class="mt-3 mb-0 text-small text-paper-100 max-w-[54ch]">
                      <span class="offer__label">You walk out with</span>
                      {s.walkout}
                    </p>
                  )}
                  <a href="#enquire" class="link-arrow mt-3" data-enquire={`team:${s.title}`}>
                    {teamEnquireLabel}
                  </a>
                </div>
                <p class="m-0 offer__price md:text-right">{s.price}</p>
              </div>
            </li>
          ))}
        </ul>
      </details>
    </section>

    <section class="section-tight" aria-labelledby="process-heading">
      <h2 id="process-heading" class="kicker">How it works</h2>
      <div class="mt-10 grid gap-12 md:grid-cols-2 md:gap-16" data-reveal-stagger>
        <div data-reveal="up">
          <h3 class="text-h3 m-0">Open sessions</h3>
          <ol class="steps">
            {openProcess.map((step, i) => (
              <li>
                <span class="mono-micro">{String(i + 1).padStart(2, '0')}</span>
                <h4 class="m-0 mt-2">{step.title}</h4>
                <p class="mt-2 mb-0 text-small text-paper-400 leading-relaxed">{step.body}</p>
              </li>
            ))}
          </ol>
        </div>
        <div data-reveal="up">
          <h3 class="text-h3 m-0">For your team</h3>
          <ol class="steps">
            {teamProcess.map((step, i) => (
              <li>
                <span class="mono-micro">{String(i + 1).padStart(2, '0')}</span>
                <h4 class="m-0 mt-2">{step.title}</h4>
                <p class="mt-2 mb-0 text-small text-paper-400 leading-relaxed">{step.body}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="section-tight" aria-labelledby="proof-heading">
      <h2 id="proof-heading" class="kicker">Who's in the room</h2>
      <div class="mt-10 grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:items-start">
        <figure class="portrait m-0" data-reveal="up">
          <Image
            src={portrait}
            alt="Paul Fernandez"
            widths={[480, 720]}
            sizes="(min-width: 1024px) 320px, 100vw"
          />
        </figure>
        <div data-reveal="up">
          <h3 class="text-h3 m-0">I ran tech operations at Rappler through two national elections.</h3>
          <p class="mt-4 text-paper-400 text-small leading-relaxed max-w-[50ch]">
            Eleven years shipping things that broke in public when they broke.
            PHVote had to publish results live while the country watched. Before
            that: IT manager at MMDC, systems analyst at PSBank.
          </p>
          <p class="mt-3 text-paper-400 text-small leading-relaxed max-w-[50ch]">
            I have nothing to sell you afterwards — no subscription, no platform,
            no certification. What I know is what happens to a plan once real
            people and real deadlines get hold of it, and that's what the
            session is about.
          </p>
          <p class="mt-4 mb-0">
            <a href="/about/" class="link">Read full background →</a>
          </p>
        </div>
      </div>

      <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:items-start">
        <div data-reveal="up">
          <h3 class="text-h3 m-0">Fluency rundown</h3>
          <p class="mt-2 mb-6 text-small text-paper-400 max-w-[46ch]">
            2.5 hours on Zoom. Screenshot this into Slack if you need to justify the ₱1,500.
          </p>
          <ol class="rundown">
            {fluency.rundown?.map((row) => (
              <li>
                <span class="mono-micro text-paper-400">{row.time}</span>
                <span>{row.item}</span>
              </li>
            ))}
          </ol>
        </div>

        <div class="card pt-6" data-reveal="up">
          <p class="mono-micro mb-4 text-paper-400">Data &amp; security baseline</p>
          <ul class="m-0 p-0 list-none space-y-3 text-small text-paper-100">
            <li class="flex items-start gap-2.5">
              <span class="text-paper-400">·</span>
              <span><strong class="text-paper-50 font-medium">Your tenant, your accounts.</strong> Exercises run in your environment; no client credentials or sensitive data are shared.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-paper-400">·</span>
              <span><strong class="text-paper-50 font-medium">Sanitized data by default.</strong> No secrets, PII, or proprietary customer data in workshop exercises.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-paper-400">·</span>
              <span><strong class="text-paper-50 font-medium">Zero retention.</strong> Nothing retained post-session, with deletion confirmed. Recordings off unless requested in writing.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-paper-400">·</span>
              <span><strong class="text-paper-50 font-medium">Your outputs belong to you.</strong> All prototypes and notes created during the session are 100% yours.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section-tight" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="kicker">Questions</h2>
      <div class="mt-8" data-reveal-stagger>
        {faqItems.map((item) => (
          <details class="faq" data-reveal="fade">
            <summary>
              <span>{item.q}</span>
              <span class="faq-mark" aria-hidden="true">+</span>
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section id="enquire" class="section-tight" aria-labelledby="enquire-heading">
      <h2 id="enquire-heading" class="kicker">Start a conversation</h2>

      <div class="mt-10 grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
        <div>
          <p class="statement-sm max-w-[16ch]" data-reveal="up">
            Tell me what you're stuck on.
          </p>
          <p class="mt-8 mb-0 text-paper-400 text-small max-w-[42ch]">
            I usually reply within two days. The first call is 30 minutes and
            costs nothing. If a session is the wrong answer, I will say so on
            that call rather than in a proposal.
          </p>
          <p class="mt-6 mb-0 text-paper-400 text-small">
            Or skip the form —
            <a href="mailto:jpaul.fernandez18@gmail.com" class="link">
              jpaul.fernandez18@gmail.com
            </a>
          </p>
        </div>

        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="panel p-6 md:p-8 flex flex-col gap-5"
          data-reveal="up"
        >
          <input type="hidden" name="access_key" value="3adf4959-3a04-4fc5-a990-e1159605181f" />
          <input type="hidden" name="redirect" value="https://www.janpaulfernandez.com/thanks/" />
          <input type="hidden" name="subject" value="Workshop inquiry from janpaulfernandez.com" />
          <input type="hidden" name="from_name" value="Jan Paul Fernandez Website" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

          <div>
            <label for="w-name" class="field-label">Name</label>
            <input type="text" id="w-name" name="name" autocomplete="name" required class="field" />
          </div>

          <div>
            <label for="w-email" class="field-label">Email</label>
            <input type="email" id="w-email" name="email" autocomplete="email" required class="field" />
          </div>

          <div>
            <label for="w-org" class="field-label">Organization <span class="field-opt">optional</span></label>
            <input type="text" id="w-org" name="organization" autocomplete="organization" class="field" />
          </div>

          <div>
            <label for="w-interest" class="field-label">What are you interested in?</label>
            <select id="w-interest" name="interested_in" class="field" data-enquire-target>
              <option value="Not sure yet">Not sure yet — help me pick</option>
              <optgroup label="Open sessions">
                {openSessions.map((s) => (
                  <option value={`open:${s.title}`}>{s.title}</option>
                ))}
              </optgroup>
              <optgroup label="For your team">
                {teamSessions.map((s) => (
                  <option value={`team:${s.title}`}>{s.title}</option>
                ))}
              </optgroup>
            </select>
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="w-size" class="field-label">How many people <span class="field-opt">optional</span></label>
              <input type="text" id="w-size" name="headcount" inputmode="numeric" class="field" />
            </div>
            <div>
              <label for="w-when" class="field-label">When</label>
              <select id="w-when" name="timeline" class="field">
                <option value="Just exploring">Just exploring</option>
                <option value="Within a month">Within a month</option>
                <option value="One to three months">One to three months</option>
                <option value="Later this year">Later this year</option>
              </select>
            </div>
          </div>

          <div>
            <label for="w-message" class="field-label">What you want to walk out with</label>
            <textarea id="w-message" name="message" required rows="5" class="field"></textarea>
          </div>

          <button type="submit" class="btn btn-primary self-start">Send it →</button>
        </form>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const target = document.querySelector('[data-enquire-target]');
    if (!target) return;
    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('[data-enquire]');
      if (!trigger) return;
      const value = trigger.getAttribute('data-enquire');
      if ([...target.options].some((o) => o.value === value)) target.value = value;
    });
  })();
</script>

<style>
  .page-head {
    padding-block: clamp(8rem, 6rem + 8vw, 12rem) clamp(3rem, 2rem + 4vw, 5rem);
  }

  .avail {
    border-block: 1px solid var(--line);
    padding-block: 2rem;
    display: grid;
    gap: 0.75rem 3rem;
  }
  @media (min-width: 48rem) {
    .avail {
      grid-template-columns: 10rem auto 1fr;
      align-items: baseline;
    }
  }
  .avail__window {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-paper-50);
    white-space: nowrap;
  }
  .avail__note {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-paper-400);
    line-height: 1.6;
    max-width: 46ch;
  }

  .offer {
    display: grid;
    gap: 1.5rem 3rem;
    padding-block: 2.25rem;
  }
  @media (min-width: 64rem) {
    .offer {
      grid-template-columns: 1fr 1.3fr minmax(12rem, 15rem);
      gap: 3rem;
    }
    .offer__meta { text-align: right; }
    .offer__meta .link-arrow { justify-content: flex-end; }
  }
  .offer__body { max-width: 52ch; line-height: 1.6; }
  .offer__label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-paper-400);
    margin-bottom: 0.5rem;
  }
  .offer__price {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-paper-50);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .more {
    border-bottom: 1px solid var(--line);
  }
  .more summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.25rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-paper-400);
  }
  .more summary::-webkit-details-marker { display: none; }
  .more summary:hover { color: var(--color-paper-50); }
  .more[open] summary { color: var(--color-paper-50); }

  .steps {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }
  .steps li {
    border-top: 1px solid var(--line);
    padding-block: 1.25rem;
  }

  .rundown {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rundown li {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1rem;
    border-top: 1px solid var(--line);
    padding-block: 0.85rem;
    font-size: var(--text-small);
    color: var(--color-paper-100);
    line-height: 1.5;
  }

  .portrait {
    border: 1px solid var(--line);
  }
  .portrait :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .field-opt {
    text-transform: none;
    letter-spacing: 0.04em;
    color: var(--color-paper-600);
  }
</style>
