---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import { course, breadcrumbs, faqPage } from '../../lib/schema';

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  return courses.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const c = entry.data;
const path = `/workshops/${entry.id}/`;
// Carry the course into the landing form so arriving at #enquire preselects it.
const enquireHref = `/workshops/?enquire=${encodeURIComponent(c.title)}#enquire`;

const seoData = [
  course({ title: c.title, description: c.tagline, url: path }),
  breadcrumbs([
    { name: 'Home', url: '/' },
    { name: 'Workshops', url: '/workshops/' },
    { name: c.title, url: path },
  ]),
  ...(c.faq && c.faq.length ? [faqPage(c.faq)] : []),
];

const meta = [
  { label: 'Duration', value: c.duration },
  { label: 'Format', value: c.formatLabel },
  { label: "Who it's for", value: c.whoFor },
  { label: 'Approach', value: c.approach },
];
---

<BaseLayout title={c.title} description={c.tagline} ogImage={`/og/workshops-${entry.id}.png`}>
  <JsonLd data={seoData} slot="head" />

  <section class="page-head" data-hero>
    <div class="shell">
      <a href="/workshops/" class="eyebrow-back" data-reveal="fade">
        <span aria-hidden="true">←</span> Back to workshops
      </a>

      <p class="mono-micro mt-6" data-reveal="up">
        Course · Interactive · {c.duration}
      </p>
      <h1 class="display course-title mt-4" data-reveal="up" data-reveal-delay="0.05">{c.title}</h1>
      <p class="lead mt-6 max-w-[46ch]" data-reveal="up" data-reveal-delay="0.12">{c.tagline}</p>

      <div class="mt-10" data-reveal="up" data-reveal-delay="0.18">
        <a href={enquireHref} class="btn btn-primary">Talk to me →</a>
      </div>
    </div>
  </section>

  <div class="shell pb-24 md:pb-32">
    {/* Hairline meta strip — Codecademy pattern, no fill. */}
    <dl class="meta" data-reveal="up">
      {meta.map((m) => (
        <div class="meta__cell">
          <dt class="meta__label">{m.label}</dt>
          <dd class="meta__val">{m.value}</dd>
        </div>
      ))}
    </dl>

    <section class="section-tight" aria-labelledby="take-heading">
      <h2 id="take-heading" class="kicker">You'll leave with</h2>
      <ul class="take-list mt-8" data-reveal-stagger>
        {c.outcomes.map((line) => (
          <li data-reveal="up"><span class="take-mark" aria-hidden="true">→</span><span>{line}</span></li>
        ))}
      </ul>
    </section>

    {/* WHAT WE COVER — a rail: a vertical hairline spine with a node per
        movement, so the session reads as a sequence rather than a list. */}
    <section class="section-tight" aria-labelledby="cover-heading">
      <h2 id="cover-heading" class="kicker">What we cover</h2>
      <ol class="arc mt-10" data-reveal-stagger>
        {c.outline.map((row, i) => (
          <li class="arc__item" data-reveal="up">
            <p class="arc__step"><span class="arc__num">{String(i + 1).padStart(2, '0')}</span>{row.step}</p>
            <p class="arc__desc">{row.item}</p>
          </li>
        ))}
      </ol>
      <p class="cover-note" data-reveal="up"><span aria-hidden="true">› </span>{c.approachNote}</p>
      {c.caveat && (
        <p class="caveat" data-reveal="up"><span aria-hidden="true">⚠ </span>{c.caveat}</p>
      )}
    </section>

    <section class="section-tight" aria-labelledby="price-heading">
      <h2 id="price-heading" class="kicker">Formats &amp; price</h2>
      <ul class="ladder mt-8" data-reveal-stagger>
        {c.formats.map((f) => (
          <li class="ladder__row" data-reveal="up">
            <span class="ladder__label">{f.label}</span>
            <span class="ladder__detail">{f.detail}</span>
            <span class="ladder__price">
              {f.price}
              {f.priceNote && <span class="ladder__note">{f.priceNote}</span>}
            </span>
          </li>
        ))}
      </ul>
    </section>

    {c.faq && c.faq.length > 0 && (
      <section class="section-tight" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="kicker">Questions</h2>
        <div class="mt-8" data-reveal-stagger>
          {c.faq.map((item) => (
            <details class="faq" data-reveal="fade">
              <summary>
                <span>{item.q}</span>
                <span class="faq-mark" aria-hidden="true">+</span>
              </summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    {/* Closing CTA — one line and one button, then the way back. */}
    <section class="cta" aria-labelledby="cta-heading" data-reveal="up">
      <p id="cta-heading" class="cta__text">Bring one real task. We'll spend the session on it.</p>
      <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a href={enquireHref} class="btn btn-primary">Talk to me →</a>
        <a href="/workshops/" class="link-back">← Back to all workshops</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(6rem, 4.5rem + 7vw, 9rem) clamp(2rem, 1.5rem + 3vw, 3.5rem);
  }
  .course-title {
    font-size: clamp(2.25rem, 1.25rem + 3.75vw, 4.5rem);
    line-height: 1.02;
    max-width: 20ch;
  }

  /* Eyebrow back link — a clear way out, above the title. */
  .eyebrow-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-paper-400);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .eyebrow-back span { transition: transform 0.2s ease; display: inline-block; }
  .eyebrow-back:hover { color: var(--color-paper-50); }
  .eyebrow-back:hover span { transform: translateX(-3px); }

  /* --- Hairline meta strip ---------------------------------------------- */
  .meta {
    margin: 0;
    border-block: 1px solid var(--line);
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  @media (min-width: 48rem) {
    .meta { grid-template-columns: repeat(4, 1fr); }
  }
  .meta__cell {
    padding: 1.5rem 1.5rem 1.5rem 0;
  }
  .meta__cell + .meta__cell {
    border-top: 1px solid var(--line);
  }
  @media (min-width: 48rem) {
    .meta__cell {
      border-top: 0;
      padding: 1.75rem 1.5rem 1.75rem 0;
    }
    .meta__cell + .meta__cell {
      border-top: 0;
      border-left: 1px solid var(--line);
      padding-left: 1.5rem;
    }
  }
  .meta__label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-paper-400);
  }
  .meta__val {
    margin: 0.6rem 0 0;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--color-paper-50);
  }

  /* --- Outcome rows — a leading arrow marks each as something you carry out. */
  .take-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .take-list li {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 0.75rem;
    border-top: 1px solid var(--line);
    padding-block: 1rem;
    font-size: var(--text-small);
    color: var(--color-paper-100);
    line-height: 1.65;
  }
  .take-list li:last-child { border-bottom: 1px solid var(--line); }
  .take-mark {
    font-family: var(--font-mono);
    color: var(--color-paper-400);
    line-height: 1.65;
  }

  /* --- The arc: a vertical rail for the session's movements -------------- */
  .arc {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .arc::before {
    content: '';
    position: absolute;
    left: 0.1875rem;
    top: 0.75rem;
    bottom: 0.75rem;
    width: 1px;
    background: linear-gradient(180deg, var(--line-strong), var(--line), transparent);
  }
  .arc__item {
    position: relative;
    padding-left: 2rem;
    padding-bottom: 2.5rem;
  }
  .arc__item:last-child { padding-bottom: 0; }
  .arc__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6rem;
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background-color: var(--color-paper-600);
  }
  .arc__item:first-child::before { background-color: var(--color-paper-50); }
  .arc__step {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-paper-50);
  }
  .arc__num {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    color: var(--color-paper-400);
    margin-right: 0.7rem;
    vertical-align: 0.12em;
  }
  .arc__desc {
    margin: 0.5rem 0 0;
    font-size: var(--text-small);
    color: var(--color-paper-400);
    line-height: 1.6;
    max-width: 54ch;
  }
  .cover-note {
    margin: 2rem 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-paper-100);
    line-height: 1.6;
  }
  .caveat {
    margin: 1.5rem 0 0;
    padding-left: 0.9rem;
    border-left: 1px solid var(--line-strong);
    font-size: var(--text-micro);
    color: var(--color-paper-400);
    line-height: 1.7;
    max-width: 62ch;
  }

  /* --- Price ladder (shares the /workshops vocabulary) ------------------ */
  .ladder {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ladder__row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 1.5rem;
    border-top: 1px solid var(--line);
    padding-block: 1rem;
    align-items: baseline;
  }
  .ladder__row:last-child { border-bottom: 1px solid var(--line); }
  .ladder__label {
    font-size: var(--text-small);
    color: var(--color-paper-50);
  }
  .ladder__detail {
    grid-column: 1;
    font-size: var(--text-micro);
    color: var(--color-paper-400);
    line-height: 1.5;
  }
  .ladder__price {
    grid-column: 2;
    grid-row: 1 / span 2;
    justify-self: end;
    text-align: right;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-paper-50);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ladder__note {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.04em;
    font-weight: 400;
    color: var(--color-paper-400);
  }

  /* --- Closing CTA ------------------------------------------------------ */
  .cta {
    border-top: 1px solid var(--line);
    margin-top: clamp(3rem, 2rem + 4vw, 5rem);
    padding-top: clamp(2.5rem, 2rem + 3vw, 4rem);
  }
  .cta__text {
    margin: 0;
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-paper-50);
    text-wrap: balance;
  }
  .link-back {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-paper-400);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .link-back:hover { color: var(--color-paper-50); }
</style>
